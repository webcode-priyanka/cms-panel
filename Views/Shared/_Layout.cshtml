@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - CMS Panel
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f5f6fa;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            height: 100vh;
            background-color: #111827;
            overflow-y: auto;
            z-index: 1000;
        }

        .sidebar-brand {
            height: 70px;
            display: flex;
            align-items: center;
            padding: 0 20px;
            color: #ffffff;
            font-size: 21px;
            font-weight: 700;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

            .sidebar-brand i {
                margin-right: 10px;
            }

        .sidebar .nav {
            padding: 15px 10px;
        }

        .sidebar .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #cbd5e1;
            padding: 11px 14px;
            margin-bottom: 4px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
            transition: 0.2s;
        }

            .sidebar .nav-link i {
                font-size: 17px;
                width: 20px;
            }

            .sidebar .nav-link:hover {
                color: #ffffff;
                background-color: rgba(255,255,255,0.08);
            }

            .sidebar .nav-link.active,
            .sidebar .nav-link.active span,
            .sidebar .nav-link.active i {
                color: #ffffff !important;
            }

            .sidebar .nav-link.active {
                color: #ffffff !important;
                background-color: transparent !important;
            }

        .main-content {
            margin-left: 250px;
            min-height: 100vh;
        }

        .topbar {
            height: 70px;
            background-color: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 25px;
        }

        .content-area {
            padding: 25px;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background-color: #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: #374151;
        }

        .sidebar-divider {
            border-top: 1px solid rgba(255,255,255,0.08);
            margin: 12px 5px;
        }

        @@media (max-width: 768px) {

            .sidebar {
                width: 210px;
            }

            .main-content {
                margin-left: 210px;
            }

            .content-area {
                padding: 15px;
            }
        }

    </style>

</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <!-- Brand -->
        <div class="sidebar-brand">
            <i class="bi bi-speedometer2"></i>
            CMS Panel
        </div>

        <ul class="nav flex-column">

                   <!-- Dashboard -->
                 <li class="nav-item">
                    <a asp-controller="CMS"
                    asp-action="Index"
                    class="nav-link">
                    <i class="bi bi-grid-1x2-fill"></i>
                   <span>Dashboard</span>
                    </a>
                 </li>
            
            @{
                var currentUserAction =
                    ViewContext.RouteData.Values["action"]?.ToString();

                var isUserMenuOpen =
                    currentUserAction == "Users" ||
                    currentUserAction == "Roles";
            }

            <!-- User Management Menu -->
            <li class="nav-item">

                <button type="button"
                        class="nav-link w-100 border-0 text-start @(isUserMenuOpen ? "active" : "")"
                        style="background: transparent;"
                        data-bs-toggle="collapse"
                        data-bs-target="#userManagementSubmenu"
                        aria-expanded="@(isUserMenuOpen ? "true" : "false")"
                        aria-controls="userManagementSubmenu">

                    <i class="bi bi-people-fill"></i>
                    <span class="flex-grow-1">User Management</span>
                    <i class="bi bi-chevron-down ms-auto"></i>

                </button>

                <div class="collapse @(isUserMenuOpen ? "show" : "")"
                     id="userManagementSubmenu">

                    <ul class="list-unstyled ms-3 mb-1">

                        <li class="nav-item">
                            <a asp-controller="CMS"
                               asp-action="Users"
                               class="nav-link @(currentUserAction == "Users" ? "active" : "")">
                                <i class="bi bi-person-fill"></i>
                                <span>Users</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="CMS"
                               asp-action="Roles"
                               class="nav-link @(currentUserAction == "Roles" ? "active" : "")">
                                <i class="bi bi-shield-lock-fill"></i>
                                <span>Roles & Permissions</span>
                            </a>
                        </li>

                    </ul>
                </div>
            </li>

            <!-- Pages -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="Pages"
                   class="nav-link">
                    <i class="bi bi-file-earmark-text-fill"></i>
                    <span>Pages</span>
                </a>
            </li>

            
            @{
                var currentSidebarAction =
                    ViewContext.RouteData.Values["action"]?.ToString();

                var isBlogMenuOpen =
                    currentSidebarAction == "Blogs" ||
                    currentSidebarAction == "BlogCategories" ||
                    currentSidebarAction == "BlogTags";
            }

            <!-- Blogs Menu with Submenu -->
            <li class="nav-item">

                <button type="button"
                        class="nav-link w-100 border-0 text-start @(isBlogMenuOpen ? "active" : "")"
                        style="background: transparent;"
                        data-bs-toggle="collapse"
                        data-bs-target="#blogsSubmenu"
                        aria-expanded="@(isBlogMenuOpen ? "true" : "false")"
                        aria-controls="blogsSubmenu">

                    <i class="bi bi-journal-text"></i>
                    <span class="flex-grow-1">Blogs</span>
                    <i class="bi bi-chevron-down ms-auto"></i>

                </button>

                <div class="collapse @(isBlogMenuOpen ? "show" : "")"
                     id="blogsSubmenu">

                    <ul class="list-unstyled ms-3 mb-1">

                        <!-- Blog -->
                        <li class="nav-item">
                            <a asp-controller="CMS"
                               asp-action="Blogs"
                               class="nav-link @(currentSidebarAction == "Blogs" ? "active" : "")">

                                <i class="bi bi-file-earmark-text"></i>
                                <span>Blog</span>

                            </a>
                        </li>

                        <!-- Blog Category -->
                        <li class="nav-item">
                            <a asp-controller="CMS"
                               asp-action="BlogCategories"
                               class="nav-link @(currentSidebarAction == "BlogCategories" ? "active" : "")">

                                <i class="bi bi-folder-fill"></i>
                                <span>Blog Category</span>

                            </a>
                        </li>

                        <!-- Blog Tags -->
                        <li class="nav-item">
                            <a asp-controller="CMS"
                               asp-action="BlogTags"
                               class="nav-link @(currentSidebarAction == "BlogTags" ? "active" : "")">

                                <i class="bi bi-tags-fill"></i>
                                <span>Blog Tags</span>

                            </a>
                        </li>

                    </ul>

                </div>

            </li>

            
            @{
                var currentProjectAction =
                    ViewContext.RouteData.Values["action"]?.ToString();

                var isProjectMenuOpen =
                    currentProjectAction == "Projects" ||
                    currentProjectAction == "ProjectCategories";
            }

            <!-- Projects Menu -->
            <li class="nav-item">

                <button type="button"
                        class="nav-link w-100 border-0 text-start @(isProjectMenuOpen ? "active" : "")"
                        style="background: transparent;"
                        data-bs-toggle="collapse"
                        data-bs-target="#projectsSubmenu"
                        aria-expanded="@(isProjectMenuOpen ? "true" : "false")"
                        aria-controls="projectsSubmenu">

                    <i class="bi bi-kanban-fill"></i>
                    <span class="flex-grow-1">Projects</span>
                    <i class="bi bi-chevron-down ms-auto"></i>

                </button>

                <div class="collapse @(isProjectMenuOpen ? "show" : "")"
                     id="projectsSubmenu">

                    <ul class="list-unstyled ms-3 mb-1">

                        <li class="nav-item">
                            <a asp-controller="CMS"
                               asp-action="Projects"
                               class="nav-link @(currentProjectAction == "Projects" ? "active" : "")">
                                <i class="bi bi-kanban"></i>
                                <span>Projects</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="CMS"
                               asp-action="ProjectCategories"
                               class="nav-link @(currentProjectAction == "ProjectCategories" ? "active" : "")">
                                <i class="bi bi-collection-fill"></i>
                                <span>Project Categories</span>
                            </a>
                        </li>

                    </ul>
                </div>
            </li>

            
            @{
                var currentMediaAction =
                    ViewContext.RouteData.Values["action"]?.ToString();

                var isMediaMenuOpen =
                    currentMediaAction == "Gallery" ||
                    currentMediaAction == "Media";
            }
                  
<!-- Media Menu -->
<li class="nav-item">

    <button type="button"
            class="nav-link w-100 border-0 text-start @(isMediaMenuOpen ? "active" : "")"
            style="background: transparent;"
            data-bs-toggle="collapse"
            data-bs-target="#mediaSubmenu"
            aria-expanded="@(isMediaMenuOpen ? "true" : "false")"
            aria-controls="mediaSubmenu">

        <i class="bi bi-images"></i>
        <span class="flex-grow-1">Media</span>
        <i class="bi bi-chevron-down ms-auto"></i>

    </button>

    <div class="collapse @(isMediaMenuOpen ? "show" : "")"
         id="mediaSubmenu">

        <ul class="list-unstyled ms-3 mb-1">

            <!-- Gallery -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="Gallery"
                   class="nav-link @(currentMediaAction == "Gallery" ? "active" : "")">

                    <i class="bi bi-images"></i>
                    <span>Gallery</span>

                </a>
            </li>

            <!-- Media Library -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="MediaLibrary"
                   class="nav-link @(currentMediaAction == "MediaLibrary" ? "active" : "")">

                    <i class="bi bi-folder2-open"></i>
                    <span>Media Library</span>

                </a>
            </li>

        </ul>
    </div>
</li>


            <!-- Services -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="Services"
                   class="nav-link">
                    <i class="bi bi-gear-fill"></i>
                    <span>Services</span>
                </a>
            </li>

            <!-- Products -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="Products"
                   class="nav-link">
                    <i class="bi bi-box-seam-fill"></i>
                    <span>Products</span>
                </a>
            </li>

            <!-- Testimonials -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="Testimonials"
                   class="nav-link">
                    <i class="bi bi-chat-quote-fill"></i>
                    <span>Testimonials</span>
                </a>
            </li>

            <!-- Team -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="TeamMembers"
                   class="nav-link">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>Team / Leadership</span>
                </a>
            </li>

            <!-- FAQ -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="FAQs"
                   class="nav-link">
                    <i class="bi bi-question-circle-fill"></i>
                    <span>FAQ</span>
                </a>
            </li>

            <!-- Announcements -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="Announcements"
                   class="nav-link">
                    <i class="bi bi-megaphone-fill"></i>
                    <span>Announcements</span>
                </a>
            </li>

            <!-- Events -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="Events"
                   class="nav-link">
                    <i class="bi bi-calendar-event-fill"></i>
                    <span>Events</span>
                </a>
            </li>

            <!-- News -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="News"
                   class="nav-link">
                    <i class="bi bi-newspaper"></i>
                    <span>News / Press Releases</span>
                </a>
            </li>

            <!-- Downloads -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="Downloads"
                   class="nav-link">
                    <i class="bi bi-download"></i>
                    <span>Downloads</span>
                </a>
            </li>

            
            @{
                var currentCareerAction =
                    ViewContext.RouteData.Values["action"]?.ToString();

                var isCareerMenuOpen =
                    currentCareerAction == "Careers" ||
                    currentCareerAction == "CareerApplications";
            }

            <!-- Career Menu with Submenu -->
            <li class="nav-item">

                <button type="button"
                        class="nav-link w-100 border-0 text-start @(isCareerMenuOpen ? "active" : "")"
                        style="background: transparent;"
                        data-bs-toggle="collapse"
                        data-bs-target="#careerSubmenu"
                        aria-expanded="@(isCareerMenuOpen ? "true" : "false")"
                        aria-controls="careerSubmenu">

                    <i class="bi bi-briefcase-fill"></i>
                    <span class="flex-grow-1">Career</span>
                    <i class="bi bi-chevron-down ms-auto"></i>

                </button>

                <div class="collapse @(isCareerMenuOpen ? "show" : "")"
                     id="careerSubmenu">

                    <ul class="list-unstyled ms-3 mb-1">

                        <!-- Career -->
                        <li class="nav-item">
                            <a asp-controller="CMS"
                               asp-action="Careers"
                               class="nav-link @(currentCareerAction == "Careers" ? "active" : "")">
                                <i class="bi bi-briefcase"></i>
                                <span>Career</span>
                            </a>
                        </li>

                        <!-- Career Applications -->
                        <li class="nav-item">
                            <a asp-controller="CMS"
                               asp-action="CareerApplications"
                               class="nav-link @(currentCareerAction == "CareerApplications" ? "active" : "")">
                                <i class="bi bi-file-earmark-person-fill"></i>
                                <span>Career Applications</span>
                            </a>
                        </li>

                    </ul>

                </div>

            </li>

            <!-- Job Applications -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="JobApplications"
                   class="nav-link">
                    <i class="bi bi-file-person-fill"></i>
                    <span>Job Applications</span>
                </a>
            </li>

            <!-- Contact Submissions -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="ContactSubmissions"
                   class="nav-link">
                    <i class="bi bi-envelope-fill"></i>
                    <span>Contact Submissions</span>
                </a>
            </li>

            <div class="sidebar-divider"></div>

            
<!-- Public Contact Us Page -->
<li class="nav-item">
    <a asp-controller="CMS"
       asp-action="Contact"
       class="nav-link"
       target="_blank">
        <i class="bi bi-envelope-paper-fill"></i>
        <span>Contact Us Page</span>
    </a>
</li>

            <!-- Menus / Navigation -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="MenuItems"
                   class="nav-link">
                    <i class="bi bi-list"></i>
                    <span>Menus / Navigation</span>
                </a>
            </li>

            <!-- SEO Management -->
            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="SeoSettings"
                   class="nav-link">
                    <i class="bi bi-search"></i>
                    <span>SEO Management</span>
                </a>
            </li>

            
            @{
                var currentFormAction =
                    ViewContext.RouteData.Values["action"]?.ToString();

                var isFormMenuOpen =
                    currentFormAction == "Forms" ||
                    currentFormAction == "FormSubmissions";
            }

            <!-- Forms Menu -->
            <li class="nav-item">

                <button type="button"
                        class="nav-link w-100 border-0 text-start @(isFormMenuOpen ? "active" : "")"
                        style="background: transparent;"
                        data-bs-toggle="collapse"
                        data-bs-target="#formsSubmenu"
                        aria-expanded="@(isFormMenuOpen ? "true" : "false")"
                        aria-controls="formsSubmenu">

                    <i class="bi bi-ui-checks-grid"></i>
                    <span class="flex-grow-1">Forms</span>
                    <i class="bi bi-chevron-down ms-auto"></i>

                </button>

                <div class="collapse @(isFormMenuOpen ? "show" : "")"
                     id="formsSubmenu">

                    <ul class="list-unstyled ms-3 mb-1">

                        <li class="nav-item">
                            <a asp-controller="CMS"
                               asp-action="Forms"
                               class="nav-link @(currentFormAction == "Forms" ? "active" : "")">
                                <i class="bi bi-ui-checks"></i>
                                <span>Forms</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-controller="CMS"
                               asp-action="FormSubmissions"
                               class="nav-link @(currentFormAction == "FormSubmissions" ? "active" : "")">
                                <i class="bi bi-inbox-fill"></i>
                                <span>Form Submissions</span>
                            </a>
                        </li>

                    </ul>
                </div>
            </li>

            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="Notifications"
                   class="nav-link">
                    <i class="bi bi-bell-fill"></i>
                    <span>Notifications</span>
                </a>
            </li>
             <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")"
                   asp-controller="CMS"
                   asp-action="Settings">

                    <i class="bi bi-gear-fill me-2"></i>
                    <span>Settings</span>

                </a>
            </li

           

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AuditLogs" ? "active" : "")"
                   asp-controller="CMS"
                   asp-action="AuditLogs">
                    <i class="bi bi-journal-text me-2"></i>
                    <span>Audit Logs</span>
                </a>
            </li>

            <!-- Reports -->
<li class="nav-item">
    <a asp-controller="CMS"
       asp-action="Reports"
       class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")">

        <i class="bi bi-bar-chart-fill me-2"></i>

        <span>Reports</span>
    </a>
</li>
         <!-- Trash / Recovery -->
<li class="nav-item">
    <a asp-controller="CMS"
       asp-action="Trash"
       class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Trash" ? "active" : "")">

        <i class="bi bi-trash3-fill me-2"></i>

        <span>Trash / Recovery</span>
    </a>
</li>              

            <li class="nav-item">
                <a asp-controller="CMS"
                   asp-action="Redirects"
                   class="nav-link">
                    <i class="bi bi-arrow-right-circle"></i>
                    <span>Redirects</span>
                </a>
            </li>

        </ul>

    </aside>


    <!-- MAIN CONTENT -->
    <div class="main-content">

        <!-- TOPBAR -->
        <header class="topbar">

            <div>
                <h5 class="mb-0 fw-bold">
                    @ViewData["Title"]
                </h5>
            </div>

           
<div class="user-info">

    @if (SignInManager.IsSignedIn(User))
    {
        <div class="user-avatar">
            <i class="bi bi-person-fill"></i>
        </div>

        <div>
            <div class="fw-semibold">
                @UserManager.GetUserName(User)
            </div>

            <small class="text-muted">
                Admin
            </small>
        </div>

        <form asp-controller="Auth"
              asp-action="Logout"
              method="post"
              class="ms-3">

            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-box-arrow-right me-1"></i>
                Logout
            </button>

        </form>
    }

</div>

        </header>


        <!-- PAGE CONTENT -->
        <main class="content-area">

            @RenderBody()

        </main>

    </div>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>