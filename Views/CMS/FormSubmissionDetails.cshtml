@model CMSPanel.Models.FormSubmission

@{
    ViewData["Title"] = "Form Submission Details";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Form Submission Details</h1>
            <p class="text-muted mb-0">
                View complete submission information
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="EditFormSubmission"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>
                Edit

            </a>

            <a asp-action="FormSubmissions"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back

            </a>

        </div>
    </div>


    <!-- Details Card -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="row g-4">

                <!-- ID -->
                <div class="col-md-6">

                    <label class="form-label text-muted">
                        Submission ID
                    </label>

                    <div class="fw-semibold">
                        #@Model.Id
                    </div>

                </div>


                <!-- Form -->
                <div class="col-md-6">

                    <label class="form-label text-muted">
                        Form
                    </label>

                    <div class="fw-semibold">
                        @(Model.Form?.Name ?? "N/A")
                    </div>

                </div>


                <!-- Name -->
                <div class="col-md-6">

                    <label class="form-label text-muted">
                        Name
                    </label>

                    <div class="fw-semibold">
                        @Model.Name
                    </div>

                </div>


                <!-- Email -->
                <div class="col-md-6">

                    <label class="form-label text-muted">
                        Email
                    </label>

                    <div class="fw-semibold">
                        @Model.Email
                    </div>

                </div>


                <!-- Phone -->
                <div class="col-md-6">

                    <label class="form-label text-muted">
                        Phone
                    </label>

                    <div class="fw-semibold">
                        @(Model.Phone ?? "-")
                    </div>

                </div>


                <!-- Status -->
                <div class="col-md-6">

                    <label class="form-label text-muted">
                        Status
                    </label>

                    <div>

                        @if (Model.Status == "New")
                        {
                            <span class="badge bg-primary">
                                New
                            </span>
                        }
                        else if (Model.Status == "Read")
                        {
                            <span class="badge bg-warning text-dark">
                                Read
                            </span>
                        }
                        else if (Model.Status == "Replied")
                        {
                            <span class="badge bg-success">
                                Replied
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.Status
                            </span>
                        }

                    </div>

                </div>


                <!-- Submitted At -->
                <div class="col-md-6">

                    <label class="form-label text-muted">
                        Submitted At
                    </label>

                    <div class="fw-semibold">
                        @Model.SubmittedAt.ToString("dd MMM yyyy hh:mm tt")
                    </div>

                </div>


                <!-- Updated At -->
                <div class="col-md-6">

                    <label class="form-label text-muted">
                        Updated At
                    </label>

                    <div class="fw-semibold">
                        @(Model.UpdatedAt.HasValue
                            ? Model.UpdatedAt.Value.ToString("dd MMM yyyy hh:mm tt")
                            : "-")
                    </div>

                </div>


                <!-- Submission Data -->
                <div class="col-12">

                    <label class="form-label text-muted">
                        Submission Data
                    </label>

                    <div class="border rounded p-3 bg-light"
                         style="white-space: pre-wrap; min-height: 100px;">
                        @(string.IsNullOrWhiteSpace(Model.SubmissionData)
                            ? "No submission data available."
                            : Model.SubmissionData)
                    </div>

                </div>


                <!-- Remarks -->
                <div class="col-12">

                    <label class="form-label text-muted">
                        Remarks
                    </label>

                    <div class="border rounded p-3 bg-light"
                         style="white-space: pre-wrap; min-height: 80px;">
                        @(string.IsNullOrWhiteSpace(Model.Remarks)
                            ? "No remarks available."
                            : Model.Remarks)
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
