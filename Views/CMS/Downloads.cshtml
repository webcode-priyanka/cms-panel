@model IEnumerable<CMSPanel.Models.Download>

@{
    ViewData["Title"] = "Downloads";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Downloads & Documents</h2>
            <p class="text-muted">Manage downloadable documents</p>
        </div>

        <a asp-action="CreateDownload" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Download
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="Downloads" method="get">
                <div class="row g-3">
                    <div class="col-md-5">
                        <input type="text"
                               name="searchString"
                               value="@Context.Request.Query["searchString"]"
                               class="form-control"
                               placeholder="Search by title, category or file..." />
                    </div>

                    <div class="col-md-4">
                        <select name="status" class="form-select">
                            <option value="">All Statuses</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary">
                            Search
                        </button>
                        <a asp-action="Downloads" class="btn btn-secondary">
                            Reset
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>File Name</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.Title</strong>
                                    </td>

                                    <td>@item.Category</td>

                                    <td>@item.FileName</td>

                                    <td>
                                        @if (item.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @item.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="DownloadDetails"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info text-white">
                                                View
                                            </a>

                                            <a asp-action="EditDownload"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>


                                            <form asp-action="DeleteDownload"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this download?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">
                                    No downloads found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
