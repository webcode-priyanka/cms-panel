@{
    ViewData["Title"] = "Create Role";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Create Role</h1>
        <p class="text-muted">
            Add a new role to the CMS panel
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-action="CreateRole" method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label for="roleName" class="form-label">
                        Role Name
                    </label>

                    <input type="text"
                           id="roleName"
                           name="roleName"
                           class="form-control"
                           placeholder="Enter role name" />
                </div>

                <button type="submit" class="btn btn-primary">
                    Create Role
                </button>

                <a asp-action="Roles"
                   class="btn btn-secondary ms-2">
                    Back
                </a>

            </form>

        </div>
    </div>

</div>
