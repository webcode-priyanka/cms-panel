@{
}
@model CMSPanel.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="fw-bold text-danger">Delete Event</h1>
        <p class="text-muted">Confirm event deletion</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="alert alert-warning">
                Are you sure you want to delete this event?
                This action cannot be undone.
            </div>

            <h4 class="fw-bold">@Model.Title</h4>

            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <div class="mb-3">
                    <img src="@Model.Image"
                         alt="@Model.Title"
                         class="img-fluid rounded"
                         style="max-height:200px; object-fit:cover;" />
                </div>
            }

            <dl class="row mt-4">
                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@Model.Location</dd>

                <dt class="col-sm-3">Start Date</dt>
                <dd class="col-sm-9">
                    @Model.StartDate.ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-3">End Date</dt>
                <dd class="col-sm-9">
                    @(Model.EndDate?.ToString("dd MMM yyyy") ?? "N/A")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">
                    <div style="white-space:pre-wrap;">@Model.Description</div>
                </dd>
            </dl>

            <form asp-action="DeleteEvent" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Yes, Delete
                    </button>

                    <a asp-action="Events" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>