@model IEnumerable<CMSPanel.Models.SeoSetting>

@{
    ViewData["Title"] = "SEO Management";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">SEO Management</h1>

            <p class="text-muted mb-0">
                Manage SEO settings for your website content.
            </p>
        </div>

        <a asp-controller="CMS"
           asp-action="CreateSeoSetting"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Add SEO Setting

        </a>

    </div>


    <!-- Search & Filter -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-controller="CMS"
                  asp-action="SeoSettings"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- Search -->
                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Search SEO title, description or canonical URL..." />

                    </div>


                    <!-- Content Type -->
                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Content Type
                        </label>

                        <select name="contentType"
                                class="form-select">

                            @if (string.IsNullOrWhiteSpace(ViewBag.ContentType))
                            {
                                <option value="" selected>
                                    All Content Types
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All Content Types
                                </option>
                            }

                            @if (ViewBag.ContentType == "Page")
                            {
                                <option value="Page" selected>Page</option>
                            }
                            else
                            {
                                <option value="Page">Page</option>
                            }

                            @if (ViewBag.ContentType == "Blog")
                            {
                                <option value="Blog" selected>Blog</option>
                            }
                            else
                            {
                                <option value="Blog">Blog</option>
                            }

                            @if (ViewBag.ContentType == "Project")
                            {
                                <option value="Project" selected>Project</option>
                            }
                            else
                            {
                                <option value="Project">Project</option>
                            }

                            @if (ViewBag.ContentType == "Service")
                            {
                                <option value="Service" selected>Service</option>
                            }
                            else
                            {
                                <option value="Service">Service</option>
                            }

                            @if (ViewBag.ContentType == "Product")
                            {
                                <option value="Product" selected>Product</option>
                            }
                            else
                            {
                                <option value="Product">Product</option>
                            }

                        </select>

                    </div>


                    <!-- Search Button -->
                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search me-1"></i>
                            Search

                        </button>

                    </div>


                    <!-- Reset Button -->
                    <div class="col-md-1">

                        <a asp-controller="CMS"
                           asp-action="SeoSettings"
                           class="btn btn-outline-secondary w-100"
                           title="Reset">

                            <i class="bi bi-arrow-clockwise"></i>

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- SEO Records Table -->
    <div class="card shadow-sm border-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>#</th>

                        <th>SEO Title</th>

                        <th>Content Type</th>

                        <th>Content ID</th>

                        <th>Meta Description</th>

                        <th>Robots</th>

                        <th>Updated</th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        var count = 1;

                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Number -->
                                <td>
                                    @count
                                </td>


                                <!-- SEO Title -->
                                <td>

                                    <div class="fw-semibold">
                                        @item.SeoTitle
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.MetaKeywords))
                                    {
                                        <small class="text-muted">
                                            @item.MetaKeywords
                                        </small>
                                    }

                                </td>


                                <!-- Content Type -->
                                <td>

                                    <span class="badge bg-primary">
                                        @item.ContentType
                                    </span>

                                </td>


                                <!-- Content ID -->
                                <td>
                                    @item.ContentId
                                </td>


                                <!-- Meta Description -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.MetaDescription))
                                    {
                                        <span>
                                            @item.MetaDescription
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not set
                                        </span>
                                    }

                                </td>


                                <!-- Robots -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.Robots))
                                    {
                                        <span>
                                            @item.Robots
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not set
                                        </span>
                                    }

                                </td>


                                <!-- Updated -->
                                <td>

                                    @if (item.UpdatedAt.HasValue)
                                    {
                                        <div class="fw-semibold">
                                            @item.UpdatedAt.Value.ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted">
                                            @item.UpdatedAt.Value.ToString("hh:mm tt")
                                        </small>
                                    }
                                    else
                                    {
                                        <div class="fw-semibold">
                                            @item.CreatedAt.ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted">
                                            Created
                                        </small>
                                    }

                                </td>


                                <!-- Actions -->
                                <td>

                                    <div class="d-flex justify-content-end gap-2">

                                        <!-- View -->
                                        <a asp-controller="CMS"
                                           asp-action="SeoSettingDetails"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- Edit -->
                                        <a asp-controller="CMS"
                                           asp-action="EditSeoSetting"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- Delete -->
                                        <form asp-controller="CMS"
                                              asp-action="DeleteSeoSetting"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this SEO setting?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                       
                                    </div>

                                </td>

                            </tr>

                            count++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center py-5">

                                <i class="bi bi-search fs-1 text-muted"></i>

                                <h5 class="mt-3">
                                    No SEO settings found
                                </h5>

                                <p class="text-muted mb-0">
                                    Create your first SEO setting.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>