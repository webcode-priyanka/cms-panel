@model CMSPanel.Models.ContactSubmission

@{
    Layout = null;
    ViewData["Title"] = "Contact Us";

    var email = ViewBag.Email as string;
    var phone = ViewBag.Phone as string;
    var siteName = ViewBag.SiteName as string;
    var businessHours = ViewBag.BusinessHours as string;

    var addressParts = new[]
    {
        ViewBag.Address as string,
        ViewBag.City as string,
        ViewBag.State as string,
        ViewBag.PostalCode as string,
        ViewBag.Country as string
    };

    var fullAddress = string.Join(", ",
        addressParts.Where(part =>
            !string.IsNullOrWhiteSpace(part)));

    var socialLinks = new[]
    {
        new
        {
            Name = "Facebook",
            Url = ViewBag.FacebookUrl as string,
            Icon = "bi-facebook"
        },
        new
        {
            Name = "Instagram",
            Url = ViewBag.InstagramUrl as string,
            Icon = "bi-instagram"
        },
        new
        {
            Name = "Twitter / X",
            Url = ViewBag.TwitterUrl as string,
            Icon = "bi-twitter-x"
        },
        new
        {
            Name = "LinkedIn",
            Url = ViewBag.LinkedInUrl as string,
            Icon = "bi-linkedin"
        },
        new
        {
            Name = "YouTube",
            Url = ViewBag.YouTubeUrl as string,
            Icon = "bi-youtube"
        }
    };

    var availableSocialLinks = socialLinks
        .Where(x => !string.IsNullOrWhiteSpace(x.Url))
        .ToList();

    var hasContactInfo =
        !string.IsNullOrWhiteSpace(siteName) ||
        !string.IsNullOrWhiteSpace(email) ||
        !string.IsNullOrWhiteSpace(phone) ||
        !string.IsNullOrWhiteSpace(fullAddress) ||
        !string.IsNullOrWhiteSpace(businessHours) ||
        availableSocialLinks.Any();
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Contact Us - CMSPanel</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    <div class="container py-5">

        <!-- Page Header -->
        <div class="text-center mb-5">

            @if (!string.IsNullOrWhiteSpace(siteName))
            {
                <h2 class="fw-bold mb-3">@siteName</h2>
            }

            <h1 class="fw-bold">Contact Us</h1>

            <p class="text-muted">
                Have a question or need help? Send us a message.
            </p>

        </div>

        <!-- Contact Information -->
        <div class="row justify-content-center mb-4">

            <div class="col-lg-9 col-xl-8">

                <div class="card shadow-sm border-0">

                    <div class="card-body p-4">

                        <h4 class="fw-bold mb-4">
                            Our Contact Information
                        </h4>

                        @if (!hasContactInfo)
                        {
                            <p class="text-muted mb-0">
                                Contact information has not been added
                                in Settings yet.
                            </p>
                        }
                        else
                        {
                            <!-- Site Name -->
                            @if (!string.IsNullOrWhiteSpace(siteName))
                            {
                                <p class="mb-3">
                                    <i class="bi bi-building text-primary me-2"></i>
                                    <strong>Site Name:</strong>
                                    @siteName
                                </p>
                            }

                            <!-- Email -->
                            @if (!string.IsNullOrWhiteSpace(email))
                            {
                                <p class="mb-3">
                                    <i class="bi bi-envelope text-primary me-2"></i>
                                    <strong>Email:</strong>
                                    <a href="mailto:@email">@email</a>
                                </p>
                            }

                            <!-- Phone -->
                            @if (!string.IsNullOrWhiteSpace(phone))
                            {
                                <p class="mb-3">
                                    <i class="bi bi-telephone text-primary me-2"></i>
                                    <strong>Phone:</strong>
                                    <a href="tel:@phone">@phone</a>
                                </p>
                            }

                            <!-- Full Address -->
                            @if (!string.IsNullOrWhiteSpace(fullAddress))
                            {
                                <p class="mb-3">
                                    <i class="bi bi-geo-alt text-primary me-2"></i>
                                    <strong>Address:</strong>
                                    @fullAddress
                                </p>
                            }

                            <!-- Business Hours -->
                            @if (!string.IsNullOrWhiteSpace(businessHours))
                            {
                                <p class="mb-3">
                                    <i class="bi bi-clock text-primary me-2"></i>
                                    <strong>Business Hours:</strong>
                                    @businessHours
                                </p>
                            }

                            <!-- Social Media Links -->
                            @if (availableSocialLinks.Any())
                            {
                                <div class="mt-3">

                                    <h6 class="fw-bold mb-3">
                                        <i class="bi bi-share text-primary me-2"></i>
                                        Follow Us
                                    </h6>

                                    <div class="d-flex flex-wrap gap-3">

                                        @foreach (var social in availableSocialLinks)
                                        {
                                            <a href="@social.Url"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-outline-primary btn-sm">

                                                <i class="bi @social.Icon me-1"></i>
                                                @social.Name

                                            </a>
                                        }

                                    </div>

                                </div>
                            }
                        }

                    </div>

                </div>

            </div>

        </div>

        <!-- Contact Form -->
        <div class="row justify-content-center">

            <div class="col-lg-9 col-xl-8">

                <div class="card shadow-sm border-0">

                    <div class="card-body p-4 p-lg-5">

                        <h3 class="fw-bold mb-4">
                            Send Us a Message
                        </h3>

                        <!-- Success Message -->
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success">

                                <i class="bi bi-check-circle me-2"></i>

                                @TempData["Success"]

                            </div>
                        }

                        <!-- Contact Form -->

                        <form asp-action="SubmitContact"
                              asp-controller="CMS"
                              method="post">

                            @Html.AntiForgeryToken()

                            <!-- Validation Summary -->
                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>

                            <div class="row g-3">

                                <!-- Name -->
                                <div class="col-md-6">

                                    <label asp-for="Name"
                                           class="form-label fw-semibold">
                                        Name *
                                    </label>

                                    <input asp-for="Name"
                                           class="form-control"
                                           placeholder="Enter your name" />

                                    <span asp-validation-for="Name"
                                          class="text-danger">
                                    </span>

                                </div>

                                <!-- Email -->
                                <div class="col-md-6">

                                    <label asp-for="Email"
                                           class="form-label fw-semibold">
                                        Email *
                                    </label>

                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control"
                                           placeholder="Enter your email" />

                                    <span asp-validation-for="Email"
                                          class="text-danger">
                                    </span>

                                </div>

                                <!-- Phone -->
                                <div class="col-md-6">

                                    <label asp-for="Phone"
                                           class="form-label fw-semibold">
                                        Phone
                                    </label>

                                    <input asp-for="Phone"
                                           class="form-control"
                                           placeholder="Enter your phone number" />

                                    <span asp-validation-for="Phone"
                                          class="text-danger">
                                    </span>

                                </div>

                                <!-- Subject -->
                                <div class="col-md-6">

                                    <label asp-for="Subject"
                                           class="form-label fw-semibold">
                                        Subject
                                    </label>

                                    <input asp-for="Subject"
                                           class="form-control"
                                           placeholder="Enter subject" />

                                    <span asp-validation-for="Subject"
                                          class="text-danger">
                                    </span>

                                </div>

                                <!-- Message -->
                                <div class="col-12">

                                    <label asp-for="Message"
                                           class="form-label fw-semibold">
                                        Message *
                                    </label>

                                    <textarea asp-for="Message"
                                              class="form-control"
                                              rows="6"
                                              placeholder="Write your message..."></textarea>

                                    <span asp-validation-for="Message"
                                          class="text-danger">
                                    </span>

                                </div>

                                <!-- Submit -->
                                <div class="col-12">

                                    <button type="submit"
                                            class="btn btn-primary px-4">

                                        <i class="bi bi-send me-1"></i>
                                        Send Message

                                    </button>

                                </div>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>




