@model CMSPanel.Models.ContactSubmission

@{
    ViewData["Title"] = "Delete Contact Submission";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">
            Delete Contact Submission
        </h1>

        <p class="text-muted mb-0">
            Confirm before deleting this contact submission
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Delete Confirmation
            </h5>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-circle me-2"></i>
                Are you sure you want to delete this contact submission?
                This action cannot be undone.
            </div>

            <div class="row g-4">

                <div class="col-md-6">

                    <div class="text-muted small">
                        Name
                    </div>

                    <div class="fw-semibold">
                        @Model.Name
                    </div>

                </div>

                <div class="col-md-6">

                    <div class="text-muted small">
                        Email
                    </div>

                    <div class="fw-semibold">
                        @Model.Email
                    </div>

                </div>

                <div class="col-md-6">

                    <div class="text-muted small">
                        Phone
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Phone))
                    {
                        <div class="fw-semibold">
                            @Model.Phone
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">
                            Not provided
                        </span>
                    }

                </div>

                <div class="col-md-6">

                    <div class="text-muted small">
                        Subject
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Subject))
                    {
                        <div class="fw-semibold">
                            @Model.Subject
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">
                            No subject
                        </span>
                    }

                </div>

                <div class="col-12">

                    <div class="text-muted small mb-1">
                        Message
                    </div>

                    <div class="border rounded p-3 bg-light"
                         style="white-space: pre-line;">
                        @Model.Message
                    </div>

                </div>

            </div>

            <form asp-action="DeleteContactSubmission"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="mt-4">

                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="ContactSubmissions"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left me-1"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Are you sure you want to permanently delete this submission?');">

                        <i class="bi bi-trash me-1"></i>
                        Delete Submission

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
