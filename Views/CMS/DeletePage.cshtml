@model CMSPanel.Models.Page

@{
    ViewData["Title"] = "Delete Page";
}

<style>
    .delete-page-container {
        padding: 25px;
        background: #f8fafc;
        min-height: 80vh;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        flex-wrap: wrap;
        gap: 15px;
    }

        .page-header h1 {
            font-size: 27px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 5px;
        }

        .page-header p {
            color: #64748b;
            margin: 0;
        }

    .delete-card {
        max-width: 850px;
        margin: 0 auto;
        background: #fff;
        border: 1px solid #fee2e2;
        border-radius: 14px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .delete-card-header {
        padding: 22px 25px;
        background: #fff5f5;
        border-bottom: 1px solid #fee2e2;
    }

        .delete-card-header h4 {
            color: #991b1b;
            font-weight: 700;
            margin: 0;
        }

    .delete-card-body {
        padding: 28px;
    }

    .warning-box {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        padding: 18px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 10px;
        margin-bottom: 25px;
    }

    .warning-icon {
        font-size: 25px;
        color: #dc2626;
    }

    .warning-box h5 {
        color: #991b1b;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .warning-box p {
        color: #7f1d1d;
        margin: 0;
        font-size: 14px;
    }

    .details-heading {
        font-size: 17px;
        font-weight: 700;
        color: #334155;
        margin-bottom: 18px;
    }

    .detail-row {
        display: flex;
        padding: 14px 0;
        border-bottom: 1px solid #f1f5f9;
        flex-wrap: wrap;
    }

    .detail-label {
        width: 180px;
        color: #64748b;
        font-weight: 600;
    }

    .detail-value {
        flex: 1;
        color: #1e293b;
        font-weight: 500;
        overflow-wrap: anywhere;
    }

    .status-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        background: #f1f5f9;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
    }

    .delete-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 30px;
        padding-top: 22px;
        border-top: 1px solid #e2e8f0;
        flex-wrap: wrap;
    }

    .btn-delete {
        background: #dc2626;
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-delete:hover {
            background: #b91c1c;
            color: #fff;
        }

    .btn-cancel {
        background: #e2e8f0;
        color: #334155;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-cancel:hover {
            background: #cbd5e1;
            color: #1e293b;
        }

    @@media (max-width: 576px) {
        .delete-page-container {
            padding: 15px;
        }

        .delete-card-body {
            padding: 20px;
        }

        .detail-label {
            width: 100%;
            margin-bottom: 5px;
        }

        .delete-actions {
            flex-direction: column-reverse;
        }

            .delete-actions .btn {
                width: 100%;
                text-align: center;
            }
    }
</style>

<div class="container-fluid delete-page-container">

    <div class="page-header">
        <div>
            <h1>
                <i class="bi bi-trash3 text-danger me-2"></i>
                Delete Page
            </h1>
            <p>Review the page details before deleting it.</p>
        </div>

        <a asp-action="Pages" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Pages
        </a>
    </div>

    <div class="delete-card">

        <div class="delete-card-header">
            <h4>
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Confirm Page Deletion
            </h4>
        </div>

        <div class="delete-card-body">

            <div class="warning-box">
                <div class="warning-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <div>
                    <h5>Are you sure you want to delete this page?</h5>
                    <p>
                        This action may permanently remove the page.
                        Please check the details below before continuing.
                    </p>
                </div>
            </div>

            <h5 class="details-heading">
                <i class="bi bi-file-earmark-text me-2"></i>
                Page Information
            </h5>

            <div class="detail-row">
                <div class="detail-label">Title</div>
                <div class="detail-value">@Model.Title</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Slug</div>
                <div class="detail-value">@Model.Slug</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Status</div>
                <div class="detail-value">
                    <span class="status-badge">@Model.Status</span>
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-label">Created Date</div>
                <div class="detail-value">
                    @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                </div>
            </div>

            <form asp-action="DeletePage" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="delete-actions">
                    <a asp-action="Pages" class="btn btn-cancel">
                        <i class="bi bi-x-circle me-1"></i>
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-delete"
                            onclick="return confirm('Are you sure you want to delete this page?');">
                        <i class="bi bi-trash3 me-1"></i>
                        Yes, Delete Page
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>