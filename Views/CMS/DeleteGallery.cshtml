@model CMSPanel.Models.Gallery

@{
    ViewData["Title"] = "Delete Gallery";
}

<style>
    .delete-gallery-page {
        padding: 10px 4px 30px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }

        .page-header h2 {
            color: #172033;
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .page-header p {
            color: #778196;
            font-size: 14px;
            margin: 0;
        }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 15px;
        border: 1px solid #dfe5ee;
        border-radius: 8px;
        background: #fff;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .back-btn:hover {
            background: #f8fafc;
            color: #2563eb;
        }

    .delete-card {
        background: #fff;
        border: 1px solid #e9edf5;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        overflow: hidden;
    }

    .delete-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
    }

    .header-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #fee2e2;
        color: #dc2626;
        font-size: 20px;
    }

    .delete-card-header h5 {
        color: #172033;
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 4px;
    }

    .delete-card-header p {
        color: #8791a3;
        font-size: 12px;
        margin: 0;
    }

    .delete-card-body {
        padding: 25px;
    }

    .warning-box {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px 18px;
        margin-bottom: 25px;
        border: 1px solid #fecaca;
        border-radius: 9px;
        background: #fef2f2;
        color: #991b1b;
    }

        .warning-box i {
            font-size: 21px;
            margin-top: 1px;
        }

    .warning-title {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .warning-text {
        color: #b45353;
        font-size: 12px;
        margin: 0;
    }

    .gallery-preview {
        padding: 12px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #f8fafc;
    }

    .gallery-image {
        display: block;
        width: 100%;
        height: 250px;
        object-fit: cover;
        border-radius: 7px;
        background: #f1f5f9;
    }

    .image-placeholder {
        width: 100%;
        height: 250px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 7px;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 45px;
    }

    .image-caption {
        margin-top: 10px;
        color: #64748b;
        font-size: 11px;
        text-align: center;
    }

    .details-heading {
        color: #172033;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 18px;
        padding-bottom: 12px;
        border-bottom: 1px solid #edf0f5;
    }

    .detail-item {
        margin-bottom: 18px;
    }

    .detail-label {
        display: block;
        color: #8791a3;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .detail-value {
        color: #334155;
        font-size: 14px;
        font-weight: 500;
        overflow-wrap: anywhere;
    }

    .gallery-category {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        background: #e0f2fe;
        color: #0369a1;
        font-size: 11px;
        font-weight: 600;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-active {
        background: #dcfce7;
        color: #15803d;
    }

    .status-inactive {
        background: #f1f5f9;
        color: #64748b;
    }

    .delete-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #edf0f5;
    }

    .btn-cancel,
    .btn-delete {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 18px;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

    .btn-cancel {
        color: #475569;
        background: #fff;
        border: 1px solid #dfe5ee;
    }

        .btn-cancel:hover {
            color: #1e293b;
            background: #f8fafc;
        }

    .btn-delete {
        color: #fff;
        background: #dc2626;
        border: 1px solid #dc2626;
    }

        .btn-delete:hover {
            color: #fff;
            background: #b91c1c;
            border-color: #b91c1c;
        }

    @@media (max-width: 600px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .delete-card-header {
            padding: 17px 18px;
        }

        .delete-card-body {
            padding: 18px;
        }

        .gallery-image,
        .image-placeholder {
            height: 210px;
        }

        .delete-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

            .delete-actions .btn {
                width: 100%;
            }
    }
</style>

<div class="container-fluid delete-gallery-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h2>Delete Gallery</h2>
            <p>Review the gallery item before deleting it</p>
        </div>

        <a asp-controller="CMS"
           asp-action="Gallery"
           class="back-btn">
            <i class="bi bi-arrow-left"></i>
            Back to Gallery
        </a>
    </div>

    <!-- Delete Card -->
    <div class="delete-card">

        <div class="delete-card-header">
            <div class="header-icon">
                <i class="bi bi-trash"></i>
            </div>

            <div>
                <h5>Delete Gallery Item</h5>
                <p>Review the information below before confirming</p>
            </div>
        </div>

        <div class="delete-card-body">

            <!-- Warning -->
            <div class="warning-box">
                <i class="bi bi-exclamation-triangle-fill"></i>

                <div>
                    <div class="warning-title">
                        Are you sure you want to delete this gallery item?
                    </div>

                    <p class="warning-text">
                        This action will permanently remove this item.
                        Please confirm before proceeding.
                    </p>
                </div>
            </div>

            <!-- Gallery Details -->
            <div class="row g-4">

                <!-- Image Preview -->
                <div class="col-lg-4 col-md-5">
                    <div class="gallery-preview">

                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl"
                                 alt="@Model.Title"
                                 class="gallery-image"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                            <div class="image-placeholder"
                                 style="display:none;">
                                <i class="bi bi-image"></i>
                            </div>
                        }
                        else
                        {
                            <div class="image-placeholder">
                                <i class="bi bi-image"></i>
                            </div>
                        }

                        <div class="image-caption">
                            Gallery Image Preview
                        </div>

                    </div>
                </div>

                <!-- Details -->
                <div class="col-lg-8 col-md-7">

                    <h6 class="details-heading">
                        <i class="bi bi-info-circle me-2"></i>
                        Gallery Information
                    </h6>

                    <div class="detail-item">
                        <span class="detail-label">Title</span>
                        <div class="detail-value">
                            @Model.Title
                        </div>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Category</span>
                        <div class="detail-value">
                            @if (!string.IsNullOrWhiteSpace(Model.Category))
                            {
                                <span class="gallery-category">
                                    @Model.Category
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Not specified</span>
                            }
                        </div>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Description</span>
                        <div class="detail-value">
                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                @Model.Description
                            }
                            else
                            {
                                <span class="text-muted">No description available</span>
                            }
                        </div>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Status</span>
                        <div>
                            @if (Model.IsActive)
                            {
                                <span class="status-badge status-active">
                                    <i class="bi bi-circle-fill"></i>
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">
                                    <i class="bi bi-circle-fill"></i>
                                    Inactive
                                </span>
                            }
                        </div>
                    </div>

                </div>
            </div>

            <!-- Action Buttons -->
            <div class="delete-actions">

                <a asp-controller="CMS"
                   asp-action="Gallery"
                   class="btn btn-cancel">
                    <i class="bi bi-x-circle"></i>
                    Cancel
                </a>

                <form asp-controller="CMS"
                      asp-action="DeleteGallery"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to permanently delete this gallery item?');">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />

                    <button type="submit" class="btn btn-delete">
                        <i class="bi bi-trash"></i>
                        Delete Gallery
                    </button>

                </form>

            </div>

        </div>
    </div>
</div>