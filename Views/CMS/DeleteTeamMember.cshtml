@model CMSPanel.Models.TeamMember

@{
    ViewData["Title"] = "Delete Team Member";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold text-danger">Delete Team Member</h2>
        <p class="text-muted">Confirm before deleting this team member.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="alert alert-warning">
                Are you sure you want to delete this team member?
                This action cannot be undone.
            </div>

            <div class="text-center mb-4">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.Name"
                         class="rounded-circle"
                         style="width:110px;height:110px;object-fit:cover;" />
                }
                else
                {
                    <i class="bi bi-person-circle text-secondary"
                       style="font-size:110px;"></i>
                }

                <h4 class="mt-3">@Model.Name</h4>
                <p class="text-muted">@Model.Designation</p>
            </div>

            <hr />

            <dl class="row">
                <dt class="col-md-3">Name</dt>
                <dd class="col-md-9">@Model.Name</dd>

                <dt class="col-md-3">Designation</dt>
                <dd class="col-md-9">@Model.Designation</dd>

                <dt class="col-md-3">Email</dt>
                <dd class="col-md-9">@(Model.Email ?? "Not provided")</dd>

                <dt class="col-md-3">Status</dt>
                <dd class="col-md-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>
            </dl>

            <form asp-action="DeleteTeamMember" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete
                </button>

                <a asp-action="TeamMembers" class="btn btn-secondary">
                    Cancel
                </a>
            </form>

        </div>
    </div>
</div>
