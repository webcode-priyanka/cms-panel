@model CMSPanel.Models.Redirect

@{
    ViewData["Title"] = "Create Redirect";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold mb-1">Create Redirect</h1>

        <p class="text-muted mb-0">
            Create a new URL redirect.
        </p>
    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-controller="CMS"
                  asp-action="CreateRedirect"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- Source URL -->
                <div class="mb-3">

                    <label asp-for="SourceUrl"
                           class="form-label fw-semibold">
                        Source URL
                    </label>

                    <input asp-for="SourceUrl"
                           class="form-control"
                           placeholder="/old-page" />

                    <small class="text-muted">
                        Example: /old-page
                    </small>

                    <span asp-validation-for="SourceUrl"
                          class="text-danger">
                    </span>

                </div>


                <!-- Destination URL -->
                <div class="mb-3">

                    <label asp-for="DestinationUrl"
                           class="form-label fw-semibold">
                        Destination URL
                    </label>

                    <input asp-for="DestinationUrl"
                           class="form-control"
                           placeholder="/new-page or https://example.com/new-page" />

                    <small class="text-muted">
                        Enter the URL where visitors should be redirected.
                    </small>

                    <span asp-validation-for="DestinationUrl"
                          class="text-danger">
                    </span>

                </div>


                <div class="row">

                    <!-- Redirect Type -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="RedirectType"
                               class="form-label fw-semibold">
                            Redirect Type
                        </label>

                        <select asp-for="RedirectType"
                                class="form-select">

                            <option value="301">
                                301 - Permanent Redirect
                            </option>

                            <option value="302">
                                302 - Temporary Redirect
                            </option>

                        </select>

                        <span asp-validation-for="RedirectType"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Status -->
                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <div class="form-check form-switch mt-2">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Active
                            </label>

                        </div>

                    </div>

                </div>


                <!-- Buttons -->
                <div class="d-flex gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg me-1"></i>
                        Create Redirect

                    </button>


                    <a asp-controller="CMS"
                       asp-action="Redirects"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-1"></i>
                        Back

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}