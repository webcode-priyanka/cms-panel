
@model CMSPanel.Models.News

@{
    ViewData["Title"] = "Edit News";
}

<style>
    .edit-news-page {
        min-height: 100vh;
        padding: 28px;
        background: #f5f7fb;
        color: #1f2937;
    }

    .news-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 26px;
    }

        .news-page-header h1 {
            font-size: 27px;
            font-weight: 750;
            color: #111827;
            margin-bottom: 6px;
        }

        .news-page-header p {
            color: #6b7280;
            margin: 0;
        }

    .news-form-card {
        background: #fff;
        border: 1px solid #e8ecf3;
        border-radius: 16px;
        box-shadow: 0 5px 22px rgba(15, 23, 42, .04);
        overflow: hidden;
    }

    .news-form-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 22px 26px;
        border-bottom: 1px solid #edf0f5;
    }

    .news-header-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        border-radius: 12px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 22px;
    }

    .news-form-header h5 {
        margin: 0 0 4px;
        font-weight: 700;
        color: #111827;
    }

    .news-form-header p {
        margin: 0;
        font-size: 13px;
        color: #6b7280;
    }

    .news-form-body {
        padding: 26px;
    }

    .news-section {
        padding-bottom: 26px;
        margin-bottom: 25px;
        border-bottom: 1px solid #edf0f5;
    }

        .news-section:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

    .news-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        color: #111827;
        font-size: 16px;
        font-weight: 700;
    }

        .news-section-title i {
            color: #4f46e5;
            font-size: 19px;
        }

    .news-label {
        display: block;
        margin-bottom: 8px;
        color: #374151;
        font-size: 13px;
        font-weight: 650;
    }

    .news-control {
        width: 100%;
        padding: 11px 13px;
        border: 1px solid #dfe3eb;
        border-radius: 9px;
        background: #fff;
        color: #1f2937;
        font-size: 14px;
        transition: border-color .2s, box-shadow .2s;
    }

        .news-control:focus {
            border-color: #818cf8;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, .10);
            outline: none;
        }

        .news-control::placeholder {
            color: #9ca3af;
        }

    textarea.news-control {
        resize: vertical;
        line-height: 1.7;
    }

    .news-help {
        margin-top: 6px;
        color: #9ca3af;
        font-size: 12px;
    }

    .news-validation {
        display: block;
        margin-top: 5px;
        font-size: 12px;
    }

    .news-validation-summary:empty {
        display: none;
    }

    .news-current-image {
        display: inline-block;
        max-width: 100%;
        max-height: 220px;
        object-fit: contain;
        margin-top: 12px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 4px;
        background: #fff;
    }

    .news-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 20px 26px;
        background: #fafbfe;
        border-top: 1px solid #edf0f5;
    }

    .news-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 17px;
        border: 1px solid transparent;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
    }

    .news-btn-primary {
        background: #4f46e5;
        border-color: #4f46e5;
        color: #fff;
    }

        .news-btn-primary:hover {
            background: #4338ca;
            border-color: #4338ca;
            color: #fff;
        }

    .news-btn-secondary {
        background: #fff;
        border-color: #d1d5db;
        color: #374151;
    }

        .news-btn-secondary:hover {
            background: #f3f4f6;
            color: #111827;
        }

    @@media (max-width: 768px) {
        .edit-news-page {
            padding: 15px;
        }

        .news-page-header h1 {
            font-size: 23px;
        }

        .news-form-header,
        .news-form-body {
            padding: 18px;
        }

        .news-actions {
            padding: 17px 18px;
        }

            .news-actions > div {
                width: 100%;
            }

            .news-actions .news-btn {
                flex: 1;
            }
    }
</style>

<div class="edit-news-page">

    <!-- Page Header -->
    <div class="news-page-header">
        <div>
            <h1>
                <i class="bi bi-newspaper me-2"></i>
                Edit News
            </h1>
            <p>Update news, publication details, attachments and SEO settings.</p>
        </div>

        <a asp-action="News" class="news-btn news-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to News
        </a>
    </div>

    <!-- Main Form -->
    <div class="news-form-card">

        <div class="news-form-header">
            <div class="news-header-icon">
                <i class="bi bi-pencil-square"></i>
            </div>

            <div>
                <h5>Update News Information</h5>
                <p>News ID: @Model.Id · Update the fields and save your changes.</p>
            </div>
        </div>

        <form asp-action="EditNews" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div class="news-form-body">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger news-validation-summary mb-4"></div>

                <!-- Basic Information -->
                <div class="news-section">
                    <h5 class="news-section-title">
                        <i class="bi bi-info-circle"></i>
                        Basic Information
                    </h5>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="Title" class="news-label">
                                News Title <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title"
                                   class="news-control"
                                   placeholder="Enter news title" />
                            <span asp-validation-for="Title"
                                  class="text-danger news-validation"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Slug" class="news-label">
                                URL Slug
                            </label>
                            <input asp-for="Slug"
                                   class="news-control"
                                   placeholder="news-url-slug" />
                            <span asp-validation-for="Slug"
                                  class="text-danger news-validation"></span>
                            <div class="news-help">
                                Use a short, readable URL-friendly value.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Author" class="news-label">
                                Author
                            </label>
                            <input asp-for="Author"
                                   class="news-control"
                                   placeholder="Enter author name" />
                            <span asp-validation-for="Author"
                                  class="text-danger news-validation"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Category" class="news-label">
                                Category
                            </label>
                            <input asp-for="Category"
                                   class="news-control"
                                   placeholder="Enter news category" />
                            <span asp-validation-for="Category"
                                  class="text-danger news-validation"></span>
                        </div>

                    </div>
                </div>

                <!-- Publication -->
                <div class="news-section">
                    <h5 class="news-section-title">
                        <i class="bi bi-calendar-check"></i>
                        Publication & Status
                    </h5>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="PublicationDate" class="news-label">
                                Publication Date
                            </label>
                            <input asp-for="PublicationDate"
                                   type="date"
                                   asp-format="{0:yyyy-MM-dd}"
                                   class="news-control" />
                            <span asp-validation-for="PublicationDate"
                                  class="text-danger news-validation"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="news-label">
                                Publication Status
                            </label>
                            <select asp-for="Status" class="news-control">
                                <option value="Draft">Draft</option>
                                <option value="Published">Published</option>
                                <option value="Archived">Archived</option>
                            </select>
                            <span asp-validation-for="Status"
                                  class="text-danger news-validation"></span>
                            <div class="news-help">
                                Choose whether the news is a draft, published or archived.
                            </div>
                        </div>

                    </div>
                </div>

                <!-- News Content -->
                <div class="news-section">
                    <h5 class="news-section-title">
                        <i class="bi bi-file-text"></i>
                        News Content
                    </h5>

                    <div class="row g-4">

                        <div class="col-12">
                            <label asp-for="Excerpt" class="news-label">
                                Short Excerpt
                            </label>
                            <textarea asp-for="Excerpt"
                                      class="news-control"
                                      rows="3"
                                      placeholder="Enter a short summary of the news"></textarea>
                            <span asp-validation-for="Excerpt"
                                  class="text-danger news-validation"></span>
                            <div class="news-help">
                                A brief summary to introduce the news article.
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Content" class="news-label">
                                Full News Content
                            </label>
                            <textarea asp-for="Content"
                                      class="news-control"
                                      rows="9"
                                      placeholder="Write the complete news content here..."></textarea>
                            <span asp-validation-for="Content"
                                  class="text-danger news-validation"></span>
                        </div>

                    </div>
                </div>

                <!-- Media -->
                <div class="news-section">
                    <h5 class="news-section-title">
                        <i class="bi bi-paperclip"></i>
                        Media & Attachments
                    </h5>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="Image" class="news-label">
                                Image Path or URL
                            </label>
                            <input asp-for="Image"
                                   class="news-control"
                                   placeholder="Enter image path or URL" />
                            <span asp-validation-for="Image"
                                  class="text-danger news-validation"></span>

                            @if (!string.IsNullOrWhiteSpace(Model.Image))
                            {
                                <div class="mt-3">
                                    <div class="news-label">Current Image</div>
                                    <img src="@Model.Image"
                                         alt="Current news image"
                                         class="news-current-image" />
                                </div>
                            }
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Attachment" class="news-label">
                                Attachment Path or URL
                            </label>
                            <input asp-for="Attachment"
                                   class="news-control"
                                   placeholder="Enter attachment path or URL" />
                            <span asp-validation-for="Attachment"
                                  class="text-danger news-validation"></span>
                            <div class="news-help">
                                Add a document or attachment path if available.
                            </div>
                        </div>

                    </div>
                </div>

                <!-- SEO -->
                <div class="news-section">
                    <h5 class="news-section-title">
                        <i class="bi bi-search"></i>
                        SEO Settings
                    </h5>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="MetaTitle" class="news-label">
                                Meta Title
                            </label>
                            <input asp-for="MetaTitle"
                                   class="news-control"
                                   placeholder="Enter SEO meta title" />
                            <span asp-validation-for="MetaTitle"
                                  class="text-danger news-validation"></span>
                            <div class="news-help">
                                A concise title for search engine results.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MetaDescription" class="news-label">
                                Meta Description
                            </label>
                            <textarea asp-for="MetaDescription"
                                      class="news-control"
                                      rows="3"
                                      placeholder="Enter SEO meta description"></textarea>
                            <span asp-validation-for="MetaDescription"
                                  class="text-danger news-validation"></span>
                            <div class="news-help">
                                A short summary describing the article.
                            </div>
                        </div>

                    </div>
                </div>

            </div>

            <!-- Footer Actions -->
            <div class="news-actions">
                <a asp-action="News" class="news-btn news-btn-secondary">
                    <i class="bi bi-x-circle"></i>
                    Cancel
                </a>

                <div class="d-flex flex-wrap gap-2">
                    <button type="reset" class="news-btn news-btn-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Reset Form
                    </button>

                    <button type="submit" class="news-btn news-btn-primary">
                        <i class="bi bi-check2-circle"></i>
                        Update News
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
