@model CMSPanel.Models.BlogCategory

@{
    ViewData["Title"] = "Blog Category Details";
}

<style>
    .category-details-page {
        padding: 25px;
    }

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

    .details-title {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 5px;
    }

    .details-subtitle {
        color: #64748b;
        margin-bottom: 0;
    }

    .details-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .details-card-header {
        padding: 22px 25px;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
        border-bottom: 1px solid #e2e8f0;
    }

        .details-card-header h5 {
            font-weight: 700;
            color: #1e293b;
            margin: 0;
        }

    .details-card-body {
        padding: 28px;
    }

    .info-box {
        height: 100%;
        padding: 20px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #fff;
        transition: all 0.2s ease;
    }

        .info-box:hover {
            border-color: #93c5fd;
            box-shadow: 0 5px 15px rgba(37, 99, 235, 0.08);
        }

    .info-label {
        display: block;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 10px;
    }

    .info-value {
        color: #1e293b;
        font-size: 17px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .description-box {
        padding: 20px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        color: #475569;
        line-height: 1.7;
        min-height: 100px;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .status-active {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 14px;
        border-radius: 30px;
        background: #dcfce7;
        color: #15803d;
        font-size: 13px;
        font-weight: 700;
    }

    .status-inactive {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 14px;
        border-radius: 30px;
        background: #fee2e2;
        color: #b91c1c;
        font-size: 13px;
        font-weight: 700;
    }

    .details-btn {
        padding: 10px 18px;
        border-radius: 9px;
        font-weight: 600;
    }

    .edit-btn {
        background: #f59e0b;
        color: #fff;
        border: none;
    }

        .edit-btn:hover {
            background: #d97706;
            color: #fff;
        }

    .back-btn {
        background: #64748b;
        color: #fff;
        border: none;
    }

        .back-btn:hover {
            background: #475569;
            color: #fff;
        }

    @@media (max-width: 576px) {
        .category-details-page {
            padding: 15px;
        }

        .details-title {
            font-size: 23px;
        }

        .details-card-body {
            padding: 18px;
        }

        .details-header {
            align-items: flex-start;
        }
    }
</style>

<div class="container-fluid category-details-page">

    <!-- Page Header -->
    <div class="details-header">
        <div>
            <h1 class="details-title">
                <i class="bi bi-folder2-open text-primary me-2"></i>
                Blog Category Details
            </h1>
            <p class="details-subtitle">
                View complete information about this blog category.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="EditBlogCategory"
               asp-route-id="@Model.Id"
               class="btn details-btn edit-btn">
                <i class="bi bi-pencil-square me-1"></i>
                Edit Category
            </a>

            <a asp-action="BlogCategories"
               class="btn details-btn back-btn">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </a>
        </div>
    </div>

    <!-- Details Card -->
    <div class="details-card">

        <div class="details-card-header">
            <h5>
                <i class="bi bi-info-circle text-primary me-2"></i>
                Category Information
            </h5>
        </div>

        <div class="details-card-body">

            <div class="row g-4">

                <!-- Category Name -->
                <div class="col-md-6">
                    <div class="info-box">
                        <span class="info-label">
                            <i class="bi bi-folder me-1"></i>
                            Category Name
                        </span>

                        <div class="info-value">
                            @Model.Name
                        </div>
                    </div>
                </div>

                <!-- Slug -->
                <div class="col-md-6">
                    <div class="info-box">
                        <span class="info-label">
                            <i class="bi bi-link-45deg me-1"></i>
                            Slug
                        </span>

                        <div class="info-value">
                            @(string.IsNullOrWhiteSpace(Model.Slug)
                                ? "Not set"
                                : Model.Slug)
                        </div>
                    </div>
                </div>

                <!-- Status -->
                <div class="col-md-6">
                    <div class="info-box">
                        <span class="info-label">
                            <i class="bi bi-toggle-on me-1"></i>
                            Status
                        </span>

                        <div>
                            @if (Model.IsActive)
                            {
                                <span class="status-active">
                                    <i class="bi bi-check-circle-fill"></i>
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="status-inactive">
                                    <i class="bi bi-x-circle-fill"></i>
                                    Inactive
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Created Date -->
                <div class="col-md-6">
                    <div class="info-box">
                        <span class="info-label">
                            <i class="bi bi-calendar-check me-1"></i>
                            Created At
                        </span>

                        <div class="info-value">
                            @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div class="col-12">
                    <div class="info-box">
                        <span class="info-label">
                            <i class="bi bi-card-text me-1"></i>
                            Description
                        </span>

                        <div class="description-box">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "No description available."
                                : Model.Description)
                        </div>
                    </div>
                </div>

                <!-- Last Updated -->
                <div class="col-12">
                    <div class="info-box">
                        <span class="info-label">
                            <i class="bi bi-clock-history me-1"></i>
                            Last Updated
                        </span>

                        <div class="info-value">
                            @(Model.UpdatedAt.HasValue
                                ? Model.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                : "Not updated yet")
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
