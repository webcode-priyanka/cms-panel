@model IEnumerable<CMSPanel.Models.FormSubmission>

@{
    ViewData["Title"] = "Form Submissions";

    var forms = ViewBag.Forms as IEnumerable<CMSPanel.Models.Form>;
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Form Submissions</h1>
            <p class="text-muted mb-0">
                Manage and review submitted form entries
            </p>
        </div>

        <a asp-action="CreateFormSubmission"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Submission
        </a>
    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-1"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- Search & Filter -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-action="FormSubmissions"
                  method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-md-4">
                        <label class="form-label">
                            Search
                        </label>

                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Name, email, phone..." />
                    </div>


                    <!-- Form -->
                    <div class="col-md-3">
                        <label class="form-label">
                            Form
                        </label>

                        <select name="formId"
                                class="form-select">

                            <option value="">
                                All Forms
                            </option>

                            @if (forms != null)
                            {
                                foreach (var form in forms)
                                {
                                    if (ViewBag.FormId != null &&
                                    (int)ViewBag.FormId == form.Id)
                                    {
                                        <option value="@form.Id"
                                                selected>
                                            @form.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@form.Id">
                                            @form.Name
                                        </option>
                                    }
                                }
                            }

                        </select>
                    </div>


                    <!-- Status -->
                    <div class="col-md-3">
                        <label class="form-label">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All Status
                            </option>

                            @if (ViewBag.Status == "New")
                            {
                                <option value="New" selected>
                                    New
                                </option>
                            }
                            else
                            {
                                <option value="New">
                                    New
                                </option>
                            }

                            @if (ViewBag.Status == "Read")
                            {
                                <option value="Read" selected>
                                    Read
                                </option>
                            }
                            else
                            {
                                <option value="Read">
                                    Read
                                </option>
                            }

                            @if (ViewBag.Status == "Replied")
                            {
                                <option value="Replied" selected>
                                    Replied
                                </option>
                            }
                            else
                            {
                                <option value="Replied">
                                    Replied
                                </option>
                            }

                        </select>
                    </div>


                    <!-- Buttons -->
                    <div class="col-md-2 d-flex align-items-end gap-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search"></i>
                            Filter

                        </button>

                        <a asp-action="FormSubmissions"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-clockwise"></i>

                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>


    <!-- Submission Table -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>#</th>
                            <th>Form</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th class="text-center">
                                Actions
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.Id
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @(item.Form?.Name ?? "N/A")
                                        </span>
                                    </td>

                                    <td>
                                        @item.Name
                                    </td>

                                    <td>
                                        @item.Email
                                    </td>

                                    <td>
                                        @(item.Phone ?? "-")
                                    </td>

                                    <td>

                                        @if (item.Status == "New")
                                        {
                                            <span class="badge bg-primary">
                                                New
                                            </span>
                                        }
                                        else if (item.Status == "Read")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Read
                                            </span>
                                        }
                                        else if (item.Status == "Replied")
                                        {
                                            <span class="badge bg-success">
                                                Replied
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @item.SubmittedAt.ToString("dd MMM yyyy hh:mm tt")
                                    </td>

                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-2">

                                            <!-- Details -->
                                            <a asp-action="FormSubmissionDetails"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="View">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- Edit -->
                                            <a asp-action="EditFormSubmission"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <!-- Delete -->
                                            <a asp-action="DeleteFormSubmission"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Delete">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>

                                        <h5>
                                            No form submissions found
                                        </h5>

                                        <p class="mb-0">
                                            There are no submissions matching your filters.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
