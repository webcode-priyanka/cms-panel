```cshtml
@model CMSPanel.Models.Announcement

@{
    ViewData["Title"] = "Edit Announcement";
}

<style>
    .announcement-edit-page {
        background: #f5f7fb;
        min-height: 100vh;
        padding: 28px;
        border-radius: 14px;
    }

    .page-title {
        font-size: 27px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 6px;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 0;
    }

    .edit-card {
        background: #ffffff;
        border: 1px solid #e8edf5;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, .04);
        overflow: hidden;
    }

    .edit-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 22px 26px;
        border-bottom: 1px solid #edf0f5;
    }

    .edit-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 12px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 22px;
    }

    .edit-card-body {
        padding: 26px;
    }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #334155;
        margin-bottom: 20px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        min-height: 44px;
        border: 1px solid #dfe5ee;
        border-radius: 8px;
        font-size: 14px;
        color: #1e293b;
        box-shadow: none;
    }

    textarea.form-control {
        min-height: 130px;
        resize: vertical;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #818cf8;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, .10);
    }

    .input-icon-wrap {
        position: relative;
    }

        .input-icon-wrap > i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            pointer-events: none;
        }

        .input-icon-wrap .form-control,
        .input-icon-wrap .form-select {
            padding-left: 38px;
        }

    .field-hint {
        display: block;
        font-size: 12px;
        color: #94a3b8;
        margin-top: 6px;
    }

    .status-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        background: #f8fafc;
        border: 1px solid #e8edf5;
        border-radius: 10px;
        padding: 16px 18px;
    }

    .status-title {
        font-size: 14px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 4px;
    }

    .status-description {
        font-size: 12px;
        color: #64748b;
        margin-bottom: 0;
    }

    .form-check-input {
        width: 2.5em;
        height: 1.3em;
        cursor: pointer;
        margin-top: 0;
    }

        .form-check-input:checked {
            background-color: #4f46e5;
            border-color: #4f46e5;
        }

    .section-divider {
        border: 0;
        border-top: 1px solid #edf0f5;
        margin: 26px 0;
    }

    .btn-update {
        background: #4f46e5;
        color: #fff;
        border: 1px solid #4f46e5;
        border-radius: 8px;
        padding: 11px 19px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-update:hover {
            background: #4338ca;
            border-color: #4338ca;
            color: #fff;
        }

    .btn-cancel {
        background: #fff;
        color: #475569;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 11px 19px;
        font-size: 14px;
        font-weight: 600;
    }

        .btn-cancel:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

    .validation-summary-valid {
        display: none;
    }

    .validation-summary-errors {
        background: #fff1f2;
        border: 1px solid #fecdd3;
        border-radius: 9px;
        padding: 12px 16px;
        color: #be123c;
        font-size: 13px;
    }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        font-size: 12px;
        color: #dc2626;
    }

    .input-validation-error {
        border-color: #dc2626 !important;
    }

    @@media (max-width: 768px) {
        .announcement-edit-page {
            padding: 15px;
        }

        .edit-card-header,
        .edit-card-body {
            padding: 19px;
        }

        .page-title {
            font-size: 23px;
        }
    }
</style>

<div class="container-fluid announcement-edit-page">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="page-title">
                <i class="bi bi-megaphone me-2" style="color:#4f46e5;"></i>
                Edit Announcement
            </h1>
            <p class="page-subtitle">
                Update announcement details, schedule and visibility.
            </p>
        </div>

        <a asp-action="Announcements" class="btn btn-cancel">
            <i class="bi bi-arrow-left me-1"></i>
            Back to List
        </a>
    </div>

    <!-- Edit Form Card -->
    <div class="edit-card">

        <div class="edit-card-header">
            <div class="edit-icon">
                <i class="bi bi-pencil-square"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-1" style="color:#1e293b;">
                    Announcement Information
                </h5>
                <p class="text-muted small mb-0">
                    Modify the fields below and save your changes.
                </p>
            </div>
        </div>

        <div class="edit-card-body">

            <form asp-action="EditAnnouncement" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4"></div>

                <!-- Basic Information -->
                <h6 class="section-title">
                    <i class="bi bi-info-circle me-2" style="color:#4f46e5;"></i>
                    Basic Information
                </h6>

                <div class="mb-4">
                    <label asp-for="Title" class="form-label">
                        Announcement Title <span class="text-danger">*</span>
                    </label>

                    <div class="input-icon-wrap">
                        <i class="bi bi-type"></i>
                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Enter announcement title" />
                    </div>

                    <span asp-validation-for="Title"
                          class="field-validation-error"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Enter announcement description..."></textarea>

                    <span asp-validation-for="Description"
                          class="field-validation-error"></span>

                    <small class="field-hint">
                        Provide clear information about this announcement.
                    </small>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Type" class="form-label">
                            Announcement Type
                        </label>

                        <div class="input-icon-wrap">
                            <i class="bi bi-tags"></i>
                            <select asp-for="Type" class="form-select">
                                <option value="">Select type</option>
                                <option value="Notice">Notice</option>
                                <option value="Banner">Banner</option>
                                <option value="Alert">Alert</option>
                            </select>
                        </div>

                        <span asp-validation-for="Type"
                              class="field-validation-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DisplayOrder" class="form-label">
                            Display Order
                        </label>

                        <div class="input-icon-wrap">
                            <i class="bi bi-sort-numeric-down"></i>
                            <input asp-for="DisplayOrder"
                                   type="number"
                                   class="form-control"
                                   placeholder="Enter display order" />
                        </div>

                        <span asp-validation-for="DisplayOrder"
                              class="field-validation-error"></span>

                        <small class="field-hint">
                            Lower numbers can be displayed first if your list uses ascending order.
                        </small>
                    </div>
                </div>

                <hr class="section-divider" />

                <!-- Schedule -->
                <h6 class="section-title">
                    <i class="bi bi-calendar-event me-2"
                       style="color:#4f46e5;"></i>
                    Announcement Schedule
                </h6>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label">
                            Start Date <span class="text-danger">*</span>
                        </label>

                        <div class="input-icon-wrap">
                            <i class="bi bi-calendar3"></i>
                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control" />
                        </div>

                        <span asp-validation-for="StartDate"
                              class="field-validation-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label">
                            End Date
                        </label>

                        <div class="input-icon-wrap">
                            <i class="bi bi-calendar-check"></i>
                            <input asp-for="EndDate"
                                   type="date"
                                   class="form-control" />
                        </div>

                        <span asp-validation-for="EndDate"
                              class="field-validation-error"></span>

                        <small class="field-hint">
                            Leave blank if no end date is required.
                        </small>
                    </div>
                </div>

                <hr class="section-divider" />

                <!-- Visibility -->
                <h6 class="section-title">
                    <i class="bi bi-sliders me-2" style="color:#4f46e5;"></i>
                    Visibility Settings
                </h6>

                <div class="status-panel">
                    <div class="d-flex align-items-center gap-3">
                        <div class="edit-icon"
                             style="width:42px;height:42px;font-size:19px;">
                            <i class="bi bi-toggle-on"></i>
                        </div>

                        <div>
                            <div class="status-title">Active Announcement</div>
                            <p class="status-description">
                                Enable or disable this announcement.
                            </p>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-0">
                        <input asp-for="IsActive"
                               class="form-check-input"
                               role="switch" />
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-update">
                        <i class="bi bi-check2-circle me-1"></i>
                        Update Announcement
                    </button>

                    <a asp-action="Announcements" class="btn btn-cancel">
                        <i class="bi bi-x-circle me-1"></i>
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
```