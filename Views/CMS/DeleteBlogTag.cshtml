@model CMSPanel.Models.BlogTag

@{
    ViewData["Title"] = "Delete Blog Tag";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="fw-bold text-danger">Delete Blog Tag</h1>
        <p class="text-muted">Confirm tag deletion</p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Are you sure you want to delete this blog tag?
            </div>

            <div class="row mb-4">

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold text-muted">
                        Tag Name
                    </label>

                    <div class="fs-5">
                        @Model.Name
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold text-muted">
                        Slug
                    </label>

                    <div class="fs-5">
                        @Model.Slug
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="fw-semibold text-muted">
                        Status
                    </label>

                    <div>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        }
                    </div>
                </div>

            </div>

            <form asp-action="DeleteBlogTag"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger me-2">
                    <i class="bi bi-trash me-1"></i>
                    Yes, Delete
                </button>

                <a asp-action="BlogTags"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>
