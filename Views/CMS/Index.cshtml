@{
    ViewData["Title"] = "Dashboard";

    var totalUsers = Convert.ToInt32(ViewBag.TotalUsers);
    var totalRoles = Convert.ToInt32(ViewBag.TotalRoles);

    var totalPages = Convert.ToInt32(ViewBag.TotalPages);
    var publishedPages = Convert.ToInt32(ViewBag.PublishedPages);
    var draftPages = Convert.ToInt32(ViewBag.DraftPages);
    var archivedPages = Convert.ToInt32(ViewBag.ArchivedPages);

    var totalBlogs = Convert.ToInt32(ViewBag.TotalBlogs);
    var publishedBlogs = Convert.ToInt32(ViewBag.PublishedBlogs);
    var draftBlogs = Convert.ToInt32(ViewBag.DraftBlogs);

    var totalProjects = Convert.ToInt32(ViewBag.TotalProjects);
    var publishedProjects = Convert.ToInt32(ViewBag.PublishedProjects);

    var totalGallery = Convert.ToInt32(ViewBag.TotalGallery);
    var activeGallery = Convert.ToInt32(ViewBag.ActiveGallery);

    var totalMedia = Convert.ToInt32(ViewBag.TotalMedia);
    var activeMedia = Convert.ToInt32(ViewBag.ActiveMedia);

    var pendingApprovals =
    Convert.ToInt32(ViewBag.PendingApprovals ?? 0);

    var unreadNotifications =
        Convert.ToInt32(ViewBag.UnreadNotifications ?? 0);

    var recentActivities =
        ViewBag.RecentActivities as List<CMSPanel.Models.AuditLog>
        ?? new List<CMSPanel.Models.AuditLog>();

    var pagePercent = totalPages > 0
        ? Math.Min(100, (int)Math.Round((double)publishedPages / totalPages * 100))
        : 0;

    var blogPercent = totalBlogs > 0
        ? Math.Min(100, (int)Math.Round((double)publishedBlogs / totalBlogs * 100))
        : 0;
}

<style>
    .dashboard-page {
        color: #172033;
    }

    .dashboard-heading {
        margin-bottom: 26px;
    }

    .dashboard-eyebrow {
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .dashboard-heading h1 {
        font-size: 30px;
        font-weight: 750;
        letter-spacing: -0.7px;
        margin-bottom: 7px;
    }

    .dashboard-subtitle {
        color: #64748b;
        margin-bottom: 0;
    }

    .dashboard-date {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 11px 15px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #ffffff;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
    }

    .dashboard-welcome {
        position: relative;
        overflow: hidden;
        padding: 28px;
        margin-bottom: 26px;
        border-radius: 16px;
        color: #ffffff;
        background: linear-gradient(115deg, #172554 0%, #1d4ed8 65%, #2563eb 100%);
    }

        .dashboard-welcome h2 {
            font-size: 23px;
            font-weight: 700;
            margin-bottom: 9px;
        }

        .dashboard-welcome p {
            color: #dbeafe;
            font-size: 14px;
            max-width: 560px;
            margin-bottom: 0;
            line-height: 1.7;
        }

    .welcome-icon {
        width: 76px;
        height: 76px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.13);
        color: #ffffff;
        font-size: 38px;
    }

    .dashboard-stat {
        height: 100%;
        min-height: 158px;
        padding: 21px;
        border-radius: 14px;
        background: #ffffff;
        border: 1px solid #e8edf4;
        box-shadow: 0 3px 12px rgba(15,23,42,0.035);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .dashboard-stat:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(15,23,42,0.07);
        }

    .stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 20px;
    }

    .stat-label {
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
    }

    .stat-icon {
        width: 43px;
        height: 43px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }

    .icon-blue {
        background: #eff6ff;
        color: #2563eb;
    }

    .icon-green {
        background: #ecfdf5;
        color: #059669;
    }

    .icon-purple {
        background: #f5f3ff;
        color: #7c3aed;
    }

    .icon-orange {
        background: #fff7ed;
        color: #ea580c;
    }

    .icon-teal {
        background: #f0fdfa;
        color: #0d9488;
    }

    .icon-pink {
        background: #fdf2f8;
        color: #db2777;
    }

    .stat-value {
        font-size: 29px;
        line-height: 1.1;
        font-weight: 750;
        letter-spacing: -0.7px;
        margin-bottom: 9px;
        color: #172033;
    }

    .stat-description {
        color: #64748b;
        font-size: 12px;
        margin: 0;
    }

    .dashboard-panel {
        background: #ffffff;
        border: 1px solid #e8edf4;
        border-radius: 14px;
        padding: 23px;
        height: 100%;
        box-shadow: 0 3px 12px rgba(15,23,42,0.025);
    }

    .panel-title {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 5px;
        color: #172033;
    }

    .panel-description {
        color: #64748b;
        font-size: 12px;
        margin-bottom: 24px;
    }

    .content-metric {
        margin-bottom: 24px;
    }

        .content-metric:last-child {
            margin-bottom: 0;
        }

    .metric-label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 9px;
        font-size: 13px;
    }

    .metric-label {
        color: #475569;
        font-weight: 600;
    }

    .metric-value {
        color: #172033;
        font-weight: 700;
    }

    .dashboard-page .progress {
        height: 7px;
        background: #edf1f7;
        border-radius: 20px;
    }

    .dashboard-page .progress-bar {
        border-radius: 20px;
    }

    .module-row {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 14px 0;
        border-bottom: 1px solid #eef2f7;
    }

        .module-row:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

    .module-icon {
        height: 42px;
        width: 42px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        color: #334155;
        font-size: 20px;
        flex-shrink: 0;
    }

    .module-name {
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .module-info {
        color: #64748b;
        font-size: 12px;
        margin: 0;
    }

    .module-total {
        margin-left: auto;
        font-size: 19px;
        font-weight: 750;
    }

    .quick-action {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 14px;
        color: #334155;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .quick-action:hover {
            color: #1d4ed8;
            border-color: #93c5fd;
            background: #f8fbff;
        }

        .quick-action i {
            font-size: 18px;
        }

        .quick-action .action-arrow {
            margin-left: auto;
            color: #94a3b8;
        }

    .dashboard-footer {
        text-align: center;
        color: #94a3b8;
        font-size: 12px;
        padding: 24px 0 5px;
    }

    @@media (max-width: 768px) {
        .dashboard-heading h1 {
            font-size: 25px;
        }

        .dashboard-welcome {
            padding: 22px;
        }

            .dashboard-welcome h2 {
                font-size: 20px;
            }

        .dashboard-panel {
            padding: 18px;
        }
    }
</style>

<div class="dashboard-page">

    <!-- Header -->
    <div class="dashboard-heading d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="dashboard-eyebrow">CMS Administration</div>
            <h1>Dashboard Overview</h1>
            <p class="dashboard-subtitle">
                Manage your website content and monitor your CMS activity.
            </p>
        </div>

        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.ToString("dd MMM yyyy")
        </div>
    </div>

    <!-- Welcome Banner -->
    <div class="dashboard-welcome">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-4">
            <div>
                <h2>Welcome to your CMS Panel</h2>
                <p>
                    Your central workspace for managing pages, blogs, projects,
                    media and website content—all in one place.
                </p>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a asp-controller="CMS"
                       asp-action="Pages"
                       class="btn btn-light btn-sm fw-semibold px-3 py-2">
                        <i class="bi bi-file-earmark-text me-1"></i>
                        Manage Pages
                    </a>

                    <a asp-controller="CMS"
                       asp-action="Blogs"
                       class="btn btn-outline-light btn-sm px-3 py-2">
                        <i class="bi bi-journal-text me-1"></i>
                        Manage Blogs
                    </a>
                </div>
            </div>

            <div class="welcome-icon">
                <i class="bi bi-speedometer2"></i>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="dashboard-stat">
                <div class="stat-top">
                    <span class="stat-label">Total Users</span>
                    <div class="stat-icon icon-blue">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div class="stat-value">@totalUsers</div>
                <p class="stat-description">
                    <i class="bi bi-shield-check me-1"></i>
                    @totalRoles roles configured
                </p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="dashboard-stat">
                <div class="stat-top">
                    <span class="stat-label">Website Pages</span>
                    <div class="stat-icon icon-green">
                        <i class="bi bi-file-earmark-text-fill"></i>
                    </div>
                </div>
                <div class="stat-value">@totalPages</div>
                <p class="stat-description">
                    @publishedPages published · @draftPages drafts
                </p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="dashboard-stat">
                <div class="stat-top">
                    <span class="stat-label">Total Blogs</span>
                    <div class="stat-icon icon-purple">
                        <i class="bi bi-journal-text"></i>
                    </div>
                </div>
                <div class="stat-value">@totalBlogs</div>
                <p class="stat-description">
                    @publishedBlogs published · @draftBlogs drafts
                </p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="dashboard-stat">
                <div class="stat-top">
                    <span class="stat-label">Total Projects</span>
                    <div class="stat-icon icon-orange">
                        <i class="bi bi-kanban-fill"></i>
                    </div>
                </div>
                <div class="stat-value">@totalProjects</div>
                <p class="stat-description">
                    @publishedProjects published projects
                </p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="dashboard-stat">
                <div class="stat-top">
                    <span class="stat-label">Gallery Items</span>
                    <div class="stat-icon icon-pink">
                        <i class="bi bi-images"></i>
                    </div>
                </div>
                <div class="stat-value">@totalGallery</div>
                <p class="stat-description">
                    @activeGallery active gallery items
                </p>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="dashboard-stat">
                <div class="stat-top">
                    <span class="stat-label">Media Library</span>
                    <div class="stat-icon icon-teal">
                        <i class="bi bi-folder2-open"></i>
                    </div>
                </div>
                <div class="stat-value">@totalMedia</div>
                <p class="stat-description">
                    @activeMedia active media items
                </p>
            </div>
        </div>

    </div>

    <!-- Content Statistics -->
    <div class="row g-4 mb-4">

        <div class="col-12 col-lg-6">
            <div class="dashboard-panel">
                <h5 class="panel-title">Pages Overview</h5>
                <p class="panel-description">
                    Current publishing status of website pages
                </p>

                <div class="content-metric">
                    <div class="metric-label-row">
                        <span class="metric-label">Published Pages</span>
                        <span class="metric-value">@publishedPages / @totalPages</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width: @(pagePercent)%"
                             aria-valuenow="@pagePercent"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        @pagePercent% of all pages are published
                    </small>
                </div>

                <div class="content-metric">
                    <div class="metric-label-row">
                        <span class="metric-label">Draft Pages</span>
                        <span class="metric-value">@draftPages</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar bg-warning"
                             role="progressbar"
                             style="width: @(totalPages > 0 ? Math.Min(100, (int)Math.Round((double)draftPages / totalPages * 100)) : 0)%">
                        </div>
                    </div>
                </div>

                <div class="content-metric">
                    <div class="metric-label-row">
                        <span class="metric-label">Archived Pages</span>
                        <span class="metric-value">@archivedPages</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar bg-secondary"
                             role="progressbar"
                             style="width: @(totalPages > 0 ? Math.Min(100, (int)Math.Round((double)archivedPages / totalPages * 100)) : 0)%">
                        </div>
                    </div>
                </div>

                <a asp-controller="CMS"
                   asp-action="Pages"
                   class="btn btn-outline-primary btn-sm mt-4">
                    View All Pages <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="dashboard-panel">
                <h5 class="panel-title">Blogs Overview</h5>
                <p class="panel-description">
                    Publishing status of your blog content
                </p>

                <div class="content-metric">
                    <div class="metric-label-row">
                        <span class="metric-label">Published Blogs</span>
                        <span class="metric-value">@publishedBlogs / @totalBlogs</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width: @(blogPercent)%"
                             aria-valuenow="@blogPercent"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        @blogPercent% of all blogs are published
                    </small>
                </div>

                <div class="content-metric">
                    <div class="metric-label-row">
                        <span class="metric-label">Draft Blogs</span>
                        <span class="metric-value">@draftBlogs</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar bg-warning"
                             role="progressbar"
                             style="width: @(totalBlogs > 0 ? Math.Min(100, (int)Math.Round((double)draftBlogs / totalBlogs * 100)) : 0)%">
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a asp-controller="CMS"
                       asp-action="Blogs"
                       class="btn btn-outline-primary btn-sm">
                        Manage Blogs <i class="bi bi-arrow-right ms-1"></i>
                    </a>

                    <a asp-controller="CMS"
                       asp-action="BlogCategories"
                       class="btn btn-light border btn-sm">
                        Categories
                    </a>

                    <a asp-controller="CMS"
                       asp-action="BlogTags"
                       class="btn btn-light border btn-sm">
                        Blog Tags
                    </a>
                </div>
            </div>
        </div>

    </div>


    <!-- Pending Review, System Alerts and Recent Activities -->
    <div class="row g-4 mb-4">

        <!-- Pending Content Review -->
        <div class="col-12 col-md-6 col-xl-3">
            <div class="dashboard-stat">
                <div class="stat-top">
                    <span class="stat-label">Content Awaiting Review</span>
                    <div class="stat-icon icon-orange">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>

                <div class="stat-value">@pendingApprovals</div>

                <p class="stat-description">
                    Draft pages, blogs and projects
                </p>

                <a asp-controller="CMS"
                   asp-action="Pages"
                   class="btn btn-outline-primary btn-sm mt-3">
                    Review Content
                    <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <!-- System Alerts -->
        <div class="col-12 col-md-6 col-xl-3">
            <div class="dashboard-stat">
                <div class="stat-top">
                    <span class="stat-label">System Alerts</span>
                    <div class="stat-icon icon-pink">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                </div>

                <div class="stat-value">@unreadNotifications</div>

                <p class="stat-description">
                    Unread notifications
                </p>

                <a asp-controller="CMS"
                   asp-action="Notifications"
                   class="btn btn-outline-primary btn-sm mt-3">
                    View Notifications
                    <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <!-- Recent Activities -->
        <div class="col-12 col-xl-6">
            <div class="dashboard-panel">

                <h5 class="panel-title">Recent Activities</h5>

                <p class="panel-description">
                    Latest recorded actions in the CMS
                </p>

                @if (recentActivities.Count > 0)
                {
                    foreach (var activity in recentActivities)
                    {
                        <div class="module-row">

                            <div class="module-icon">
                                <i class="bi bi-clock-history"></i>
                            </div>

                            <div class="flex-grow-1">
                                <div class="module-name">
                                    @activity.Action — @activity.Module
                                </div>

                                <p class="module-info">
                                    @(activity.UserName ?? "System")
                                    ·
                                    @activity.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                </p>
                            </div>

                            <span class="badge @(activity.Result == "Success" ? "bg-success" : "bg-secondary")">
                                @(activity.Result ?? "Logged")
                            </span>

                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-clock-history fs-2 text-muted"></i>
                        <p class="text-muted mt-2 mb-0">
                            No recent activities recorded.
                        </p>
                    </div>
                }

                <a asp-controller="CMS"
                   asp-action="AuditLogs"
                   class="btn btn-outline-primary btn-sm mt-3">
                    View All Audit Logs
                    <i class="bi bi-arrow-right ms-1"></i>
                </a>

            </div>
        </div>

    </div>

    <!-- Modules and Quick Actions -->
    <div class="row g-4">

        <div class="col-12 col-lg-6">
            <div class="dashboard-panel">
                <h5 class="panel-title">Module Overview</h5>
                <p class="panel-description">
                    Quick summary of your content modules
                </p>

                <div class="module-row">
                    <div class="module-icon">
                        <i class="bi bi-kanban"></i>
                    </div>
                    <div>
                        <div class="module-name">Projects</div>
                        <p class="module-info">
                            @publishedProjects published
                        </p>
                    </div>
                    <div class="module-total">@totalProjects</div>
                </div>

                <div class="module-row">
                    <div class="module-icon">
                        <i class="bi bi-images"></i>
                    </div>
                    <div>
                        <div class="module-name">Gallery</div>
                        <p class="module-info">
                            @activeGallery active items
                        </p>
                    </div>
                    <div class="module-total">@totalGallery</div>
                </div>

                <div class="module-row">
                    <div class="module-icon">
                        <i class="bi bi-folder2-open"></i>
                    </div>
                    <div>
                        <div class="module-name">Media Library</div>
                        <p class="module-info">
                            @activeMedia active items
                        </p>
                    </div>
                    <div class="module-total">@totalMedia</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="dashboard-panel">
                <h5 class="panel-title">Quick Actions</h5>
                <p class="panel-description">
                    Shortcuts to frequently used CMS sections
                </p>

                <div class="d-grid gap-2">

                    <a asp-controller="CMS"
                       asp-action="Pages"
                       class="quick-action">
                        <i class="bi bi-file-earmark-plus text-primary"></i>
                        <span>Manage Website Pages</span>
                        <i class="bi bi-arrow-up-right action-arrow"></i>
                    </a>

                    <a asp-controller="CMS"
                       asp-action="Blogs"
                       class="quick-action">
                        <i class="bi bi-journal-plus text-success"></i>
                        <span>Manage Blog Posts</span>
                        <i class="bi bi-arrow-up-right action-arrow"></i>
                    </a>

                    <a asp-controller="CMS"
                       asp-action="Projects"
                       class="quick-action">
                        <i class="bi bi-kanban text-warning"></i>
                        <span>Manage Projects</span>
                        <i class="bi bi-arrow-up-right action-arrow"></i>
                    </a>

                    <a asp-controller="CMS"
                       asp-action="Media"
                       class="quick-action">
                        <i class="bi bi-folder2-open text-info"></i>
                        <span>Open Media Library</span>
                        <i class="bi bi-arrow-up-right action-arrow"></i>
                    </a>

                </div>
            </div>
        </div>

    </div>

    <div class="dashboard-footer">
        CMS Panel &middot; Administration Dashboard
    </div>

</div>