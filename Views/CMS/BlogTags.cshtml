@model IEnumerable<CMSPanel.Models.BlogTag>

@{
    ViewData["Title"] = "Blog Tags";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Blog Tags</h1>
            <p class="text-muted mb-0">Manage blog tags</p>
        </div>

        <a asp-action="CreateBlogTag" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Create Tag
        </a>
    </div>

    <!-- Search -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-action="BlogTags" method="get">
                <div class="row g-2">

                    <div class="col-md-10">
                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Search by tag name or slug..." />
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search me-1"></i>
                            Search
                        </button>
                    </div>

                </div>
            </form>

        </div>
    </div>

    <!-- Tags Table -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Slug</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int count = 1;

                            foreach (var tag in Model)
                            {
                                <tr>

                                    <td>@count</td>

                                    <td>
                                        <strong>@tag.Name</strong>
                                    </td>

                                    <td>
                                        <span class="text-muted">
                                            @tag.Slug
                                        </span>
                                    </td>

                                    <td>
                                        @if (tag.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @tag.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-end">

                                        <a asp-action="BlogTagDetails"
                                           asp-route-id="@tag.Id"
                                           class="btn btn-sm btn-outline-info me-1"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="EditBlogTag"
                                           asp-route-id="@tag.Id"
                                           class="btn btn-sm btn-outline-primary me-1"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>


                                        <form asp-action="DeleteBlogTag"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this blog tag?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@tag.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>


                                    </td>

                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    No blog tags found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
