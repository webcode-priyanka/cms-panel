@model CMSPanel.Models.Service

@{
    ViewData["Title"] = "Edit Service";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Edit Service</h1>
            <p class="text-muted mb-0">Update service information</p>
        </div>

        <a asp-controller="CMS"
           asp-action="Services"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Services
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="CMS"
                  asp-action="EditService"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <!-- TITLE -->
                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label">
                            Service Title
                        </label>
                        <input asp-for="Title" class="form-control"
                               placeholder="Enter service title" />
                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                    <!-- SLUG -->
                    <div class="col-md-6">
                        <label asp-for="Slug" class="form-label">
                            Slug
                        </label>
                        <input asp-for="Slug" class="form-control"
                               placeholder="Enter service slug" />
                        <span asp-validation-for="Slug"
                              class="text-danger"></span>
                    </div>

                    <!-- SHORT DESCRIPTION -->
                    <div class="col-md-12">
                        <label asp-for="ShortDescription"
                               class="form-label">
                            Short Description
                        </label>
                        <textarea asp-for="ShortDescription"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter short description"></textarea>
                        <span asp-validation-for="ShortDescription"
                              class="text-danger"></span>
                    </div>

                    <!-- DESCRIPTION -->
                    <div class="col-md-12">
                        <label asp-for="Description"
                               class="form-label">
                            Description
                        </label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Enter full description"></textarea>
                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <!-- ICON -->
                    <div class="col-md-6">
                        <label asp-for="Icon" class="form-label">
                            Icon
                        </label>
                        <input asp-for="Icon" class="form-control"
                               placeholder="Example: bi bi-gear" />
                        <span asp-validation-for="Icon"
                              class="text-danger"></span>
                    </div>

                    <!-- IMAGE URL -->
                    <div class="col-md-6">
                        <label asp-for="ImageUrl" class="form-label">
                            Image URL
                        </label>
                        <input asp-for="ImageUrl" class="form-control"
                               placeholder="Enter image URL" />
                        <span asp-validation-for="ImageUrl"
                              class="text-danger"></span>
                    </div>

                    <!-- DISPLAY ORDER -->
                    <div class="col-md-6">
                        <label asp-for="DisplayOrder"
                               class="form-label">
                            Display Order
                        </label>
                        <input asp-for="DisplayOrder"
                               type="number"
                               class="form-control" />
                        <span asp-validation-for="DisplayOrder"
                              class="text-danger"></span>
                    </div>

                    <!-- STATUS -->
                    <div class="col-md-6">
                        <label asp-for="IsActive"
                               class="form-label">
                            Status
                        </label>
                        <select asp-for="IsActive" class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                        <span asp-validation-for="IsActive"
                              class="text-danger"></span>
                    </div>

                    <!-- META TITLE -->
                    <div class="col-md-12">
                        <label asp-for="MetaTitle"
                               class="form-label">
                            Meta Title
                        </label>
                        <input asp-for="MetaTitle" class="form-control"
                               placeholder="Enter meta title" />
                        <span asp-validation-for="MetaTitle"
                              class="text-danger"></span>
                    </div>

                    <!-- META DESCRIPTION -->
                    <div class="col-md-12">
                        <label asp-for="MetaDescription"
                               class="form-label">
                            Meta Description
                        </label>
                        <textarea asp-for="MetaDescription"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter meta description"></textarea>
                        <span asp-validation-for="MetaDescription"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Update Service
                    </button>

                    <a asp-controller="CMS"
                       asp-action="Services"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
