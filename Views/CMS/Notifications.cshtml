@model IEnumerable<CMSPanel.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Notifications</h1>
            <p class="text-muted mb-0">
                Manage system notifications
            </p>
        </div>

        <a asp-action="CreateNotification"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>
            Add Notification

        </a>
    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-1"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Search & Filters -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Notifications"
                  method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Search
                        </label>

                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Search title or message..." />

                    </div>


                    <!-- Type -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Type
                        </label>

                        <select name="type"
                                class="form-select">

                            <option value="">
                                All Types
                            </option>

                            @if (ViewBag.Type == "Info")
                            {
                                <option value="Info" selected>
                                    Info
                                </option>
                            }
                            else
                            {
                                <option value="Info">
                                    Info
                                </option>
                            }

                            @if (ViewBag.Type == "Success")
                            {
                                <option value="Success" selected>
                                    Success
                                </option>
                            }
                            else
                            {
                                <option value="Success">
                                    Success
                                </option>
                            }

                            @if (ViewBag.Type == "Warning")
                            {
                                <option value="Warning" selected>
                                    Warning
                                </option>
                            }
                            else
                            {
                                <option value="Warning">
                                    Warning
                                </option>
                            }

                            @if (ViewBag.Type == "Error")
                            {
                                <option value="Error" selected>
                                    Error
                                </option>
                            }
                            else
                            {
                                <option value="Error">
                                    Error
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Status -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All Status
                            </option>

                            @if (ViewBag.Status == "Unread")
                            {
                                <option value="Unread" selected>
                                    Unread
                                </option>
                            }
                            else
                            {
                                <option value="Unread">
                                    Unread
                                </option>
                            }

                            @if (ViewBag.Status == "Read")
                            {
                                <option value="Read" selected>
                                    Read
                                </option>
                            }
                            else
                            {
                                <option value="Read">
                                    Read
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Buttons -->
                    <div class="col-md-2 d-flex align-items-end gap-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search"></i>
                            Filter

                        </button>

                        <a asp-action="Notifications"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-clockwise"></i>

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Notifications Table -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>
                            <th>Title</th>
                            <th>Message</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.Id
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @item.Title
                                        </span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Message))
                                        {
                                            if (item.Message.Length > 80)
                                            {
                                                @item.Message.Substring(0, 80)

                                                <span>...</span>
                                            }
                                            else
                                            {
                                                @item.Message
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }
                                    </td>


                                    <!-- Type -->
                                    <td>

                                        @if (item.Type == "Info")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Info
                                            </span>
                                        }
                                        else if (item.Type == "Success")
                                        {
                                            <span class="badge bg-success">
                                                Success
                                            </span>
                                        }
                                        else if (item.Type == "Warning")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Warning
                                            </span>
                                        }
                                        else if (item.Type == "Error")
                                        {
                                            <span class="badge bg-danger">
                                                Error
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Type
                                            </span>
                                        }

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (item.Status == "Unread")
                                        {
                                            <span class="badge bg-primary">
                                                Unread
                                            </span>
                                        }
                                        else if (item.Status == "Read")
                                        {
                                            <span class="badge bg-secondary">
                                                Read
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        @item.CreatedAt.ToString("dd MMM yyyy hh:mm tt")
                                    </td>


                                    <!-- Actions -->
                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-2">

                                            <!-- View -->
                                            <a asp-action="NotificationDetails"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="View">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- Edit -->
                                            <a asp-action="EditNotification"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            
                                            <!-- Delete -->
                                            <form asp-action="DeleteNotification"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this notification?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>
                                            
                                           
                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-bell-slash fs-1 d-block mb-2"></i>

                                        <h5>
                                            No notifications found
                                        </h5>

                                        <p class="mb-0">
                                            There are no notifications matching your filters.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
