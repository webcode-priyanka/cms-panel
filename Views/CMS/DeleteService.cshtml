@model CMSPanel.Models.Service

@{
    ViewData["Title"] = "Delete Service";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Delete Service</h1>
            <p class="text-muted mb-0">
                Confirm before deleting this service
            </p>
        </div>

        <a asp-controller="CMS"
           asp-action="Services"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Services
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Are you sure you want to delete this service?
                This action cannot be undone.
            </div>

            <h4 class="fw-bold mb-4">@Model.Title</h4>

            <div class="row g-3">

                <div class="col-md-6">
                    <strong>Title</strong>
                    <p>@Model.Title</p>
                </div>

                <div class="col-md-6">
                    <strong>Slug</strong>
                    <p>@Model.Slug</p>
                </div>

                <div class="col-md-12">
                    <strong>Short Description</strong>
                    <p>@Model.ShortDescription</p>
                </div>

                <div class="col-md-12">
                    <strong>Description</strong>
                    <p>@Model.Description</p>
                </div>

                <div class="col-md-6">
                    <strong>Icon</strong>
                    <p>@Model.Icon</p>
                </div>

                <div class="col-md-6">
                    <strong>Display Order</strong>
                    <p>@Model.DisplayOrder</p>
                </div>

                <div class="col-md-6">
                    <strong>Status</strong>
                    <p>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </p>
                </div>

                <div class="col-md-6">
                    <strong>Created At</strong>
                    <p>@Model.CreatedAt.ToString("dd MMM yyyy")</p>
                </div>

            </div>

            <form asp-controller="CMS"
                  asp-action="DeleteService"
                  method="post"
                  class="mt-4">

                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.Id" />

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete Service
                </button>

                <a asp-controller="CMS"
                   asp-action="Services"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>
