@model CMSPanel.Models.AuditLog

@{
    ViewData["Title"] = "Delete Audit Log";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-danger">
                Delete Audit Log
            </h1>

            <p class="text-muted mb-0">
                Confirm audit log deletion
            </p>
        </div>

        <a asp-action="AuditLogs"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Are you sure you want to delete this audit log?
                This action cannot be undone.
            </div>

            <div class="row g-4">

                <div class="col-md-8">

                    <div class="mb-3">
                        <label class="fw-semibold text-muted">
                            User
                        </label>

                        <div class="fs-5">
                            @if (!string.IsNullOrWhiteSpace(Model.UserName))
                            {
                                @Model.UserName
                            }
                            else
                            {
                                <span class="text-muted">
                                    System
                                </span>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-semibold text-muted">
                            Action
                        </label>

                        <div>
                            <span class="badge bg-primary">
                                @Model.Action
                            </span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-semibold text-muted">
                            Module
                        </label>

                        <div>
                            <span class="badge bg-dark">
                                @Model.Module
                            </span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-semibold text-muted">
                            Resource
                        </label>

                        <div>
                            @(string.IsNullOrWhiteSpace(Model.Resource)
                                ? "-"
                                : Model.Resource)
                        </div>
                    </div>

                </div>

                <div class="col-md-4">

                    <div class="mb-3">
                        <label class="fw-semibold text-muted">
                            Result
                        </label>

                        <div>
                            @if (Model.Result == "Success")
                            {
                                <span class="badge bg-success">
                                    Success
                                </span>
                            }
                            else if (Model.Result == "Failed")
                            {
                                <span class="badge bg-danger">
                                    Failed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @(string.IsNullOrWhiteSpace(Model.Result)
                                        ? "-"
                                        : Model.Result)
                                </span>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-semibold text-muted">
                            IP Address
                        </label>

                        <div>
                            @(string.IsNullOrWhiteSpace(Model.IpAddress)
                                ? "-"
                                : Model.IpAddress)
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-semibold text-muted">
                            Created At
                        </label>

                        <div>
                            @Model.CreatedAt.ToString(
                                     "dd MMM yyyy, hh:mm tt")
                        </div>
                    </div>

                </div>

            </div>

            <hr />

            <form asp-action="DeleteAuditLog"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                @Html.AntiForgeryToken()

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger">
                        <i class="bi bi-trash"></i>
                        Yes, Delete
                    </button>

                    <a asp-action="AuditLogs"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
