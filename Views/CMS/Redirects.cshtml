@model IEnumerable<CMSPanel.Models.Redirect>

@{
    ViewData["Title"] = "Redirects";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">Redirects</h1>

            <p class="text-muted mb-0">
                Manage website URL redirects.
            </p>
        </div>

        <a asp-controller="CMS"
           asp-action="CreateRedirect"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Add Redirect

        </a>

    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Search & Filter -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-controller="CMS"
                  asp-action="Redirects"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- Search -->
                    <div class="col-md-5">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Search source or destination URL..." />

                    </div>


                    <!-- Redirect Type -->
                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            Redirect Type
                        </label>

                        <select name="redirectType"
                                class="form-select">

                            @if (string.IsNullOrWhiteSpace(ViewBag.RedirectType))
                            {
                                <option value="" selected>
                                    All Types
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All Types
                                </option>
                            }

                            @if (ViewBag.RedirectType == "301")
                            {
                                <option value="301" selected>
                                    301 - Permanent
                                </option>
                            }
                            else
                            {
                                <option value="301">
                                    301 - Permanent
                                </option>
                            }

                            @if (ViewBag.RedirectType == "302")
                            {
                                <option value="302" selected>
                                    302 - Temporary
                                </option>
                            }
                            else
                            {
                                <option value="302">
                                    302 - Temporary
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Status -->
                    <div class="col-md-2">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            @if (string.IsNullOrWhiteSpace(ViewBag.Status))
                            {
                                <option value="" selected>
                                    All Status
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All Status
                                </option>
                            }

                            @if (ViewBag.Status == "Active")
                            {
                                <option value="Active" selected>
                                    Active
                                </option>
                            }
                            else
                            {
                                <option value="Active">
                                    Active
                                </option>
                            }

                            @if (ViewBag.Status == "Inactive")
                            {
                                <option value="Inactive" selected>
                                    Inactive
                                </option>
                            }
                            else
                            {
                                <option value="Inactive">
                                    Inactive
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Search -->
                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search me-1"></i>
                            Search

                        </button>

                    </div>


                    <!-- Reset -->
                    <div class="col-md-1">

                        <a asp-controller="CMS"
                           asp-action="Redirects"
                           class="btn btn-outline-secondary w-100"
                           title="Reset">

                            <i class="bi bi-arrow-clockwise"></i>

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Redirect Table -->
    <div class="card shadow-sm border-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>#</th>

                        <th>Source URL</th>

                        <th>Destination URL</th>

                        <th>Type</th>

                        <th>Status</th>

                        <th>Updated</th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        var count = 1;

                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Number -->
                                <td>
                                    @count
                                </td>


                                <!-- Source URL -->
                                <td>

                                    <div class="fw-semibold">
                                        @item.SourceUrl
                                    </div>

                                </td>


                                <!-- Destination URL -->
                                <td>

                                    <div>
                                        @item.DestinationUrl
                                    </div>

                                </td>


                                <!-- Redirect Type -->
                                <td>

                                    @if (item.RedirectType == "301")
                                    {
                                        <span class="badge bg-primary">
                                            301 Permanent
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            302 Temporary
                                        </span>
                                    }

                                </td>


                                <!-- Status -->
                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }

                                </td>


                                <!-- Updated -->
                                <td>

                                    @if (item.UpdatedAt.HasValue)
                                    {
                                        <div class="fw-semibold">
                                            @item.UpdatedAt.Value.ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted">
                                            @item.UpdatedAt.Value.ToString("hh:mm tt")
                                        </small>
                                    }
                                    else
                                    {
                                        <div class="fw-semibold">
                                            @item.CreatedAt.ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted">
                                            Created
                                        </small>
                                    }

                                </td>


                                <!-- Actions -->
                                <td>

                                    <div class="d-flex justify-content-end gap-2">

                                        <!-- View -->
                                        <a asp-controller="CMS"
                                           asp-action="RedirectDetails"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- Edit -->
                                        <a asp-controller="CMS"
                                           asp-action="EditRedirect"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- Delete -->
                                        <a asp-controller="CMS"
                                           asp-action="DeleteRedirect"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                            count++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center py-5">

                                <i class="bi bi-arrow-right-circle fs-1 text-muted"></i>

                                <h5 class="mt-3">
                                    No redirects found
                                </h5>

                                <p class="text-muted mb-0">
                                    Create your first redirect.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
