@model CMSPanel.Models.Media

@{
    ViewData["Title"] = "Delete Media";
}

<style>
    .delete-page {
        padding: 28px;
        background: #f5f7fb;
        min-height: calc(100vh - 70px);
    }

    .delete-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 25px;
    }

        .delete-header h1 {
            font-size: 27px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 6px;
        }

        .delete-header p {
            color: #64748b;
            margin: 0;
            font-size: 14px;
        }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 16px;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        background: #fff;
        color: #475569;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
    }

        .back-btn:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

    .delete-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.05);
        overflow: hidden;
    }

    .delete-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e2e8f0;
    }

        .delete-card-header h5 {
            color: #1e293b;
            font-size: 17px;
            font-weight: 700;
            margin: 0;
        }

    .delete-card-body {
        padding: 25px;
    }

    .warning-box {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 17px 19px;
        background: #fff1f2;
        border: 1px solid #fecdd3;
        border-radius: 11px;
        margin-bottom: 27px;
    }

    .warning-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffe4e6;
        color: #dc2626;
        border-radius: 10px;
        font-size: 20px;
    }

    .warning-box h6 {
        color: #9f1239;
        font-weight: 700;
        margin: 1px 0 5px;
    }

    .warning-box p {
        color: #9f1239;
        font-size: 13px;
        margin: 0;
        line-height: 1.6;
    }

    .preview-panel {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        height: 100%;
        text-align: center;
    }

    .preview-label {
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        margin-bottom: 17px;
    }

    .media-preview {
        width: 100%;
        height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
    }

        .media-preview img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 8px;
        }

    .media-preview-icon {
        width: 75px;
        height: 75px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #f1f5f9;
        font-size: 38px;
    }

    .preview-filename {
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        margin-top: 13px;
        word-break: break-word;
    }

    .info-title {
        font-size: 15px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 17px;
    }

    .info-item {
        padding: 13px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .info-item:last-child {
            border-bottom: none;
        }

    .info-label {
        display: block;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .info-value {
        color: #334155;
        font-size: 14px;
        font-weight: 600;
        word-break: break-word;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-type {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .badge-category {
        background: #f1f5f9;
        color: #475569;
    }

    .delete-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        padding: 20px 25px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    .footer-note {
        color: #64748b;
        font-size: 12px;
        margin: 0;
    }

    .footer-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn-cancel {
        padding: 10px 17px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #fff;
        color: #475569;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-cancel:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

    .btn-delete {
        padding: 10px 18px;
        border: 1px solid #dc2626;
        border-radius: 8px;
        background: #dc2626;
        color: #fff;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-delete:hover {
            background: #b91c1c;
            border-color: #b91c1c;
            color: #fff;
        }

    @@media (max-width: 767px) {
        .delete-page {
            padding: 16px;
        }

        .delete-card-body {
            padding: 18px;
        }

        .delete-header h1 {
            font-size: 23px;
        }

        .delete-footer {
            align-items: stretch;
        }

        .footer-actions {
            width: 100%;
        }

            .footer-actions form,
            .footer-actions button,
            .footer-actions a {
                flex: 1;
                text-align: center;
            }
    }
</style>

<div class="delete-page">

    <!-- Page Header -->
    <div class="delete-header">
        <div>
            <h1>
                <i class="bi bi-trash3 text-danger me-2"></i>
                Delete Media
            </h1>
            <p>Review the media information before confirming deletion.</p>
        </div>

        <a asp-action="Media" class="back-btn">
            <i class="bi bi-arrow-left"></i>
            Back to Media
        </a>
    </div>

    <!-- Main Card -->
    <div class="delete-card">

        <div class="delete-card-header">
            <h5>
                <i class="bi bi-file-earmark-image me-2 text-primary"></i>
                Media Information
            </h5>
        </div>

        <div class="delete-card-body">

            <!-- Warning -->
            <div class="warning-box">
                <div class="warning-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <div>
                    <h6>Are you sure you want to delete this media?</h6>
                    <p>
                        This action will permanently delete the media record
                        and its uploaded file. This action cannot be undone.
                    </p>
                </div>
            </div>

            <div class="row g-4">

                <!-- File Preview -->
                <div class="col-lg-4">
                    <div class="preview-panel">

                        <div class="preview-label">
                            <i class="bi bi-eye me-1"></i>
                            File Preview
                        </div>

                        <div class="media-preview">

                            @if (Model.FileType == "Image" &&
                            !string.IsNullOrWhiteSpace(Model.FileUrl))
                            {
                                <img src="@Model.FileUrl"
                                     alt="@Model.AltText"
                                     onerror="this.style.display='none'; document.getElementById('mediaFallback').style.display='flex';" />
                                <div id="mediaFallback"
                                     class="media-preview-icon text-secondary"
                                     style="display:none;">
                                    <i class="bi bi-file-earmark-image"></i>
                                </div>
                            }
                            else if (Model.FileType == "Document")
                            {
                                <div class="media-preview-icon text-danger">
                                    <i class="bi bi-file-earmark-text"></i>
                                </div>
                            }
                            else if (Model.FileType == "Video")
                            {
                                <div class="media-preview-icon text-primary">
                                    <i class="bi bi-play-circle"></i>
                                </div>
                            }
                            else if (Model.FileType == "Audio")
                            {
                                <div class="media-preview-icon text-success">
                                    <i class="bi bi-music-note-beamed"></i>
                                </div>
                            }
                            else
                            {
                                <div class="media-preview-icon text-secondary">
                                    <i class="bi bi-file-earmark"></i>
                                </div>
                            }

                        </div>

                        <div class="preview-filename">
                            @(string.IsNullOrWhiteSpace(Model.FileName)
                                ? "No file name"
                                : Model.FileName)
                        </div>

                    </div>
                </div>

                <!-- Media Details -->
                <div class="col-lg-8">

                    <h6 class="info-title">
                        <i class="bi bi-info-circle me-2 text-primary"></i>
                        Media Details
                    </h6>

                    <div class="info-item">
                        <span class="info-label">Title</span>
                        <div class="info-value fs-5">
                            @(string.IsNullOrWhiteSpace(Model.Title)
                                ? "Untitled Media"
                                : Model.Title)
                        </div>
                    </div>

                    <div class="info-item">
                        <span class="info-label">File Name</span>
                        <div class="info-value">
                            @(string.IsNullOrWhiteSpace(Model.FileName)
                                ? "-"
                                : Model.FileName)
                        </div>
                    </div>

                    <div class="info-item">
                        <span class="info-label">File Type</span>
                        <div>
                            @if (!string.IsNullOrWhiteSpace(Model.FileType))
                            {
                                <span class="status-badge badge-type">
                                    <i class="bi bi-file-earmark me-1"></i>
                                    @Model.FileType
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Category</span>
                        <div>
                            @if (!string.IsNullOrWhiteSpace(Model.Category))
                            {
                                <span class="status-badge badge-category">
                                    <i class="bi bi-folder me-1"></i>
                                    @Model.Category
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Created Date</span>
                        <div class="info-value">
                            <i class="bi bi-calendar3 me-1 text-muted"></i>
                            @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="delete-footer">

            <p class="footer-note">
                <i class="bi bi-shield-exclamation me-1"></i>
                Please confirm before deleting this media.
            </p>

            <div class="footer-actions">

                <a asp-action="Media" class="btn-cancel">
                    <i class="bi bi-x-lg me-1"></i>
                    Cancel
                </a>

                <form asp-action="DeleteMedia"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to permanently delete this media?');">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />

                    <button type="submit" class="btn-delete">
                        <i class="bi bi-trash3 me-1"></i>
                        Yes, Delete Media
                    </button>
                </form>

            </div>
        </div>

    </div>
</div>
