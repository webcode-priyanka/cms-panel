@model CMSPanel.Models.ProjectCategory

@{
    ViewData["Title"] = "Delete Project Category";
}

<style>
    .delete-page {
        padding: 25px;
    }

    .delete-header {
        margin-bottom: 25px;
    }

        .delete-header h2 {
            font-size: 27px;
            font-weight: 700;
            color: #dc3545;
            margin-bottom: 5px;
        }

        .delete-header p {
            color: #6c757d;
            margin-bottom: 0;
        }

    .delete-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        overflow: hidden;
    }

    .delete-card-header {
        padding: 20px 25px;
        background: #fff;
        border-bottom: 1px solid #edf0f2;
    }

        .delete-card-header h5 {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .delete-card-header p {
            color: #6c757d;
            font-size: 13px;
            margin-bottom: 0;
        }

    .delete-card-body {
        padding: 25px;
    }

    .warning-box {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 17px;
        border: 1px solid #f5c2c7;
        border-radius: 9px;
        background: #fff5f5;
        color: #842029;
        margin-bottom: 25px;
    }

        .warning-box i {
            font-size: 23px;
            margin-top: 2px;
        }

        .warning-box strong {
            display: block;
            font-size: 15px;
            margin-bottom: 4px;
        }

        .warning-box p {
            font-size: 13px;
            margin-bottom: 0;
        }

    .category-info {
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 22px;
        height: 100%;
    }

    .category-name {
        font-size: 21px;
        font-weight: 700;
        color: #212529;
        margin-bottom: 20px;
        overflow-wrap: anywhere;
    }

    .detail-item {
        margin-bottom: 20px;
    }

        .detail-item:last-child {
            margin-bottom: 0;
        }

    .detail-label {
        display: block;
        color: #6c757d;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: 6px;
    }

    .detail-value {
        color: #212529;
        font-size: 14px;
        overflow-wrap: anywhere;
    }

    .slug-value {
        color: #0d6efd;
    }

    .action-card {
        height: 100%;
        padding: 22px;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .delete-icon {
        width: 75px;
        height: 75px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fff0f0;
        color: #dc3545;
        font-size: 34px;
        margin-bottom: 18px;
    }

    .action-card h5 {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .action-card p {
        color: #6c757d;
        font-size: 13px;
        margin-bottom: 22px;
    }

    .action-card form {
        width: 100%;
    }

    .action-card .btn {
        width: 100%;
        padding: 10px 15px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

    .delete-btn {
        margin-bottom: 10px;
    }

    @@media (max-width: 576px) {
        .delete-page {
            padding: 15px;
        }

        .delete-card-body {
            padding: 18px;
        }

        .delete-header h2 {
            font-size: 23px;
        }

        .category-info,
        .action-card {
            padding: 18px;
        }
    }
</style>

<div class="container-fluid delete-page">

    <!-- Page Header -->
    <div class="delete-header">
        <h2>
            <i class="bi bi-trash3 me-2"></i>
            Delete Project Category
        </h2>
        <p>Review the category details before deleting.</p>
    </div>

    <!-- Main Card -->
    <div class="card delete-card">

        <div class="delete-card-header">
            <h5>
                <i class="bi bi-exclamation-circle text-danger me-2"></i>
                Category Deletion
            </h5>
            <p>Confirm whether you want to permanently delete this category.</p>
        </div>

        <div class="delete-card-body">

            <!-- Warning -->
            <div class="warning-box">
                <i class="bi bi-exclamation-triangle-fill"></i>

                <div>
                    <strong>Are you sure you want to delete this category?</strong>
                    <p>
                        This action cannot be undone. Please verify the
                        category details before continuing.
                    </p>
                </div>
            </div>

            <div class="row g-4">

                <!-- Category Information -->
                <div class="col-lg-8">

                    <div class="category-info">

                        <h4 class="category-name">
                            <i class="bi bi-folder2-open text-primary me-2"></i>
                            @(string.IsNullOrWhiteSpace(Model.Name)
                                ? "Untitled Category"
                                : Model.Name)
                        </h4>

                        <div class="row g-3">

                            <!-- Category Name -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <span class="detail-label">
                                        <i class="bi bi-tag me-1"></i>
                                        Category Name
                                    </span>

                                    <span class="detail-value">
                                        @Model.Name
                                    </span>
                                </div>
                            </div>

                            <!-- Slug -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <span class="detail-label">
                                        <i class="bi bi-link-45deg me-1"></i>
                                        Slug
                                    </span>

                                    <span class="detail-value slug-value">
                                        /@Model.Slug
                                    </span>
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="col-12">
                                <div class="detail-item">
                                    <span class="detail-label">
                                        <i class="bi bi-card-text me-1"></i>
                                        Description
                                    </span>

                                    <span class="detail-value">
                                        @(string.IsNullOrWhiteSpace(Model.Description)
                                            ? "No description"
                                            : Model.Description)
                                    </span>
                                </div>
                            </div>

                            <!-- Status -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <span class="detail-label">
                                        <i class="bi bi-toggle-on me-1"></i>
                                        Status
                                    </span>

                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-pause-circle me-1"></i>
                                            Inactive
                                        </span>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Delete Action -->
                <div class="col-lg-4">

                    <div class="action-card">

                        <div class="delete-icon">
                            <i class="bi bi-trash3"></i>
                        </div>

                        <h5>Delete this category?</h5>

                        <p>
                            This category will be permanently removed.
                            Make sure you selected the correct category.
                        </p>

                        <form asp-action="DeleteProjectCategory"
                              asp-route-id="@Model.Id"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to permanently delete this category?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="Id" />

                            <button type="submit"
                                    class="btn btn-danger delete-btn">
                                <i class="bi bi-trash me-1"></i>
                                Delete Category
                            </button>

                            <a asp-action="ProjectCategories"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>
                                Cancel
                            </a>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
