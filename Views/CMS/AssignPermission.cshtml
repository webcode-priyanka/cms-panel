@{
    ViewData["Title"] = "Assign Permission";

    var roles = ViewBag.Roles as List<Microsoft.AspNetCore.Identity.IdentityRole>;
    var permissions = ViewBag.Permissions as List<CMSPanel.Models.Permission>;
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Assign Permission</h1>
        <p class="text-muted">Assign permissions to a role</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-action="AssignPermission" method="post">

                <div class="mb-3">
                    <label class="form-label fw-semibold">Select Role</label>

                    <select name="roleId" class="form-select" required>
                        <option value="">-- Select Role --</option>

                        @if (roles != null)
                        {
                            foreach (var role in roles)
                            {
                                <option value="@role.Id">
                                    @role.Name
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Select Permission</label>

                    <select name="permissionId" class="form-select" required>
                        <option value="">-- Select Permission --</option>

                        @if (permissions != null)
                        {
                            foreach (var permission in permissions)
                            {
                                <option value="@permission.Id">
                                    @permission.Name
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="form-check mb-4">
                    <input type="checkbox"
                           name="isAllowed"
                           value="true"
                           class="form-check-input"
                           checked />

                    <label class="form-check-label">
                        Allow Permission
                    </label>
                </div>

                <button type="submit" class="btn btn-primary">
                    Assign Permission
                </button>

                <a asp-action="RolePermissions"
                   class="btn btn-secondary ms-2">
                    Back
                </a>

            </form>

        </div>
    </div>

</div>