@model IEnumerable<CMSPanel.Models.Announcement>

@{
    ViewData["Title"] = "Announcements";


    var announcements = Model?.ToList() ?? new List<CMSPanel.Models.Announcement>();
    var totalAnnouncements = announcements.Count;
    var activeAnnouncements = announcements.Count(x => x.IsActive);
    var inactiveAnnouncements = totalAnnouncements - activeAnnouncements;
    var upcomingAnnouncements = announcements.Count(x => x.StartDate.Date > DateTime.Today);

}

<div class="container-fluid px-3 px-lg-4 py-4 announcement-page">

    
@* Page Header *@
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="announcement-heading-icon">
                    <i class="bi bi-megaphone-fill"></i>
                </span>
                <h2 class="fw-bold mb-0">Announcements</h2>
            </div>
            <p class="text-muted mb-0">
                Create, organize and manage website announcements from one place.
            </p>
        </div>

        <a asp-action="CreateAnnouncement" class="btn btn-primary announcement-create-btn">
            <i class="bi bi-plus-lg me-2"></i>Create Announcement
        </a>
    </div>

@* Success Message *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Summary Cards *@
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card announcement-stat-card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="stat-label mb-2">Total Announcements</p>
                        <h3 class="stat-number mb-1">@totalAnnouncements</h3>
                        <small class="text-muted">All records</small>
                    </div>
                    <div class="stat-icon stat-icon-blue">
                        <i class="bi bi-megaphone"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card announcement-stat-card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="stat-label mb-2">Active</p>
                        <h3 class="stat-number mb-1">@activeAnnouncements</h3>
                        <small class="text-muted">Enabled announcements</small>
                    </div>
                    <div class="stat-icon stat-icon-green">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card announcement-stat-card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="stat-label mb-2">Inactive</p>
                        <h3 class="stat-number mb-1">@inactiveAnnouncements</h3>
                        <small class="text-muted">Disabled announcements</small>
                    </div>
                    <div class="stat-icon stat-icon-orange">
                        <i class="bi bi-pause-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card announcement-stat-card h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="stat-label mb-2">Upcoming</p>
                        <h3 class="stat-number mb-1">@upcomingAnnouncements</h3>
                        <small class="text-muted">Scheduled start dates</small>
                    </div>
                    <div class="stat-icon stat-icon-purple">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Main Table Card *@
    <div class="card announcement-main-card">
        <div class="card-header bg-white border-0 px-3 px-lg-4 pt-4 pb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="fw-bold mb-1">All Announcements</h5>
                    <p class="text-muted small mb-0">Review and manage your announcement records.</p>
                </div>
                <span class="announcement-count">
                    <i class="bi bi-list-ul me-1"></i>
                    @totalAnnouncements records
                </span>
            </div>
        </div>

        <div class="card-body px-3 px-lg-4 pt-2">

            @* Search Bar *@
            <form asp-action="Announcements" method="get" class="announcement-search-form mb-4">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-lg">
                        <div class="announcement-search-box">
                            <i class="bi bi-search"></i>
                            <input type="text"
                                   name="searchString"
                                   value="@ViewBag.SearchString"
                                   class="form-control"
                                   placeholder="Search by announcement title or keyword..."
                                   aria-label="Search announcements" />
                        </div>
                    </div>
                    <div class="col-6 col-lg-auto">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                    </div>
                    <div class="col-6 col-lg-auto">
                        <a asp-action="Announcements" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                        </a>
                    </div>
                </div>
            </form>

            @* Announcements Table *@
            <div class="table-responsive announcement-table-wrapper">
                <table class="table announcement-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Announcement</th>
                            <th>Type</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th>Order</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (announcements.Any())
                        {
                            @foreach (var item in announcements)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="announcement-row-icon">
                                                <i class="bi bi-megaphone"></i>
                                            </div>
                                            <div>
                                                <div class="announcement-title">@item.Title</div>
                                                <small class="text-muted">ID: @item.Id</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(item.Type))
                                        {
                                            <span class="text-muted">Not specified</span>
                                        }
                                        else
                                        {
                                            <span class="type-badge">@item.Type</span>
                                        }
                                    </td>

                                    <td class="date-cell">
                                        <i class="bi bi-calendar3 me-1 text-muted"></i>
                                        @item.StartDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="date-cell">
                                        @if (item.EndDate.HasValue)
                                        {
                                            <i class="bi bi-calendar-check me-1 text-muted"></i>
                                            @item.EndDate.Value.ToString("dd MMM yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">No end date</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="status-badge status-active">
                                                <span class="status-dot"></span> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">
                                                <span class="status-dot"></span> Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="order-badge">@item.DisplayOrder</span>
                                    </td>

                                    <td class="text-center pe-3">
                                        <div class="d-inline-flex align-items-center gap-2">
                                            <a asp-action="AnnouncementDetails"
                                               asp-route-id="@item.Id"
                                               class="announcement-action action-view"
                                               title="View Details"
                                               aria-label="View details">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="EditAnnouncement"
                                               asp-route-id="@item.Id"
                                               class="announcement-action action-edit"
                                               title="Edit Announcement"
                                               aria-label="Edit announcement">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>


                                            <form asp-action="DeleteAnnouncement"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this announcement?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="announcement-action action-delete border-0"
                                                        title="Delete Announcement"
                                                        aria-label="Delete announcement">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="py-5">
                                    <div class="announcement-empty-state text-center">
                                        <div class="empty-state-icon">
                                            <i class="bi bi-megaphone"></i>
                                        </div>
                                        <h6 class="fw-bold mt-3 mb-2">No announcements found</h6>
                                        <p class="text-muted mb-3">
                                            Try another search or create your first announcement.
                                        </p>
                                        <a asp-action="CreateAnnouncement" class="btn btn-primary btn-sm">
                                            <i class="bi bi-plus-lg me-1"></i>Create Announcement
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-3 border-top">
                <small class="text-muted">
                    Showing @announcements.Count announcement(s)
                </small>
                <small class="text-muted">
                    <i class="bi bi-shield-check me-1"></i>Announcement Management
                </small>
            </div>

        </div>
    </div>
    

</div>

<style>
    .announcement-page {
        color: #243047;
    }

    .announcement-heading-icon {
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #eaf1ff;
        color: #315fce;
        font-size: 21px;
    }

    .announcement-create-btn {
        padding: 11px 18px;
        border-radius: 9px;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(13, 110, 253, .15);
    }

    .announcement-stat-card,
    .announcement-main-card {
        border: 1px solid #edf0f5;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(27, 39, 66, .045);
        overflow: hidden;
    }

        .announcement-stat-card .card-body {
            padding: 22px;
        }

    .stat-label {
        font-size: 13px;
        font-weight: 600;
        color: #68758b;
    }

    .stat-number {
        font-size: 29px;
        font-weight: 750;
        letter-spacing: -.6px;
        color: #202b40;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .stat-icon-blue {
        background: #eaf1ff;
        color: #3867d6;
    }

    .stat-icon-green {
        background: #e7f8ef;
        color: #1d9b5c;
    }

    .stat-icon-orange {
        background: #fff2e3;
        color: #d98218;
    }

    .stat-icon-purple {
        background: #f0eaff;
        color: #7852ca;
    }

    .announcement-main-card .card-header {
        border-radius: 14px 14px 0 0;
    }

    .announcement-count {
        display: inline-block;
        padding: 7px 11px;
        background: #f3f6fb;
        color: #5d6a80;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
    }

    .announcement-search-box {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid #dfe5ee;
        border-radius: 9px;
        padding: 0 13px;
        background: #fff;
        min-height: 43px;
    }

        .announcement-search-box > i {
            color: #8995a8;
        }

        .announcement-search-box .form-control {
            border: 0;
            box-shadow: none;
            padding-left: 0;
            min-width: 0;
        }

    .announcement-search-form .btn {
        min-height: 43px;
        border-radius: 9px;
        font-weight: 600;
        padding-left: 15px;
        padding-right: 15px;
    }

    .announcement-table-wrapper {
        border: 1px solid #edf0f5;
        border-radius: 11px;
    }

    .announcement-table {
        min-width: 900px;
    }

        .announcement-table thead th {
            background: #f7f9fc;
            color: #657188;
            text-transform: uppercase;
            letter-spacing: .45px;
            font-size: 11px;
            font-weight: 700;
            padding: 15px 12px;
            white-space: nowrap;
            border-bottom: 1px solid #e9edf4;
        }

        .announcement-table tbody td {
            padding: 15px 12px;
            border-bottom: 1px solid #f0f2f6;
            font-size: 13px;
            color: #46536a;
        }

        .announcement-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .announcement-table tbody tr {
            transition: background-color .18s ease;
        }

            .announcement-table tbody tr:hover {
                background: #fafbfe;
            }

    .announcement-row-icon {
        flex-shrink: 0;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #edf3ff;
        color: #4168c8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
    }

    .announcement-title {
        font-weight: 650;
        color: #26344b;
        margin-bottom: 3px;
        max-width: 230px;
        overflow-wrap: anywhere;
    }

    .type-badge {
        display: inline-block;
        padding: 5px 9px;
        background: #f0f3f9;
        color: #596780;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 650;
    }

    .date-cell {
        white-space: nowrap;
        font-size: 12px !important;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 650;
        white-space: nowrap;
    }

    .status-active {
        color: #16804a;
        background: #e7f7ed;
    }

    .status-inactive {
        color: #687386;
        background: #eef0f4;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        display: inline-block;
        border-radius: 50%;
        background: currentColor;
    }

    .order-badge {
        min-width: 29px;
        height: 29px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #f3f5f9;
        color: #596780;
        font-weight: 700;
        font-size: 12px;
    }

    .announcement-action {
        width: 33px;
        height: 33px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        text-decoration: none;
        transition: all .18s ease;
        font-size: 14px;
    }

    .action-view {
        background: #e8f2ff;
        color: #2463c7;
    }

    .action-edit {
        background: #fff3dc;
        color: #a96a08;
    }

    .action-delete {
        background: #ffebeb;
        color: #cf3f48;
    }

    .action-view:hover {
        background: #2463c7;
        color: #fff;
    }

    .action-edit:hover {
        background: #e8a22b;
        color: #fff;
    }

    .action-delete:hover {
        background: #cf3f48;
        color: #fff;
    }

    .announcement-empty-state {
        padding: 15px 10px;
    }

    .empty-state-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto;
        border-radius: 18px;
        background: #eef3ff;
        color: #4168c8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
    }

    @@media (max-width: 576px) {
        .announcement-page {
            padding-top: 20px !important;
        }

        .announcement-stat-card .card-body {
            padding: 17px;
        }

        .stat-number {
            font-size: 25px;
        }

        .announcement-create-btn {
            width: 100%;
        }
    }
</style>
