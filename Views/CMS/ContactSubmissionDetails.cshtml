
@model CMSPanel.Models.ContactSubmission

@{
    ViewData["Title"] = "Contact Submission Details";

    var statusClass = Model.Status switch
    {
        "New" => "status-new",
        "Read" => "status-read",
        "Replied" => "status-replied",
        _ => "status-default"
    };

    var statusIcon = Model.Status switch
    {
        "New" => "bi-envelope",
        "Read" => "bi-envelope-open",
        "Replied" => "bi-check-circle",
        _ => "bi-info-circle"
    };
}

<style>
    .contact-details-page {
        color: #243247;
        max-width: 1500px;
        margin: 0 auto;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        margin-bottom: 26px;
    }

        .page-heading h1 {
            font-size: 1.75rem;
            font-weight: 750;
            letter-spacing: -.5px;
            margin-bottom: 6px;
        }

    .page-subtitle {
        color: #718096;
        margin: 0;
    }

    .detail-card {
        background: #fff;
        border: 1px solid #e8edf3;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(31, 45, 61, .045);
        margin-bottom: 22px;
        overflow: hidden;
    }

    .detail-card-header {
        padding: 19px 23px;
        border-bottom: 1px solid #edf1f5;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .section-icon {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #edf4ff;
        color: #2563eb;
        font-size: 1.15rem;
        flex-shrink: 0;
    }

    .detail-card-header h5 {
        font-weight: 700;
        font-size: 1rem;
        margin: 0;
    }

    .detail-card-body {
        padding: 24px;
    }

    .info-item {
        height: 100%;
        padding: 15px;
        border: 1px solid #edf1f5;
        border-radius: 10px;
        background: #fcfdff;
        overflow-wrap: anywhere;
    }

    .info-label {
        font-size: .78rem;
        color: #718096;
        margin-bottom: 7px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .45px;
    }

    .info-value {
        font-weight: 600;
        color: #263449;
        margin: 0;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 30px;
        padding: 7px 12px;
        font-size: .82rem;
        font-weight: 700;
    }

    .status-new {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .status-read {
        color: #92400e;
        background: #fef3c7;
    }

    .status-replied {
        color: #166534;
        background: #dcfce7;
    }

    .status-default {
        color: #475569;
        background: #e2e8f0;
    }

    .message-content {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        line-height: 1.8;
        color: #374151;
        background: #f8fafc;
        border: 1px solid #edf1f5;
        border-radius: 10px;
        padding: 20px;
        min-height: 100px;
    }

    .review-panel {
        background: #f8fafc;
        border: 1px solid #e8edf3;
        border-radius: 12px;
        padding: 20px;
    }

    .remarks-content {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        background: #fff;
        border: 1px solid #e8edf3;
        border-radius: 9px;
        padding: 15px;
        color: #374151;
    }

    .page-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin: 8px 0 24px;
    }

    .page-actions-right {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }

    .btn {
        border-radius: 8px;
        font-weight: 600;
        padding: 9px 15px;
    }

    .form-control,
    .form-select {
        border-radius: 8px;
        min-height: 43px;
        border-color: #dce3ec;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #86aefb;
            box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .1);
        }

    .breadcrumb {
        font-size: .87rem;
        margin-bottom: 18px;
    }

        .breadcrumb a {
            color: #2563eb;
            text-decoration: none;
        }

    @@media (max-width: 767px) {
        .page-heading h1 {
            font-size: 1.4rem;
        }

        .detail-card-body {
            padding: 17px;
        }

        .detail-card-header {
            padding: 16px 17px;
        }

        .page-actions,
        .page-actions-right {
            width: 100%;
        }

            .page-actions-right .btn {
                flex: 1;
            }
    }
</style>

<div class="container-fluid py-4 contact-details-page">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index" asp-controller="CMS">Dashboard</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="ContactSubmissions" asp-controller="CMS">
                    Contact Submissions
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                Details
            </li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="page-heading">
        <div>
            <h1>Contact Submission Details</h1>
            <p class="page-subtitle">
                Review the message, contact information and submission status.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="ContactSubmissions"
               asp-controller="CMS"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to List
            </a>

            <a asp-action="EditContactSubmission"
               asp-controller="CMS"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i>
                Edit Submission
            </a>
        </div>
    </div>

    <!-- Contact Information -->
    <div class="detail-card">
        <div class="detail-card-header">
            <span class="section-icon">
                <i class="bi bi-person-lines-fill"></i>
            </span>
            <div>
                <h5>Contact Information</h5>
                <small class="text-muted">Sender and submission details</small>
            </div>
        </div>

        <div class="detail-card-body">
            <div class="row g-3">

                <div class="col-md-6 col-xl-4">
                    <div class="info-item">
                        <div class="info-label">Full Name</div>
                        <p class="info-value">
                            <i class="bi bi-person me-2 text-primary"></i>@Model.Name
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="info-item">
                        <div class="info-label">Email Address</div>
                        <p class="info-value">
                            <i class="bi bi-envelope me-2 text-primary"></i>
                            @Model.Email
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="info-item">
                        <div class="info-label">Phone Number</div>
                        <p class="info-value">
                            <i class="bi bi-telephone me-2 text-primary"></i>
                            @(string.IsNullOrWhiteSpace(Model.Phone)
                                ? "Not provided"
                                : Model.Phone)
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="info-item">
                        <div class="info-label">Submitted On</div>
                        <p class="info-value">
                            <i class="bi bi-calendar3 me-2 text-primary"></i>
                            @Model.SubmittedAt.ToString("dd MMM yyyy")
                        </p>
                        <small class="text-muted">
                            @Model.SubmittedAt.ToString("hh:mm tt")
                        </small>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="info-item">
                        <div class="info-label">Subject</div>
                        <p class="info-value">
                            @(string.IsNullOrWhiteSpace(Model.Subject)
                                ? "No subject"
                                : Model.Subject)
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="info-item">
                        <div class="info-label">Current Status</div>
                        <span class="status-badge @statusClass">
                            <i class="bi @statusIcon"></i>
                            @(string.IsNullOrWhiteSpace(Model.Status)
                                ? "Unknown"
                                : Model.Status)
                        </span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Message -->
    <div class="detail-card">
        <div class="detail-card-header">
            <span class="section-icon">
                <i class="bi bi-chat-left-text"></i>
            </span>
            <div>
                <h5>Message</h5>
                <small class="text-muted">Message submitted through the contact form</small>
            </div>
        </div>

        <div class="detail-card-body">
            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div class="message-content">@Model.Message</div>
            }
            else
            {
                <p class="text-muted mb-0">No message was provided.</p>
            }
        </div>
    </div>

    <!-- Submission Review -->
    <div class="detail-card">
        <div class="detail-card-header">
            <span class="section-icon">
                <i class="bi bi-clipboard-check"></i>
            </span>
            <div>
                <h5>Submission Review</h5>
                <small class="text-muted">Update status and add internal remarks</small>
            </div>
        </div>

        <div class="detail-card-body">
            <div class="review-panel">

                <form asp-action="UpdateContactSubmissionStatus"
                      asp-controller="CMS"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="row g-3 align-items-end">

                        <div class="col-md-4">
                            <label for="status" class="form-label fw-semibold">
                                Submission Status
                            </label>

                            <select id="status"
                                    name="status"
                                    class="form-select">

                                <option value="New" selected="@(Model.Status == "New")">
                                    New
                                </option>

                                <option value="Read" selected="@(Model.Status == "Read")">
                                    Read
                                </option>

                                <option value="Replied" selected="@(Model.Status == "Replied")">
                                    Replied
                                </option>

                            </select>
                        </div>

                        <div class="col-md-5">
                            <label for="remarks" class="form-label fw-semibold">
                                Remarks
                            </label>

                            <input id="remarks"
                                   type="text"
                                   name="remarks"
                                   value="@Model.Remarks"
                                   class="form-control"
                                   placeholder="Add internal remarks..." />
                        </div>

                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-check2-circle me-1"></i>
                                Save Changes
                            </button>
                        </div>

                    </div>
                </form>
            </div>

            <div class="mt-4">
                <div class="info-label">Saved Remarks</div>

                @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                {
                    <div class="remarks-content">@Model.Remarks</div>
                }
                else
                {
                    <p class="text-muted mb-0">No remarks have been added yet.</p>
                }
            </div>

            @if (Model.UpdatedAt.HasValue)
            {
                <div class="mt-4 pt-3 border-top">
                    <div class="info-label">Last Updated</div>
                    <p class="info-value">
                        <i class="bi bi-clock-history me-2 text-primary"></i>
                        @Model.UpdatedAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                    </p>
                </div>
            }
        </div>
    </div>

    <!-- Footer Actions -->
    <div class="page-actions">
        <a asp-action="ContactSubmissions"
           asp-controller="CMS"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Submissions
        </a>

        <div class="page-actions-right">
            <a asp-action="EditContactSubmission"
               asp-controller="CMS"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>
                Edit
            </a>

            <form asp-action="DeleteContactSubmission"
                  asp-controller="CMS"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="d-inline"
                  onsubmit="return confirm('Are you sure you want to delete this contact submission?');">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>
                    Delete Submission
                </button>
            </form>
        </div>
    </div>

</div>
