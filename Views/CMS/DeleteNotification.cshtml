@model CMSPanel.Models.Notification

@{
    ViewData["Title"] = "Delete Notification";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-danger">
                Delete Notification
            </h1>

            <p class="text-muted mb-0">
                Confirm notification deletion
            </p>
        </div>

        <a asp-action="Notifications"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Are you sure you want to delete this notification?
                This action cannot be undone.
            </div>

            <div class="row g-4">

                <div class="col-md-8">

                    <div class="mb-3">
                        <label class="fw-semibold text-muted">
                            Title
                        </label>

                        <div class="fs-5">
                            @Model.Title
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-semibold text-muted">
                            Message
                        </label>

                        <div class="border rounded p-3 bg-light">
                            @Model.Message
                        </div>
                    </div>

                </div>

                <div class="col-md-4">

                    <div class="mb-3">
                        <label class="fw-semibold text-muted">
                            Type
                        </label>

                        <div>
                            <span class="badge bg-secondary">
                                @Model.Type
                            </span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-semibold text-muted">
                            Status
                        </label>

                        <div>
                            <span class="badge bg-secondary">
                                @Model.Status
                            </span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-semibold text-muted">
                            Created At
                        </label>

                        <div>
                            @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                    </div>

                </div>

            </div>

            <hr />

            <form asp-action="DeleteNotification"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                @Html.AntiForgeryToken()

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger">
                        <i class="bi bi-trash"></i>
                        Yes, Delete
                    </button>

                    <a asp-action="Notifications"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
