@model CMSPanel.Models.Media

@{
    ViewData["Title"] = "Edit Media";
}

<style>
    .edit-media-page {
        min-height: 100vh;
        padding: 25px;
        background: #f8fafc;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 0;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 17px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: white;
        color: #475569;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-back:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

    .edit-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
        overflow: hidden;
    }

    .edit-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .header-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef2ff;
        color: #4f46e5;
        border-radius: 10px;
        font-size: 20px;
    }

    .edit-card-header h5 {
        font-size: 16px;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
    }

    .edit-card-header p {
        color: #64748b;
        font-size: 12px;
        margin: 4px 0 0;
    }

    .edit-card-body {
        padding: 25px;
    }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 9px;
    }

        .section-title i {
            color: #6366f1;
            font-size: 17px;
        }

    .form-label {
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        min-height: 43px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 13px;
        color: #334155;
        padding: 10px 12px;
    }

    textarea.form-control {
        min-height: auto;
        resize: vertical;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
    }

    .form-text {
        color: #94a3b8;
        font-size: 11px;
        margin-top: 7px;
    }

    .current-file-box {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
    }

    .current-file-preview {
        width: 95px;
        height: 75px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
    }

        .current-file-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .current-file-preview i {
            font-size: 34px;
        }

    .current-file-name {
        font-size: 13px;
        font-weight: 700;
        color: #1e293b;
        overflow-wrap: anywhere;
    }

    .current-file-type {
        display: inline-block;
        margin-top: 6px;
        padding: 4px 9px;
        background: #eef2ff;
        color: #4f46e5;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .upload-box {
        padding: 20px;
        background: #f8fafc;
        border: 1px dashed #a5b4fc;
        border-radius: 10px;
        transition: 0.2s;
    }

        .upload-box:hover {
            background: #f5f7ff;
            border-color: #6366f1;
        }

    .upload-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef2ff;
        color: #4f46e5;
        border-radius: 10px;
        font-size: 21px;
        margin-bottom: 12px;
    }

    .upload-heading {
        color: #1e293b;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .upload-description {
        color: #64748b;
        font-size: 12px;
        margin-bottom: 12px;
    }

    .file-preview-new {
        display: none;
        margin-top: 15px;
        padding: 12px;
        background: white;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        align-items: center;
        gap: 12px;
    }

        .file-preview-new img {
            width: 55px;
            height: 50px;
            object-fit: cover;
            border-radius: 6px;
        }

        .file-preview-new i {
            font-size: 27px;
            color: #6366f1;
        }

    .file-preview-name {
        font-size: 12px;
        font-weight: 600;
        color: #334155;
        overflow-wrap: anywhere;
    }

    .form-check {
        padding: 15px 16px 15px 42px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
    }

    .form-check-input {
        width: 18px;
        height: 18px;
        margin-top: 2px;
        cursor: pointer;
    }

        .form-check-input:checked {
            background-color: #4f46e5;
            border-color: #4f46e5;
        }

    .form-check-label {
        color: #1e293b;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .active-description {
        display: block;
        margin-top: 4px;
        color: #64748b;
        font-size: 11px;
        font-weight: 400;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
        padding-top: 20px;
        margin-top: 25px;
        border-top: 1px solid #e2e8f0;
    }

    .btn-update {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 11px 20px;
        background: #4f46e5;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-update:hover {
            background: #4338ca;
            color: white;
            transform: translateY(-1px);
        }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 11px 20px;
        background: white;
        color: #475569;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-cancel:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

    .validation-summary-errors {
        padding: 12px 16px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        color: #b91c1c;
        font-size: 13px;
    }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        font-size: 12px;
    }

    @@media (max-width: 768px) {
        .edit-media-page {
            padding: 15px;
        }

        .page-title {
            font-size: 23px;
        }

        .edit-card-body {
            padding: 18px;
        }

        .current-file-box {
            align-items: flex-start;
        }

        .form-actions {
            justify-content: stretch;
        }

            .form-actions .btn-update,
            .form-actions .btn-cancel {
                flex: 1;
            }
    }
</style>

<div class="edit-media-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-pencil-square text-primary me-2"></i>
                Edit Media
            </h1>
            <p class="page-subtitle">
                Update media information or replace the uploaded file.
            </p>
        </div>

        <a asp-action="Media" class="btn-back">
            <i class="bi bi-arrow-left"></i>
            Back to Library
        </a>
    </div>

    <!-- Edit Form Card -->
    <div class="edit-card">

        <div class="edit-card-header">
            <div class="header-icon">
                <i class="bi bi-file-earmark-image"></i>
            </div>

            <div>
                <h5>Media Information</h5>
                <p>Update the details of your media file.</p>
            </div>
        </div>

        <div class="edit-card-body">

            <form asp-action="EditMedia"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <!-- Current File -->
                <div class="mb-4">

                    <h6 class="section-title">
                        <i class="bi bi-file-earmark-check"></i>
                        Current File
                    </h6>

                    <div class="current-file-box">

                        <div class="current-file-preview">

                            @if (Model.FileType == "Image" &&
                            !string.IsNullOrWhiteSpace(Model.FileUrl))
                            {
                                <img src="@Model.FileUrl"
                                     alt="@Model.AltText"
                                     onerror="this.style.display='none';" />
                            }
                            else if (Model.FileType == "Document")
                            {
                                <i class="bi bi-file-earmark-text text-danger"></i>
                            }
                            else if (Model.FileType == "Video")
                            {
                                <i class="bi bi-play-circle text-primary"></i>
                            }
                            else if (Model.FileType == "Audio")
                            {
                                <i class="bi bi-music-note-beamed text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-file-earmark text-secondary"></i>
                            }

                        </div>

                        <div class="flex-grow-1">
                            <div class="current-file-name">
                                @(string.IsNullOrWhiteSpace(Model.FileName)
                                    ? "No file name"
                                    : Model.FileName)
                            </div>

                            <span class="current-file-type">
                                @(string.IsNullOrWhiteSpace(Model.FileType)
                                    ? "Unknown Type"
                                    : Model.FileType)
                            </span>
                        </div>

                    </div>
                </div>

                <div class="border-top pt-4 mb-4"></div>

                <!-- Basic Information -->
                <h6 class="section-title">
                    <i class="bi bi-card-text"></i>
                    Basic Information
                </h6>

                <!-- Title -->
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">
                        Media Title <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter media title" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Enter a description for this media"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="border-top pt-4 mb-4"></div>

                <!-- Replace File -->
                <h6 class="section-title">
                    <i class="bi bi-cloud-arrow-up"></i>
                    Replace File
                </h6>

                <div class="upload-box mb-4">

                    <div class="upload-icon">
                        <i class="bi bi-cloud-upload"></i>
                    </div>

                    <div class="upload-heading">
                        Choose a new file
                    </div>

                    <p class="upload-description">
                        Select a file only if you want to replace the current one.
                    </p>

                    <input type="file"
                           id="uploadFile"
                           name="uploadFile"
                           class="form-control"
                           accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.mp4,.webm,.mp3,.wav" />

                    <div class="form-text">
                        Leave empty to keep the current file. Maximum file size: 5 MB.
                    </div>

                    <span class="text-danger">
                        @Html.ValidationMessage("uploadFile")
                    </span>

                    <!-- New File Preview -->
                    <div class="file-preview-new" id="newFilePreview">
                        <div id="newFileIcon">
                            <i class="bi bi-file-earmark"></i>
                        </div>

                        <div class="flex-grow-1">
                            <div class="file-preview-name" id="newFileName"></div>
                            <small class="text-muted" id="newFileSize"></small>
                        </div>
                    </div>

                </div>

                <div class="border-top pt-4 mb-4"></div>

                <!-- Category and Alt Text -->
                <h6 class="section-title">
                    <i class="bi bi-tags"></i>
                    Additional Information
                </h6>

                <div class="row g-3">

                    <!-- Category -->
                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label">
                            Category
                        </label>

                        <input asp-for="Category"
                               class="form-control"
                               placeholder="e.g. Banner, Blog, Document" />

                        <span asp-validation-for="Category"
                              class="text-danger"></span>
                    </div>

                    <!-- Alt Text -->
                    <div class="col-md-6">
                        <label asp-for="AltText" class="form-label">
                            Alt Text
                        </label>

                        <input asp-for="AltText"
                               class="form-control"
                               placeholder="Enter image alt text" />

                        <span asp-validation-for="AltText"
                              class="text-danger"></span>
                    </div>

                </div>

                <!-- Active Status -->
                <div class="mt-4">
                    <h6 class="section-title">
                        <i class="bi bi-toggle-on"></i>
                        Visibility Settings
                    </h6>

                    <div class="form-check">
                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label asp-for="IsActive"
                               class="form-check-label">
                            Active

                            <span class="active-description">
                                Enable this option to keep the media active.
                            </span>
                        </label>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="form-actions">

                    <a asp-action="Media" class="btn-cancel">
                        <i class="bi bi-x-lg"></i>
                        Cancel
                    </a>

                    <button type="submit" class="btn-update">
                        <i class="bi bi-check-lg"></i>
                        Update Media
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const uploadInput = document.getElementById("uploadFile");
        const previewContainer = document.getElementById("newFilePreview");
        const previewIcon = document.getElementById("newFileIcon");
        const fileName = document.getElementById("newFileName");
        const fileSize = document.getElementById("newFileSize");

        uploadInput.addEventListener("change", function () {
            const file = this.files[0];

            if (!file) {
                previewContainer.style.display = "none";
                return;
            }

            fileName.textContent = file.name;

            const size = file.size;
            fileSize.textContent = size >= 1024 * 1024
                ? (size / (1024 * 1024)).toFixed(2) + " MB"
                : (size / 1024).toFixed(2) + " KB";

            previewIcon.innerHTML = '<i class="bi bi-file-earmark text-primary"></i>';

            if (file.type.startsWith("image/")) {
                const reader = new FileReader();

                reader.onload = function (event) {
                    previewIcon.innerHTML =
                        '<img src="' + event.target.result +
                        '" alt="New file preview" />';
                };

                reader.readAsDataURL(file);
            } else if (file.type.startsWith("video/")) {
                previewIcon.innerHTML =
                    '<i class="bi bi-play-circle text-primary"></i>';
            } else if (file.type.startsWith("audio/")) {
                previewIcon.innerHTML =
                    '<i class="bi bi-music-note-beamed text-success"></i>';
            } else if (file.type === "application/pdf") {
                previewIcon.innerHTML =
                    '<i class="bi bi-file-earmark-pdf text-danger"></i>';
            }

            previewContainer.style.display = "flex";
        });
    </script>
}