@model IEnumerable<CMSPanel.Models.ProjectCategory>

@{
    ViewData["Title"] = "Project Categories";

    var categories = Model?.ToList()
                     ?? new List<CMSPanel.Models.ProjectCategory>();

    var totalCategories = categories.Count;
    var activeCategories = categories.Count(x => x.IsActive);
    var inactiveCategories = totalCategories - activeCategories;
}

<style>
    .category-page {
        padding: 10px 4px 30px;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

        .page-heading h2 {
            font-size: 28px;
            font-weight: 700;
            color: #172033;
            margin-bottom: 6px;
        }

        .page-heading p {
            color: #778196;
            margin: 0;
            font-size: 14px;
        }

    .btn-add-category {
        background: #2563eb;
        color: white;
        border: none;
        padding: 11px 18px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s;
        white-space: nowrap;
    }

        .btn-add-category:hover {
            background: #1d4ed8;
            color: white;
            transform: translateY(-1px);
        }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #e9edf5;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .icon-total {
        background: #e8efff;
        color: #2563eb;
    }

    .icon-active {
        background: #dcfce7;
        color: #16a34a;
    }

    .icon-inactive {
        background: #f1f5f9;
        color: #64748b;
    }

    .stat-label {
        font-size: 13px;
        color: #7b8497;
        margin-bottom: 5px;
    }

    .stat-number {
        font-size: 25px;
        font-weight: 700;
        color: #172033;
        line-height: 1.2;
    }

    .category-card {
        background: #fff;
        border: 1px solid #e9edf5;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        overflow: hidden;
    }

    .category-card-header {
        padding: 20px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        border-bottom: 1px solid #edf0f5;
    }

        .category-card-header h5 {
            font-size: 16px;
            font-weight: 700;
            color: #172033;
            margin: 0 0 4px;
        }

        .category-card-header p {
            color: #8791a3;
            font-size: 13px;
            margin: 0;
        }

    .category-tools {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .search-box {
        position: relative;
        width: 240px;
    }

        .search-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
        }

        .search-box input {
            width: 100%;
            border: 1px solid #dfe5ee;
            border-radius: 7px;
            padding: 9px 12px 9px 35px;
            font-size: 13px;
            outline: none;
        }

            .search-box input:focus,
            .status-filter:focus {
                border-color: #93b4ff;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
            }

    .status-filter {
        border: 1px solid #dfe5ee;
        border-radius: 7px;
        padding: 9px 12px;
        color: #475569;
        background: #fff;
        font-size: 13px;
        outline: none;
    }

    .table-container {
        padding: 0 22px 15px;
    }

    .category-table {
        margin: 0;
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .category-table thead th {
            background: #f8fafc;
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 15px 14px;
            border-bottom: 1px solid #e8edf4;
            white-space: nowrap;
        }

        .category-table tbody td {
            padding: 16px 14px;
            color: #334155;
            font-size: 13px;
            border-bottom: 1px solid #edf0f5;
            vertical-align: middle;
        }

        .category-table tbody tr:hover {
            background: #f8faff;
        }

    .category-name {
        font-weight: 600;
        color: #1e293b;
    }

    .category-slug {
        color: #64748b;
        font-family: monospace;
        font-size: 12px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-active {
        background: #dcfce7;
        color: #15803d;
    }

    .status-inactive {
        background: #f1f5f9;
        color: #64748b;
    }

    .action-buttons {
        display: flex;
        gap: 7px;
        align-items: center;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        border: 1px solid transparent;
        text-decoration: none;
        font-size: 14px;
        transition: 0.2s;
    }

    .btn-view {
        background: #e0f2fe;
        color: #0284c7;
        border-color: #bae6fd;
    }

    .btn-edit {
        background: #fef3c7;
        color: #b45309;
        border-color: #fde68a;
    }

    .btn-delete {
        background: #fee2e2;
        color: #dc2626;
        border-color: #fecaca;
    }

    .action-btn:hover {
        transform: translateY(-1px);
        filter: brightness(0.97);
    }

    .empty-state {
        text-align: center;
        padding: 50px 20px !important;
    }

        .empty-state i {
            font-size: 40px;
            color: #94a3b8;
            display: block;
            margin-bottom: 12px;
        }

        .empty-state h6 {
            color: #334155;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .empty-state p {
            color: #94a3b8;
            font-size: 13px;
            margin: 0;
        }

    .table-footer {
        padding: 13px 22px;
        border-top: 1px solid #edf0f5;
        color: #94a3b8;
        font-size: 12px;
    }

    .alert {
        border-radius: 9px;
    }

    @@media (max-width: 900px) {
        .stats-row {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .category-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .category-tools {
            width: 100%;
        }

        .search-box {
            flex: 1;
            width: auto;
        }
    }

    @@media (max-width: 600px) {
        .page-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .stats-row {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .category-tools {
            align-items: stretch;
            flex-direction: column;
        }

        .search-box {
            width: 100%;
        }

        .status-filter {
            width: 100%;
        }

        .table-container {
            padding: 0 12px 12px;
        }
    }
</style>

<div class="container-fluid category-page">

    <!-- Page Heading -->
    <div class="page-heading">
        <div>
            <h2>Project Categories</h2>
            <p>Organize and manage your project categories</p>
        </div>

        <a asp-controller="CMS"
           asp-action="CreateProjectCategory"
           class="btn-add-category">
            <i class="bi bi-plus-circle"></i>
            Add Category
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }


    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }


    <!-- Statistics -->
    <div class="stats-row">

        <div class="stat-card">
            <div class="stat-icon icon-total">
                <i class="bi bi-folder2-open"></i>
            </div>
            <div>
                <div class="stat-label">Total Categories</div>
                <div class="stat-number">@totalCategories</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-active">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <div class="stat-label">Active Categories</div>
                <div class="stat-number">@activeCategories</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-inactive">
                <i class="bi bi-pause-circle"></i>
            </div>
            <div>
                <div class="stat-label">Inactive Categories</div>
                <div class="stat-number">@inactiveCategories</div>
            </div>
        </div>

    </div>

    <!-- Categories Table Card -->
    <div class="category-card">

        <div class="category-card-header">
            <div>
                <h5>All Project Categories</h5>
                <p>View and manage your categories</p>
            </div>

            <div class="category-tools">

                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           id="categorySearch"
                           placeholder="Search categories..." />
                </div>

                <select id="statusFilter" class="status-filter">
                    <option value="all">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>

            </div>
        </div>

        <div class="table-container">
            <div class="table-responsive">
                <table class="table category-table" id="categoriesTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Slug</th>
                            <th>Status</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (categories.Any())
                        {
                            var count = 1;

                            foreach (var item in categories)
                            {
                                <tr class="category-row"
                                    data-name="@item.Name"
                                    data-slug="@item.Slug"
                                    data-status="@(item.IsActive ? "active" : "inactive")">

                                    <td>@count</td>

                                    <td>
                                        <span class="category-name">
                                            @item.Name
                                        </span>
                                    </td>

                                    <td>
                                        <span class="category-slug">
                                            @item.Slug
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="status-badge status-active">
                                                <i class="bi bi-circle-fill"></i>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">
                                                <i class="bi bi-circle-fill"></i>
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @item.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        <div class="action-buttons">

                                            <a asp-controller="CMS"
                                               asp-action="ProjectCategoryDetails"
                                               asp-route-id="@item.Id"
                                               class="action-btn btn-view"
                                               title="View">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-controller="CMS"
                                               asp-action="EditProjectCategory"
                                               asp-route-id="@item.Id"
                                               class="action-btn btn-edit"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>



                                            <form asp-controller="CMS"
                                                  asp-action="DeleteProjectCategory"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this project category?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="id" value="@item.Id" />

                                                <button type="submit"
                                                        class="action-btn btn-delete"
                                                        title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>


                                        </div>
                                    </td>
                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="empty-state">
                                    <i class="bi bi-folder2-open"></i>
                                    <h6>No project categories found</h6>
                                    <p>Create your first project category.</p>
                                </td>
                            </tr>
                        }

                        <tr id="noSearchResults" style="display:none;">
                            <td colspan="6" class="empty-state">
                                <i class="bi bi-search"></i>
                                <h6>No matching categories</h6>
                                <p>Try another search or status filter.</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="table-footer">
            Showing <span id="visibleCount">@totalCategories</span>
            of @totalCategories categories
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("categorySearch");
        const statusFilter = document.getElementById("statusFilter");
        const rows = document.querySelectorAll(".category-row");
        const noResults = document.getElementById("noSearchResults");
        const visibleCount = document.getElementById("visibleCount");

        function filterCategories() {
            const searchText = searchInput.value.toLowerCase().trim();
            const selectedStatus = statusFilter.value;
            let visible = 0;

            rows.forEach(function (row) {
                const name = row.dataset.name.toLowerCase();
                const slug = row.dataset.slug.toLowerCase();
                const status = row.dataset.status;

                const matchesSearch =
                    name.includes(searchText) ||
                    slug.includes(searchText);

                const matchesStatus =
                    selectedStatus === "all" ||
                    selectedStatus === status;

                if (matchesSearch && matchesStatus) {
                    row.style.display = "";
                    visible++;
                } else {
                    row.style.display = "none";
                }
            });

            noResults.style.display =
                rows.length > 0 && visible === 0 ? "" : "none";

            visibleCount.textContent = visible;
        }

        searchInput.addEventListener("input", filterCategories);
        statusFilter.addEventListener("change", filterCategories);
    });
</script>