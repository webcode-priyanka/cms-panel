@model CMSPanel.Models.Notification

@{
    ViewData["Title"] = "Create Notification";
}

<div class="container-fluid py-4">

    
    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold mb-1">Create Notification</h1>
        <p class="text-muted mb-0">
            Create a new system notification
        </p>
    </div>

    <!-- Notification Form -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="CreateNotification"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- Title -->
                <div class="mb-3">
                    <label asp-for="Title"
                           class="form-label fw-semibold">
                        Notification Title
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter notification title" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>
                </div>

                <!-- Message -->
                <div class="mb-3">
                    <label asp-for="Message"
                           class="form-label fw-semibold">
                        Message
                    </label>

                    <textarea asp-for="Message"
                              class="form-control"
                              rows="5"
                              placeholder="Enter notification message"></textarea>

                    <span asp-validation-for="Message"
                          class="text-danger">
                    </span>
                </div>

                <!-- Type -->
                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Type"
                               class="form-label fw-semibold">
                            Type
                        </label>

                        <select asp-for="Type"
                                class="form-select">

                            <option value="Info">Info</option>
                            <option value="Success">Success</option>
                            <option value="Warning">Warning</option>
                            <option value="Error">Error</option>

                        </select>

                        <span asp-validation-for="Type"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Status -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Status"
                               class="form-label fw-semibold">
                            Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="Unread">Unread</option>
                            <option value="Read">Read</option>

                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <!-- Link -->
                <div class="mb-4">

                    <label asp-for="Link"
                           class="form-label fw-semibold">
                        Link
                    </label>

                    <input asp-for="Link"
                           class="form-control"
                           placeholder="Optional link, e.g. /CMS/Blogs" />

                    <span asp-validation-for="Link"
                          class="text-danger">
                    </span>

                    <small class="text-muted">
                        Optional: Add a page or URL related to this notification.
                    </small>

                </div>

                <!-- Buttons -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle me-1"></i>
                        Create Notification

                    </button>

                    <a asp-action="Notifications"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-1"></i>
                        Back

                    </a>

                </div>

            </form>

        </div>

    </div>
    ```

</div>

@section Scripts {

    
    <partial name="_ValidationScriptsPartial" />
}

