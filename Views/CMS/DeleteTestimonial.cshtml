@model CMSPanel.Models.Testimonial

@{
    ViewData["Title"] = "Delete Testimonial";
}

<div class="container-fluid py-4">
    <h2 class="fw-bold mb-4">Delete Testimonial</h2>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="alert alert-danger">
                Are you sure you want to delete this testimonial?
            </div>

            <dl class="row">
                <dt class="col-sm-3">Client Name</dt>
                <dd class="col-sm-9">@Model.ClientName</dd>

                <dt class="col-sm-3">Company</dt>
                <dd class="col-sm-9">@Model.CompanyName</dd>

                <dt class="col-sm-3">Content</dt>
                <dd class="col-sm-9">@Model.Content</dd>

                <dt class="col-sm-3">Rating</dt>
                <dd class="col-sm-9">@Model.Rating / 5</dd>
            </dl>

            <form asp-action="DeleteTestimonial" asp-route-id="@Model.Id"
                  method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Yes, Delete
                </button>
                <a asp-action="Testimonials" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
