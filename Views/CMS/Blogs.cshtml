@model IEnumerable<CMSPanel.Models.Blog>

@{
    ViewData["Title"] = "Blogs";

    var blogs = Model?.ToList() ?? new List<CMSPanel.Models.Blog>();
    var totalBlogs = blogs.Count;
    var publishedBlogs = blogs.Count(b => b.IsPublished);
    var draftBlogs = blogs.Count(b => b.Status == "Draft");
    var archivedBlogs = blogs.Count(b => b.Status == "Archived");
}

<style>
    .blogs-page {
        padding: 28px;
        background: #f5f7fb;
        min-height: 100%;
    }

    .blogs-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .blogs-title {
        font-size: 28px;
        font-weight: 700;
        color: #172033;
        margin-bottom: 6px;
    }

    .blogs-subtitle {
        color: #778196;
        font-size: 14px;
        margin: 0;
    }

    .btn-create-blog {
        background: #2563eb;
        color: #fff;
        border: none;
        padding: 11px 20px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all .2s ease;
    }

        .btn-create-blog:hover {
            background: #1d4ed8;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 5px 14px rgba(37, 99, 235, .2);
        }

    .blog-stat-card {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 12px;
        padding: 20px;
        height: 100%;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .04);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .blog-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(15, 23, 42, .08);
        }

    .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .stat-label {
        font-size: 13px;
        color: #7b8497;
        font-weight: 600;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .icon-blue {
        background: #e8efff;
        color: #2563eb;
    }

    .icon-green {
        background: #e5f7ee;
        color: #16a34a;
    }

    .icon-yellow {
        background: #fff5d9;
        color: #d99a08;
    }

    .icon-gray {
        background: #edf0f5;
        color: #64748b;
    }

    .stat-number {
        font-size: 27px;
        font-weight: 700;
        color: #172033;
        line-height: 1.2;
    }

    .stat-description {
        font-size: 12px;
        color: #98a1b2;
        margin-top: 5px;
    }

    .blog-panel {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .04);
        overflow: hidden;
    }

    .blog-panel-header {
        padding: 20px 22px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .panel-title {
        font-size: 17px;
        font-weight: 700;
        color: #172033;
        margin: 0;
    }

    .panel-subtitle {
        font-size: 12px;
        color: #8992a4;
        margin-top: 4px;
    }

    .blog-filter {
        padding: 20px 22px;
        background: #fff;
        border-bottom: 1px solid #edf0f5;
    }

    .filter-label {
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 7px;
    }

    .blog-filter .form-control,
    .blog-filter .form-select {
        min-height: 42px;
        border: 1px solid #dfe4ec;
        border-radius: 7px;
        font-size: 13px;
        color: #334155;
        box-shadow: none;
    }

        .blog-filter .form-control:focus,
        .blog-filter .form-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .10);
        }

    .btn-filter {
        min-height: 42px;
        border-radius: 7px;
        padding: 0 18px;
        font-size: 13px;
        font-weight: 600;
        background: #2563eb;
        color: #fff;
        border: 1px solid #2563eb;
    }

        .btn-filter:hover {
            background: #1d4ed8;
            color: #fff;
        }

    .btn-reset {
        min-height: 42px;
        border-radius: 7px;
        padding: 0 16px;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid #dfe4ec;
        background: #fff;
        color: #475569;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-reset:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

    .blog-table-wrapper {
        padding: 0 22px 20px;
    }

    .blog-table {
        margin-bottom: 0;
        white-space: nowrap;
    }

        .blog-table thead th {
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 15px 13px;
            border-bottom: 1px solid #e8edf4;
        }

        .blog-table tbody td {
            padding: 16px 13px;
            color: #475569;
            font-size: 13px;
            border-bottom: 1px solid #f0f2f6;
            vertical-align: middle;
        }

        .blog-table tbody tr:hover {
            background: #f8faff;
        }

        .blog-table tbody tr:last-child td {
            border-bottom: none;
        }

    .blog-number {
        color: #94a3b8;
        font-weight: 600;
    }

    .blog-name {
        color: #1e293b;
        font-weight: 600;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .blog-slug {
        color: #64748b;
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .category-badge {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #dbeafe;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-published {
        background: #e8f8ef;
        color: #15803d;
    }

    .status-draft {
        background: #fff6df;
        color: #b77905;
    }

    .status-archived {
        background: #eef0f4;
        color: #64748b;
    }

    .published-yes {
        color: #16a34a;
        font-weight: 600;
    }

    .published-no {
        color: #94a3b8;
        font-weight: 600;
    }

    .blog-date {
        color: #64748b;
        font-size: 12px;
    }

    .blog-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: 1px solid transparent;
        font-size: 14px;
        transition: all .2s ease;
    }

    .action-view {
        color: #2563eb;
        background: #eff6ff;
        border-color: #dbeafe;
    }

        .action-view:hover {
            background: #2563eb;
            color: #fff;
        }

    .action-edit {
        color: #b77905;
        background: #fff7e6;
        border-color: #fde7ad;
    }

        .action-edit:hover {
            background: #eab308;
            color: #fff;
        }

    .action-delete {
        color: #dc2626;
        background: #fff1f2;
        border-color: #fecdd3;
    }

        .action-delete:hover {
            background: #dc2626;
            color: #fff;
        }

    .empty-state {
        text-align: center;
        padding: 55px 20px;
        color: #94a3b8;
    }

        .empty-state i {
            font-size: 42px;
            display: block;
            margin-bottom: 12px;
            color: #cbd5e1;
        }

        .empty-state h5 {
            font-size: 16px;
            font-weight: 700;
            color: #475569;
            margin-bottom: 6px;
        }

        .empty-state p {
            font-size: 13px;
            margin-bottom: 0;
        }

    .blog-count {
        color: #64748b;
        font-size: 12px;
        font-weight: 500;
    }

    @@media (max-width: 768px) {
        .blogs-page {
            padding: 16px;
        }

        .blogs-title {
            font-size: 23px;
        }

        .blog-stat-card {
            padding: 16px;
        }

        .blog-panel-header,
        .blog-filter {
            padding: 16px;
        }

        .blog-table-wrapper {
            padding: 0 16px 16px;
        }

        .btn-create-blog {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="blogs-page">

    <!-- Page Header -->
    <div class="blogs-header">
        <div>
            <h1 class="blogs-title">
                <i class="bi bi-journal-richtext me-2 text-primary"></i>
                Blogs
            </h1>
            <p class="blogs-subtitle">
                Create, organize and manage your website blog posts.
            </p>
        </div>

        <a asp-action="CreateBlog" class="btn-create-blog">
            <i class="bi bi-plus-lg"></i>
            Create New Blog
        </a>
    </div>

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="blog-stat-card">
                <div class="stat-top">
                    <span class="stat-label">Total Blogs</span>
                    <div class="stat-icon icon-blue">
                        <i class="bi bi-journal-text"></i>
                    </div>
                </div>
                <div class="stat-number">@totalBlogs</div>
                <div class="stat-description">Blogs in this list</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="blog-stat-card">
                <div class="stat-top">
                    <span class="stat-label">Published</span>
                    <div class="stat-icon icon-green">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
                <div class="stat-number">@publishedBlogs</div>
                <div class="stat-description">Published blog posts</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="blog-stat-card">
                <div class="stat-top">
                    <span class="stat-label">Drafts</span>
                    <div class="stat-icon icon-yellow">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                </div>
                <div class="stat-number">@draftBlogs</div>
                <div class="stat-description">Blogs saved as drafts</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="blog-stat-card">
                <div class="stat-top">
                    <span class="stat-label">Archived</span>
                    <div class="stat-icon icon-gray">
                        <i class="bi bi-archive"></i>
                    </div>
                </div>
                <div class="stat-number">@archivedBlogs</div>
                <div class="stat-description">Archived blog posts</div>
            </div>
        </div>

    </div>

    <!-- Blog Management Table -->
    <div class="blog-panel">

        <div class="blog-panel-header">
            <div>
                <h5 class="panel-title">All Blog Posts</h5>
                <div class="panel-subtitle">
                    Manage and organize your blog content
                </div>
            </div>

            <span class="blog-count">
                @totalBlogs blog(s) shown
            </span>
        </div>

        <!-- Search and Filter -->
        <div class="blog-filter">
            <form asp-action="Blogs" method="get">
                <div class="row g-3 align-items-end">

                    <div class="col-lg-6 col-md-6">
                        <label class="filter-label">Search Blogs</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text"
                                   name="searchString"
                                   value="@ViewBag.SearchString"
                                   class="form-control"
                                   placeholder="Search by title or slug..." />
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-3">
                        <label class="filter-label">Filter by Status</label>
                        <select name="status" class="form-select">
                            <option value="">All Status</option>

                            @if (ViewBag.Status == "Draft")
                            {
                                <option value="Draft" selected>Draft</option>
                            }
                            else
                            {
                                <option value="Draft">Draft</option>
                            }

                            @if (ViewBag.Status == "Published")
                            {
                                <option value="Published" selected>Published</option>
                            }
                            else
                            {
                                <option value="Published">Published</option>
                            }

                            @if (ViewBag.Status == "Archived")
                            {
                                <option value="Archived" selected>Archived</option>
                            }
                            else
                            {
                                <option value="Archived">Archived</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-3">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn-filter flex-grow-1">
                                <i class="bi bi-search me-1"></i>
                                Search
                            </button>

                            <a asp-action="Blogs" class="btn-reset">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>
                                Reset
                            </a>
                        </div>
                    </div>

                </div>
            </form>
        </div>

        <!-- Table -->
        <div class="blog-table-wrapper">
            <div class="table-responsive">
                <table class="table blog-table align-middle">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Blog Title</th>
                            <th>Category</th>
                            <th>Slug</th>
                            <th>Status</th>
                            <th>Published</th>
                            <th>Created Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && blogs.Any())
                        {
                            int count = 1;

                            foreach (var item in blogs)
                            {
                                <tr>
                                    <td>
                                        <span class="blog-number">@count</span>
                                    </td>

                                    <td>
                                        <div class="blog-name" title="@item.Title">
                                            @item.Title
                                        </div>
                                    </td>

                                    <td>
                                        @if (item.BlogCategory != null)
                                        {
                                            <span class="category-badge">
                                                <i class="bi bi-folder2 me-1"></i>
                                                @item.BlogCategory.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="category-badge">
                                                General
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="blog-slug" title="@item.Slug">
                                            @item.Slug
                                        </div>
                                    </td>

                                    <td>
                                        @if (item.Status == "Published")
                                        {
                                            <span class="status-badge status-published">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Published
                                            </span>
                                        }
                                        else if (item.Status == "Archived")
                                        {
                                            <span class="status-badge status-archived">
                                                <i class="bi bi-archive-fill"></i>
                                                Archived
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-draft">
                                                <i class="bi bi-pencil-fill"></i>
                                                Draft
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsPublished)
                                        {
                                            <span class="published-yes">
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                Yes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="published-no">
                                                <i class="bi bi-dash-circle me-1"></i>
                                                No
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="blog-date">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            @item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="blog-actions justify-content-center">

                                            <a asp-action="BlogDetails"
                                               asp-route-id="@item.Id"
                                               class="action-btn action-view"
                                               title="View Blog"
                                               aria-label="View Blog">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="EditBlog"
                                               asp-route-id="@item.Id"
                                               class="action-btn action-edit"
                                               title="Edit Blog"
                                               aria-label="Edit Blog">
                                                <i class="bi bi-pencil"></i>
                                            </a>


                                            <form asp-action="DeleteBlog"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this blog?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="id" value="@item.Id" />

                                                <button type="submit"
                                                        class="action-btn action-delete"
                                                        title="Delete Blog"
                                                        aria-label="Delete Blog">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="empty-state">
                                        <i class="bi bi-journal-x"></i>
                                        <h5>No Blogs Found</h5>
                                        <p>There are no blog posts matching your search.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>

    </div>
</div>