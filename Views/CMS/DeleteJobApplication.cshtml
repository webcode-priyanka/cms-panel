@model CMSPanel.Models.JobApplication

@{
    ViewData["Title"] = "Delete Job Application";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold mb-1">Delete Job Application</h1>
        <p class="text-muted mb-0">
            Confirm before deleting this application
        </p>
    </div>

    <!-- Confirmation Card -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Warning:</strong>
                Are you sure you want to delete this job application?
                This action cannot be undone.
            </div>

            <!-- Applicant Information -->
            <h5 class="fw-bold mb-3">
                <i class="bi bi-person me-2"></i>
                Applicant Information
            </h5>

            <div class="row g-3 mb-4">

                <div class="col-md-6">

                    <div class="text-muted small">
                        Applicant Name
                    </div>

                    <div class="fw-semibold">
                        @Model.ApplicantName
                    </div>

                </div>

                <div class="col-md-6">

                    <div class="text-muted small">
                        Email
                    </div>

                    <div class="fw-semibold">
                        @Model.Email
                    </div>

                </div>

                <div class="col-md-6">

                    <div class="text-muted small">
                        Phone
                    </div>

                    <div class="fw-semibold">
                        @Model.Phone
                    </div>

                </div>

                <div class="col-md-6">

                    <div class="text-muted small">
                        Applied For
                    </div>

                    <div class="fw-semibold">

                        @if (Model.Career != null)
                        {
                            @Model.Career.JobTitle
                        }
                        else
                        {
                            <span class="text-muted">
                                Job not found
                            </span>
                        }

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="text-muted small">
                        Applied Date
                    </div>

                    <div class="fw-semibold">
                        @Model.AppliedAt.ToString("dd MMM yyyy, hh:mm tt")
                    </div>

                </div>

                <div class="col-md-6">

                    <div class="text-muted small">
                        Status
                    </div>

                    <div class="mt-1">

                        @if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (Model.Status == "Shortlisted")
                        {
                            <span class="badge bg-info">
                                Shortlisted
                            </span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge bg-danger">
                                Rejected
                            </span>
                        }
                        else if (Model.Status == "Hired")
                        {
                            <span class="badge bg-success">
                                Hired
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.Status
                            </span>
                        }

                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <!-- Buttons -->
            <form asp-action="DeleteJobApplication"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="JobApplications"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Are you sure you want to delete this application?');">
                        <i class="bi bi-trash me-1"></i>
                        Delete Application
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
