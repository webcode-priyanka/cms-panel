
@model CMSPanel.Models.Download

@{
    ViewData["Title"] = "Download Details";
}

<style>
    .download-page {
        padding: 28px 0;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 28px;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 6px;
    }

    .page-subtitle {
        color: #64748b;
        margin: 0;
    }

    .details-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
        overflow: hidden;
        margin-bottom: 24px;
    }

    .details-card-header {
        padding: 22px 26px;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
    }

    .details-card-body {
        padding: 26px;
    }

    .document-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #e8efff;
        color: #3157c8;
        font-size: 28px;
        flex-shrink: 0;
    }

    .document-title {
        font-size: 23px;
        font-weight: 700;
        color: #1e293b;
        overflow-wrap: anywhere;
        margin: 0 0 8px;
    }

    .detail-item {
        height: 100%;
        padding: 18px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #fff;
    }

    .detail-label {
        display: block;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .detail-value {
        color: #1e293b;
        font-size: 15px;
        font-weight: 500;
        margin: 0;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .section-title {
        font-size: 17px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 18px;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-active {
        background: #dcfce7;
        color: #166534;
    }

    .status-inactive {
        background: #f1f5f9;
        color: #475569;
    }

    .action-btn {
        border-radius: 9px;
        padding: 10px 16px;
        font-weight: 600;
    }

    .file-path {
        display: block;
        padding: 12px 14px;
        border-radius: 8px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        overflow-wrap: anywhere;
        color: #475569;
        font-size: 14px;
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 23px;
        }

        .details-card-body,
        .details-card-header {
            padding: 18px;
        }

        .header-actions {
            width: 100%;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
    }
</style>

<div class="container-fluid download-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h2 class="page-title">
                <i class="bi bi-file-earmark-text text-primary me-2"></i>
                Download Details
            </h2>
            <p class="page-subtitle">
                View document information and file details.
            </p>
        </div>

        <div class="header-actions d-flex gap-2">
            <a asp-action="EditDownload"
               asp-route-id="@Model.Id"
               class="btn btn-warning action-btn">
                <i class="bi bi-pencil-square me-1"></i>
                Edit Download
            </a>

            <a asp-action="Downloads"
               class="btn btn-outline-secondary action-btn">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Downloads
            </a>
        </div>
    </div>

    <!-- Document Overview -->
    <div class="details-card">
        <div class="details-card-header">
            <div class="d-flex align-items-center gap-3">
                <div class="document-icon">
                    <i class="bi bi-file-earmark"></i>
                </div>

                <div class="flex-grow-1">
                    <h3 class="document-title">@Model.Title</h3>

                    @if (Model.Status == "Active")
                    {
                        <span class="status-badge status-active">
                            <i class="bi bi-check-circle me-1"></i> Active
                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-inactive">
                            <i class="bi bi-dash-circle me-1"></i>
                            @(string.IsNullOrWhiteSpace(Model.Status)
                                ? "Unknown"
                                : Model.Status)
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="details-card-body">
            <h5 class="section-title">
                <i class="bi bi-info-circle text-primary me-2"></i>
                Document Information
            </h5>

            <div class="row g-3">

                <div class="col-md-6 col-xl-4">
                    <div class="detail-item">
                        <span class="detail-label">Category</span>
                        <p class="detail-value">
                            @(string.IsNullOrWhiteSpace(Model.Category)
                                ? "Not specified"
                                : Model.Category)
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="detail-item">
                        <span class="detail-label">File Name</span>
                        <p class="detail-value">
                            @(string.IsNullOrWhiteSpace(Model.FileName)
                                ? "No file name"
                                : Model.FileName)
                        </p>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="detail-item">
                        <span class="detail-label">Record ID</span>
                        <p class="detail-value">#@Model.Id</p>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Description -->
    <div class="details-card">
        <div class="details-card-body">
            <h5 class="section-title">
                <i class="bi bi-card-text text-primary me-2"></i>
                Description
            </h5>

            <p class="detail-value">
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "No description has been added."
                    : Model.Description)
            </p>
        </div>
    </div>

    <!-- File Location -->
    <div class="details-card">
        <div class="details-card-body">
            <h5 class="section-title">
                <i class="bi bi-folder2-open text-primary me-2"></i>
                File Location
            </h5>

            @if (!string.IsNullOrWhiteSpace(Model.FilePath))
            {
                <div class="file-path">
                    <i class="bi bi-file-earmark me-2"></i>
                    @Model.FilePath
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No file path is available.
                </p>
            }
        </div>
    </div>

    <!-- Record History -->
    <div class="details-card">
        <div class="details-card-body">
            <h5 class="section-title">
                <i class="bi bi-clock-history text-primary me-2"></i>
                Record History
            </h5>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="bi bi-calendar-plus me-1"></i>
                            Created At
                        </span>
                        <p class="detail-value">
                            @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="detail-item">
                        <span class="detail-label">
                            <i class="bi bi-calendar-check me-1"></i>
                            Last Updated
                        </span>
                        <p class="detail-value">
                            @(Model.UpdatedAt.HasValue
                                ? Model.UpdatedAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                                : "Not updated yet")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Actions -->
    <div class="d-flex justify-content-end gap-2 mb-4">
        <a asp-action="Downloads"
           class="btn btn-outline-secondary action-btn">
            <i class="bi bi-arrow-left me-1"></i>
            Back to List
        </a>

        <a asp-action="EditDownload"
           asp-route-id="@Model.Id"
           class="btn btn-primary action-btn">
            <i class="bi bi-pencil-square me-1"></i>
            Edit Download
        </a>
    </div>

</div>