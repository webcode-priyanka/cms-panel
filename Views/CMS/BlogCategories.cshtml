@model IEnumerable<CMSPanel.Models.BlogCategory>

@{
    ViewData["Title"] = "Blog Categories";
    var categories = Model?.ToList() ?? new List<CMSPanel.Models.BlogCategory>();
    var totalCategories = categories.Count;
    var activeCategories = categories.Count(x => x.IsActive);
    var inactiveCategories = totalCategories - activeCategories;
}

<style>
    .category-page {
        padding: 25px;
    }

    .category-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 28px;
    }

    .category-title {
        font-size: 30px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 5px;
    }

    .category-subtitle {
        color: #64748b;
        margin: 0;
        font-size: 14px;
    }

    .btn-create-category {
        background: #2563eb;
        color: white;
        border: none;
        border-radius: 9px;
        padding: 11px 20px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

    .btn-create-category:hover {
        background: #1d4ed8;
        color: white;
        transform: translateY(-1px);
    }

    .category-stat-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        height: 100%;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        transition: 0.2s;
    }

    .category-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(15, 23, 42, 0.08);
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 21px;
        margin-bottom: 14px;
    }

    .stat-total {
        background: #dbeafe;
        color: #2563eb;
    }

    .stat-active {
        background: #dcfce7;
        color: #16a34a;
    }

    .stat-inactive {
        background: #fee2e2;
        color: #dc2626;
    }

    .stat-label {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 5px;
    }

    .stat-value {
        color: #1e293b;
        font-size: 27px;
        font-weight: 700;
        margin: 0;
    }

    .category-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        margin-bottom: 24px;
        overflow: hidden;
    }

    .category-card-header {
        padding: 18px 22px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .category-card-title {
        font-size: 17px;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
    }

    .category-card-body {
        padding: 22px;
    }

    .category-search {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 11px 14px;
        height: 45px;
    }

    .category-search:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .btn-search {
        height: 45px;
        background: #2563eb;
        color: white;
        border-radius: 8px;
        padding: 0 22px;
        font-weight: 600;
        border: none;
    }

    .btn-search:hover {
        background: #1d4ed8;
        color: white;
    }

    .category-table {
        margin: 0;
        white-space: nowrap;
    }

    .category-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        padding: 16px;
        border-bottom: 1px solid #e2e8f0;
    }

    .category-table tbody td {
        padding: 16px;
        color: #475569;
        font-size: 14px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .category-table tbody tr:hover {
        background: #f8fafc;
    }

    .category-name {
        color: #1e293b;
        font-weight: 600;
    }

    .category-slug {
        background: #f1f5f9;
        color: #475569;
        padding: 5px 9px;
        border-radius: 6px;
        font-size: 12px;
    }

    .category-description {
        max-width: 260px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-active {
        background: #dcfce7;
        color: #15803d;
    }

    .status-inactive {
        background: #fee2e2;
        color: #b91c1c;
    }

    .category-actions {
        display: flex;
        gap: 7px;
    }

    .category-action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        text-decoration: none;
        transition: 0.2s;
    }

    .action-view {
        background: #e0f2fe;
        color: #0284c7;
    }

    .action-edit {
        background: #fef3c7;
        color: #d97706;
    }

    .action-delete {
        background: #fee2e2;
        color: #dc2626;
    }

    .category-action-btn:hover {
        transform: translateY(-2px);
        filter: brightness(0.96);
    }

    .category-empty {
        padding: 55px 20px !important;
        text-align: center;
    }

    .category-empty i {
        font-size: 42px;
        color: #94a3b8;
        display: block;
        margin-bottom: 12px;
    }

    .category-empty h5 {
        color: #334155;
        font-weight: 700;
    }

    .category-empty p {
        color: #64748b;
        margin-bottom: 18px;
    }

    @@media (max-width: 768px) {
        .category-page {
            padding: 15px;
        }

        .category-title {
            font-size: 24px;
        }

        .category-header {
            align-items: flex-start;
        }

        .category-card-body {
            padding: 15px;
        }
    }

    /* Professional Summary Cards */

    .category-stat-card {
        position: relative;
        overflow: hidden;
        border: 1px solid transparent;
        border-radius: 14px;
        padding: 24px;
        min-height: 175px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.05);
        transition: all 0.3s ease;
    }

    /* Total Categories - Blue */
    .row.g-3.mb-4 > div:nth-child(1) .category-stat-card {
        background: linear-gradient(135deg, #eff6ff, #dbeafe);
        border-color: #bfdbfe;
    }

    .row.g-3.mb-4 > div:nth-child(1) .stat-icon {
        background: #2563eb;
        color: #ffffff;
    }

    /* Active Categories - Green */
    .row.g-3.mb-4 > div:nth-child(2) .category-stat-card {
        background: linear-gradient(135deg, #f0fdf4, #dcfce7);
        border-color: #bbf7d0;
    }

    .row.g-3.mb-4 > div:nth-child(2) .stat-icon {
        background: #16a34a;
        color: #ffffff;
    }

    /* Inactive Categories - Rose */
    .row.g-3.mb-4 > div:nth-child(3) .category-stat-card {
        background: linear-gradient(135deg, #fff1f2, #ffe4e6);
        border-color: #fecdd3;
    }

    .row.g-3.mb-4 > div:nth-child(3) .stat-icon {
        background: #e11d48;
        color: #ffffff;
    }

    /* Card Hover Effect */
    .category-stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.12);
    }

    /* Card Icon */
    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin-bottom: 16px;
        box-shadow: 0 3px 8px rgba(15, 23, 42, 0.10);
    }

    /* Card Text */
    .stat-label {
        color: #475569;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .stat-value {
        color: #0f172a;
        font-size: 32px;
        font-weight: 800;
        margin: 0;
    }

    /* Professional Search and Table Cards */
    .category-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.05);
        overflow: hidden;
    }

    .category-card-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 20px 24px;
    }

    .category-card-body {
        padding: 24px;
    }

    /* Table Hover */
    .category-table tbody tr {
        transition: background 0.2s ease;
    }

        .category-table tbody tr:hover {
            background: #eff6ff;
        }

    /* Responsive Cards */
    @@media (max-width: 768px) {
        .category-stat-card

    {
        min-height: 150px;
    }

    }

</style>

<div class="container-fluid category-page">

    <!-- Page Header -->
    <div class="category-header">
        <div>
            <h1 class="category-title">
                <i class="bi bi-folder2-open text-primary me-2"></i>
                Blog Categories
            </h1>
            <p class="category-subtitle">
                Manage and organize your blog categories.
            </p>
        </div>

        <a asp-action="CreateBlogCategory"
           class="btn-create-category">
            <i class="bi bi-plus-lg me-2"></i>
            Create Category
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="category-stat-card">
                <div class="stat-icon stat-total">
                    <i class="bi bi-folder"></i>
                </div>
                <p class="stat-label">Total Categories</p>
                <h3 class="stat-value">@totalCategories</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="category-stat-card">
                <div class="stat-icon stat-active">
                    <i class="bi bi-check-circle"></i>
                </div>
                <p class="stat-label">Active Categories</p>
                <h3 class="stat-value">@activeCategories</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="category-stat-card">
                <div class="stat-icon stat-inactive">
                    <i class="bi bi-x-circle"></i>
                </div>
                <p class="stat-label">Inactive Categories</p>
                <h3 class="stat-value">@inactiveCategories</h3>
            </div>
        </div>

    </div>

    <!-- Search Card -->
    <div class="category-card">
        <div class="category-card-header">
            <h5 class="category-card-title">
                <i class="bi bi-search me-2 text-primary"></i>
                Search Categories
            </h5>
        </div>

        <div class="category-card-body">
            <form asp-action="BlogCategories" method="get">
                <div class="row g-3">

                    <div class="col-md-9">
                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control category-search"
                               placeholder="Search by category name or slug..." />
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn-search flex-grow-1">
                            <i class="bi bi-search me-1"></i>
                            Search
                        </button>

                        <a asp-action="BlogCategories"
                           class="btn btn-outline-secondary"
                           style="height:45px; display:flex; align-items:center;">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            Reset
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- Categories Table -->
    <div class="category-card">

        <div class="category-card-header">
            <h5 class="category-card-title">
                <i class="bi bi-list-ul me-2 text-primary"></i>
                All Categories
            </h5>

            <span class="badge bg-light text-dark border">
                @totalCategories Records
            </span>
        </div>

        <div class="table-responsive">
            <table class="table category-table align-middle">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Category Name</th>
                        <th>Slug</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (categories.Any())
                    {
                        int count = 1;

                        foreach (var item in categories)
                        {
                            <tr>
                                <td>@count</td>

                                <td>
                                    <span class="category-name">
                                        @item.Name
                                    </span>
                                </td>

                                <td>
                                    <span class="category-slug">
                                        @item.Slug
                                    </span>
                                </td>

                                <td>
                                    <div class="category-description"
                                         title="@item.Description">
                                        @(string.IsNullOrWhiteSpace(item.Description)
                                            ? "No description"
                                            : item.Description)
                                    </div>
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <div class="category-actions justify-content-center">

                                        <a asp-action="BlogCategoryDetails"
                                           asp-route-id="@item.Id"
                                           class="category-action-btn action-view"
                                           title="View Details"
                                           aria-label="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="EditBlogCategory"
                                           asp-route-id="@item.Id"
                                           class="category-action-btn action-edit"
                                           title="Edit Category"
                                           aria-label="Edit Category">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="DeleteBlogCategory"
                                           asp-route-id="@item.Id"
                                           class="category-action-btn action-delete"
                                           title="Delete Category"
                                           aria-label="Delete Category">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>

                            count++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="category-empty">
                                <i class="bi bi-folder-x"></i>
                                <h5>No Categories Found</h5>
                                <p>
                                    There are no blog categories to display.
                                    Create your first category to get started.
                                </p>
                                <a asp-action="CreateBlogCategory"
                                   class="btn btn-primary">
                                    <i class="bi bi-plus-lg me-1"></i>
                                    Create Category
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>
