@model IEnumerable<CMSPanel.Models.News>

@{
    ViewData["Title"] = "News";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">News & Press Releases</h2>
            <p class="text-muted">Manage news and press releases</p>
        </div>

        <a asp-action="CreateNews" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add News
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="News" method="get">
                <div class="row g-3">
                    <div class="col-md-5">
                        <input type="text"
                               name="searchString"
                               value="@Context.Request.Query["searchString"]"
                               class="form-control"
                               placeholder="Search news..." />
                    </div>

                    <div class="col-md-4">
                        <select name="status" class="form-select">
                            <option value="">All Statuses</option>
                            <option value="Draft">Draft</option>
                            <option value="Published">Published</option>
                            <option value="Archived">Archived</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary">
                            Search
                        </button>
                        <a asp-action="News" class="btn btn-secondary">
                            Reset
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Category</th>
                            <th>Publication Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.Title</strong>
                                    </td>
                                    <td>@item.Author</td>
                                    <td>@item.Category</td>
                                    <td>
                                        @item.PublicationDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        @if (item.Status == "Published")
                                        {
                                            <span class="badge bg-success">Published</span>
                                        }
                                        else if (item.Status == "Archived")
                                        {
                                            <span class="badge bg-secondary">Archived</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @item.Status
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="NewsDetails"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info text-white">
                                                View
                                            </a>

                                            <a asp-action="EditNews"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            
                                            <form asp-action="DeleteNews"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this news?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash3"></i> Delete
                                                </button>
                                            </form>
                                            
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No news found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
