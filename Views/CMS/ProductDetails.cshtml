
@model CMSPanel.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<style>
    .product-details-page {
        padding: 28px;
        min-height: calc(100vh - 70px);
        background: #f5f7fb;
        color: #172033;
    }

    .pd-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }

    .pd-breadcrumb {
        font-size: 12px;
        color: #94a3b8;
        margin-bottom: 8px;
    }

    .pd-breadcrumb a {
        color: #4f46e5;
        text-decoration: none;
    }

    .pd-title {
        font-size: 28px;
        font-weight: 750;
        letter-spacing: -.5px;
        margin: 0 0 6px;
        color: #172033;
    }

    .pd-subtitle {
        color: #718096;
        font-size: 14px;
        margin: 0;
    }

    .pd-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
        cursor: pointer;
        transition: .2s;
        white-space: nowrap;
    }

    .pd-btn-back {
        color: #475569;
        background: #fff;
        border: 1px solid #e2e8f0;
    }

    .pd-btn-back:hover {
        background: #f8fafc;
        color: #172033;
    }

    .pd-btn-edit {
        color: #fff;
        background: #4f46e5;
        border: 1px solid #4f46e5;
    }

    .pd-btn-edit:hover {
        color: #fff;
        background: #4338ca;
        border-color: #4338ca;
    }

    .pd-card {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .025);
        overflow: hidden;
    }

    .pd-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .pd-card-title {
        font-size: 15px;
        font-weight: 750;
        color: #172033;
        margin: 0;
    }

    .pd-card-body {
        padding: 24px;
    }

    .pd-overview-image {
        min-height: 330px;
        height: 100%;
        padding: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        border: 1px solid #edf0f5;
        border-radius: 12px;
    }

    .pd-overview-image img {
        display: block;
        max-width: 100%;
        max-height: 300px;
        object-fit: contain;
    }

    .pd-no-image {
        text-align: center;
        color: #94a3b8;
        font-size: 13px;
    }

    .pd-no-image i {
        display: block;
        font-size: 52px;
        margin-bottom: 12px;
    }

    .pd-product-name {
        color: #172033;
        font-size: 25px;
        line-height: 1.4;
        font-weight: 750;
        letter-spacing: -.4px;
        margin: 0 0 12px;
        overflow-wrap: anywhere;
    }

    .pd-sku-line {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        color: #718096;
        font-size: 13px;
    }

    .pd-sku {
        display: inline-block;
        padding: 5px 9px;
        background: #f1f5f9;
        border-radius: 6px;
        color: #475569;
        font-size: 12px;
        font-weight: 650;
    }

    .pd-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 750;
        white-space: nowrap;
    }

    .pd-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .pd-active {
        background: #e8f8ee;
        color: #16864a;
    }

    .pd-inactive {
        background: #f1f5f9;
        color: #64748b;
    }

    .pd-price-area {
        padding: 19px 0;
        margin-top: 22px;
        border-top: 1px solid #edf0f5;
        border-bottom: 1px solid #edf0f5;
    }

    .pd-price-label {
        color: #718096;
        font-size: 13px;
        margin-bottom: 5px;
    }

    .pd-price {
        color: #172033;
        font-size: 32px;
        line-height: 1.3;
        font-weight: 800;
        letter-spacing: -.6px;
        overflow-wrap: anywhere;
    }

    .pd-short-description {
        margin-top: 20px;
        color: #64748b;
        font-size: 13px;
        line-height: 1.8;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .pd-summary-label {
        font-size: 11px;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: .6px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .pd-summary-value {
        color: #172033;
        font-size: 14px;
        font-weight: 700;
    }

    .pd-inventory-card {
        padding: 21px;
        height: 100%;
        border-radius: 12px;
        background: #fff;
        border: 1px solid #e8edf5;
        box-shadow: 0 3px 12px rgba(15, 23, 42, .025);
    }

    .pd-inventory-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
    }

    .pd-inventory-label {
        color: #718096;
        font-size: 13px;
        font-weight: 600;
    }

    .pd-inventory-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eeebff;
        color: #4f46e5;
        border-radius: 10px;
        font-size: 19px;
    }

    .pd-inventory-number {
        color: #172033;
        font-size: 27px;
        line-height: 1.2;
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .pd-inventory-note {
        color: #94a3b8;
        font-size: 12px;
        margin-top: 7px;
    }

    .pd-info-row {
        display: grid;
        grid-template-columns: minmax(160px, 230px) minmax(0, 1fr);
        gap: 22px;
        padding: 18px 0;
        border-bottom: 1px solid #edf0f5;
    }

    .pd-info-row:first-child {
        padding-top: 0;
    }

    .pd-info-row:last-child {
        padding-bottom: 0;
        border-bottom: none;
    }

    .pd-info-label {
        color: #718096;
        font-size: 13px;
        font-weight: 650;
    }

    .pd-info-value {
        color: #334155;
        font-size: 13px;
        line-height: 1.8;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
    }

    .pd-record-box {
        padding: 18px;
        height: 100%;
        background: #f8fafc;
        border: 1px solid #edf0f5;
        border-radius: 10px;
    }

    .pd-record-label {
        color: #718096;
        font-size: 12px;
        margin-bottom: 9px;
    }

    .pd-record-value {
        color: #334155;
        font-size: 13px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .pd-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 24px;
    }

    .pd-footer-note {
        color: #94a3b8;
        font-size: 12px;
        margin: 0;
    }

    @@media (max-width: 767px) {
        .product-details-page {
            padding: 16px;
        }

        .pd-title {
            font-size: 23px;
        }

        .pd-card-body {
            padding: 18px;
        }

        .pd-card-header {
            padding: 17px 18px;
        }

        .pd-overview-image {
            min-height: 230px;
        }

        .pd-overview-image img {
            max-height: 210px;
        }

        .pd-product-name {
            font-size: 21px;
        }

        .pd-price {
            font-size: 27px;
        }

        .pd-info-row {
            grid-template-columns: 1fr;
            gap: 6px;
        }
    }
</style>

<div class="product-details-page">

    <!-- Header -->
    <div class="pd-header">
        <div>
            <div class="pd-breadcrumb">
                <a asp-action="Products">Product Management</a>
                <span class="mx-1">/</span>
                <span>Product Details</span>
            </div>

            <h1 class="pd-title">Product Details</h1>
            <p class="pd-subtitle">
                View product information, pricing and inventory details.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Products" class="pd-btn pd-btn-back">
                <i class="bi bi-arrow-left"></i>
                Back to Products
            </a>

            <a asp-action="EditProduct"
               asp-route-id="@Model.Id"
               class="pd-btn pd-btn-edit">
                <i class="bi bi-pencil-square"></i>
                Edit Product
            </a>
        </div>
    </div>

    <!-- Product Overview -->
    <div class="pd-card mb-4">
        <div class="pd-card-header">
            <h5 class="pd-card-title">
                <i class="bi bi-box-seam me-2"
                   style="color:#4f46e5"></i>
                Product Overview
            </h5>

            @if (Model.IsActive)
            {
                <span class="pd-status pd-active">
                    <span class="pd-status-dot"></span>
                    Active Product
                </span>
            }
            else
            {
                <span class="pd-status pd-inactive">
                    <span class="pd-status-dot"></span>
                    Inactive Product
                </span>
            }
        </div>

        <div class="pd-card-body">
            <div class="row g-4 align-items-stretch">

                <!-- Left: Image -->
                <div class="col-12 col-lg-5">
                    <div class="pd-overview-image">
                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl"
                                 alt="@Model.ProductName" />
                        }
                        else
                        {
                            <div class="pd-no-image">
                                <i class="bi bi-image"></i>
                                <div>No product image available</div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Right: Product Summary -->
                <div class="col-12 col-lg-7">
                    <div class="h-100 d-flex flex-column">
                        <h2 class="pd-product-name">
                            @Model.ProductName
                        </h2>

                        <div class="pd-sku-line">
                            <span>SKU</span>
                            <span class="pd-sku">
                                @(string.IsNullOrWhiteSpace(Model.SKU)
                                    ? "Not assigned"
                                    : Model.SKU)
                            </span>
                        </div>

                        <div class="pd-price-area">
                            <div class="pd-price-label">Selling Price</div>
                            <div class="pd-price">
                                ₹@Model.Price.ToString("N2")
                            </div>
                        </div>

                        <div class="row g-3 mt-2">
                            <div class="col-sm-6">
                                <div class="pd-summary-label">Product ID</div>
                                <div class="pd-summary-value">#@Model.Id</div>
                            </div>

                            <div class="col-sm-6">
                                <div class="pd-summary-label">Display Order</div>
                                <div class="pd-summary-value">@Model.DisplayOrder</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                        {
                            <div class="pd-short-description">
                                @Model.ShortDescription
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Inventory -->
    <div class="mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="pd-card-title">
                <i class="bi bi-bar-chart-line me-2"
                   style="color:#4f46e5"></i>
                Inventory Summary
            </h5>
        </div>

        <div class="row g-3">
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="pd-inventory-card">
                    <div class="pd-inventory-top">
                        <span class="pd-inventory-label">Stock Quantity</span>
                        <span class="pd-inventory-icon">
                            <i class="bi bi-boxes"></i>
                        </span>
                    </div>
                    <div class="pd-inventory-number">
                        @Model.StockQuantity.ToString("N0")
                    </div>
                    <div class="pd-inventory-note">
                        Total units recorded for this product
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-4">
                <div class="pd-inventory-card">
                    <div class="pd-inventory-top">
                        <span class="pd-inventory-label">Product Price</span>
                        <span class="pd-inventory-icon">
                            <i class="bi bi-currency-rupee"></i>
                        </span>
                    </div>
                    <div class="pd-inventory-number">
                        ₹@Model.Price.ToString("N2")
                    </div>
                    <div class="pd-inventory-note">
                        Current listed selling price
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-4">
                <div class="pd-inventory-card">
                    <div class="pd-inventory-top">
                        <span class="pd-inventory-label">Publication Status</span>
                        <span class="pd-inventory-icon">
                            <i class="bi bi-toggle-on"></i>
                        </span>
                    </div>

                    <div class="pd-inventory-number" style="font-size:22px">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </div>

                    <div class="pd-inventory-note">
                        Current product availability status
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Full Details -->
    <div class="pd-card mb-4">
        <div class="pd-card-header">
            <h5 class="pd-card-title">
                <i class="bi bi-card-text me-2"
                   style="color:#4f46e5"></i>
                Product Information
            </h5>
        </div>

        <div class="pd-card-body">

            <div class="pd-info-row">
                <div class="pd-info-label">Product Name</div>
                <div class="pd-info-value fw-semibold">
                    @Model.ProductName
                </div>
            </div>

            <div class="pd-info-row">
                <div class="pd-info-label">SKU</div>
                <div class="pd-info-value">
                    @(string.IsNullOrWhiteSpace(Model.SKU)
                        ? "—"
                        : Model.SKU)
                </div>
            </div>

            <div class="pd-info-row">
                <div class="pd-info-label">Short Description</div>
                <div class="pd-info-value">
                    @(string.IsNullOrWhiteSpace(Model.ShortDescription)
                        ? "No short description provided."
                        : Model.ShortDescription)
                </div>
            </div>

            <div class="pd-info-row">
                <div class="pd-info-label">Full Description</div>
                <div class="pd-info-value">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No product description provided."
                        : Model.Description)
                </div>
            </div>

            <div class="pd-info-row">
                <div class="pd-info-label">Display Order</div>
                <div class="pd-info-value">@Model.DisplayOrder</div>
            </div>

            <div class="pd-info-row">
                <div class="pd-info-label">Status</div>
                <div class="pd-info-value">
                    @if (Model.IsActive)
                    {
                        <span class="pd-status pd-active">
                            <span class="pd-status-dot"></span>
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="pd-status pd-inactive">
                            <span class="pd-status-dot"></span>
                            Inactive
                        </span>
                    }
                </div>
            </div>

        </div>
    </div>

    <!-- Record Information -->
    <div class="pd-card">
        <div class="pd-card-header">
            <h5 class="pd-card-title">
                <i class="bi bi-clock-history me-2"
                   style="color:#4f46e5"></i>
                Record Information
            </h5>
        </div>

        <div class="pd-card-body">
            <div class="row g-3">

                <div class="col-12 col-md-6">
                    <div class="pd-record-box">
                        <div class="pd-record-label">
                            <i class="bi bi-calendar-plus me-1"></i>
                            Created At
                        </div>
                        <div class="pd-record-value">
                            @Model.CreatedAt.ToLocalTime()
                            .ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="pd-record-box">
                        <div class="pd-record-label">
                            <i class="bi bi-calendar-check me-1"></i>
                            Last Updated
                        </div>
                        <div class="pd-record-value">
                            @(Model.UpdatedAt.HasValue
                                ? Model.UpdatedAt.Value.ToLocalTime()
                                .ToString("dd MMM yyyy, hh:mm tt")
                                : "Not updated yet")
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Footer Actions -->
    <div class="pd-footer">
        <p class="pd-footer-note">
            <i class="bi bi-info-circle me-1"></i>
            Product ID: @Model.Id
        </p>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Products" class="pd-btn pd-btn-back">
                <i class="bi bi-arrow-left"></i>
                Back to Products
            </a>

            <a asp-action="EditProduct"
               asp-route-id="@Model.Id"
               class="pd-btn pd-btn-edit">
                <i class="bi bi-pencil-square"></i>
                Edit Product
            </a>
        </div>
    </div>

</div>
