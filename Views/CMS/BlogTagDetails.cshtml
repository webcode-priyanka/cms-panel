@model CMSPanel.Models.BlogTag

@{
    ViewData["Title"] = "Blog Tag Details";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Blog Tag Details</h1>
        <p class="text-muted">View tag information</p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold text-muted">
                        Tag Name
                    </label>

                    <div class="fs-5">
                        @Model.Name
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold text-muted">
                        Slug
                    </label>

                    <div class="fs-5">
                        @Model.Slug
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold text-muted">
                        Status
                    </label>

                    <div>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactive
                            </span>
                        }
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold text-muted">
                        Created At
                    </label>

                    <div>
                        @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="fw-semibold text-muted">
                        Updated At
                    </label>

                    <div>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            @Model.UpdatedAt.Value.ToString("dd MMM yyyy hh:mm tt")
                        }
                        else
                        {
                            <span class="text-muted">
                                Not updated
                            </span>
                        }
                         
                    </div>
                </div>

            </div>

            <div class="mt-3">

                <a asp-action="EditBlogTag"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary me-2">
                    <i class="bi bi-pencil me-1"></i>
                    Edit
                </a>

                <a asp-action="BlogTags"
                   class="btn btn-secondary">
                    Back
                </a>

            </div>

        </div>

    </div>

</div>
