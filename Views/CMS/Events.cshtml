@model IEnumerable<CMSPanel.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Events</h1>
            <p class="text-muted">Manage your events</p>
        </div>

        <a asp-action="CreateEvent"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create Event
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="Events" method="get">
                <div class="row g-2">
                    <div class="col-md-10">
                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Search by title, location, description or status..." />
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Search
                        </button>

                        <a asp-action="Events"
                           class="btn btn-secondary">
                            Reset
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Events Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Location</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Image))
                                        {
                                            <img src="@item.Image"
                                                 alt="@item.Title"
                                                 style="width:60px;height:50px;object-fit:cover;"
                                                 class="rounded" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">No Image</span>
                                        }
                                    </td>

                                    <td class="fw-semibold">
                                        @item.Title
                                    </td>

                                    <td>@item.Location</td>

                                    <td>
                                        @item.StartDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @(item.EndDate?.ToString("dd MMM yyyy") ?? "N/A")
                                    </td>

                                    <td>
                                        @if (item.Status == "Published")
                                        {
                                            <span class="badge bg-success">Published</span>
                                        }
                                        else if (item.Status == "Draft")
                                        {
                                            <span class="badge bg-secondary">Draft</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @item.Status
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="EventDetails"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info text-white"
                                               title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="EditEvent"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <form asp-action="DeleteEvent"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this event?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-danger">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <i class="bi bi-calendar-event fs-1 text-muted"></i>
                                    <p class="text-muted mt-2 mb-0">
                                        No events found.
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-muted">
                Total Events: @(Model?.Count() ?? 0)
            </div>

        </div>
    </div>
</div>
