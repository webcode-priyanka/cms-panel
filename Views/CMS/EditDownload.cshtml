
@model CMSPanel.Models.Download

@{
    ViewData["Title"] = "Edit Download";
}

<style>
    .edit-download-page {
        padding: 28px 0;
    }

    .page-heading {
        margin-bottom: 28px;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 6px;
    }

    .page-subtitle {
        color: #64748b;
        margin: 0;
    }

    .form-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
        overflow: hidden;
        margin-bottom: 24px;
    }

    .form-card-header {
        padding: 22px 26px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .form-card-body {
        padding: 26px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #1e293b;
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .section-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #e8efff;
        color: #3157c8;
        font-size: 18px;
    }

    .form-label {
        color: #334155;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        min-height: 44px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        color: #1e293b;
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #6485ed;
        box-shadow: 0 0 0 3px rgba(49, 87, 200, 0.12);
    }

    .field-help {
        color: #64748b;
        font-size: 12px;
        margin-top: 6px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
        padding-top: 20px;
        margin-top: 10px;
        border-top: 1px solid #e2e8f0;
    }

    .action-btn {
        border-radius: 9px;
        padding: 10px 17px;
        font-weight: 600;
    }

    .required-mark {
        color: #dc2626;
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 23px;
        }

        .form-card-header,
        .form-card-body {
            padding: 18px;
        }

        .form-actions {
            justify-content: stretch;
        }

            .form-actions .btn {
                flex: 1;
            }
    }
</style>

<div class="container-fluid edit-download-page">

    <!-- Page Heading -->
    <div class="page-heading">
        <div class="d-flex align-items-center gap-3 mb-2">
            <div class="section-icon">
                <i class="bi bi-pencil-square"></i>
            </div>

            <div>
                <h2 class="page-title">Edit Download</h2>
                <p class="page-subtitle">
                    Update document details, file information and status.
                </p>
            </div>
        </div>
    </div>

    <form asp-action="EditDownload" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <!-- Validation -->
        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger mb-4"></div>

        <!-- Document Information -->
        <div class="form-card">
            <div class="form-card-header">
                <h5 class="section-title mb-0">
                    <span class="section-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </span>
                    Document Information
                </h5>
            </div>

            <div class="form-card-body">
                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label">
                            Document Title <span class="required-mark">*</span>
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Enter document title" />

                        <span asp-validation-for="Title"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label">
                            Category
                        </label>

                        <input asp-for="Category"
                               class="form-control"
                               placeholder="e.g. Policies, Reports, Forms" />

                        <span asp-validation-for="Category"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Enter a description for this document"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small"></span>

                        <div class="field-help">
                            Provide a short explanation of the document.
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- File Information -->
        <div class="form-card">
            <div class="form-card-header">
                <h5 class="section-title mb-0">
                    <span class="section-icon">
                        <i class="bi bi-folder2-open"></i>
                    </span>
                    File Information
                </h5>
            </div>

            <div class="form-card-body">
                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="FileName" class="form-label">
                            File Name
                        </label>

                        <input asp-for="FileName"
                               class="form-control"
                               placeholder="e.g. company-policy.pdf" />

                        <span asp-validation-for="FileName"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FilePath" class="form-label">
                            File Path
                        </label>

                        <input asp-for="FilePath"
                               class="form-control"
                               placeholder="Enter the existing file path" />

                        <span asp-validation-for="FilePath"
                              class="text-danger small"></span>

                        <div class="field-help">
                            Enter the path used by your application to locate the file.
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Status Settings -->
        <div class="form-card">
            <div class="form-card-header">
                <h5 class="section-title mb-0">
                    <span class="section-icon">
                        <i class="bi bi-toggles"></i>
                    </span>
                    Publication Settings
                </h5>
            </div>

            <div class="form-card-body">
                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">
                            Document Status
                        </label>

                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger small"></span>

                        <div class="field-help">
                            Choose whether this document should be active or inactive.
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="form-card">
            <div class="form-card-body">
                <div class="form-actions">
                    <a asp-action="Downloads"
                       class="btn btn-outline-secondary action-btn">
                        <i class="bi bi-x-circle me-1"></i>
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary action-btn">
                        <i class="bi bi-check2-circle me-1"></i>
                        Update Download
                    </button>
                </div>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
