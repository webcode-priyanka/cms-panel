@model IEnumerable<CMSPanel.Models.Gallery>

@{
    ViewData["Title"] = "Gallery";

    var galleries = Model?.ToList()
                    ?? new List<CMSPanel.Models.Gallery>();

    var totalImages = galleries.Count;
    var activeImages = galleries.Count(x => x.IsActive);
    var inactiveImages = totalImages - activeImages;
    var totalCategories = galleries
        .Where(x => !string.IsNullOrWhiteSpace(x.Category))
        .Select(x => x.Category)
        .Distinct()
        .Count();
}

<style>
    .gallery-page {
        padding: 10px 4px 30px;
    }

    .gallery-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

        .gallery-heading h2 {
            color: #172033;
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .gallery-heading p {
            color: #778196;
            font-size: 14px;
            margin: 0;
        }

    .btn-create-gallery {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        background: #2563eb;
        border: 1px solid #2563eb;
        border-radius: 8px;
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: 0.2s;
    }

        .btn-create-gallery:hover {
            background: #1d4ed8;
            border-color: #1d4ed8;
            color: #fff;
            transform: translateY(-1px);
        }

    .gallery-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 25px;
    }

    .gallery-stat-card {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        background: #fff;
        border: 1px solid #e9edf5;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    }

    .gallery-stat-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 21px;
        flex-shrink: 0;
    }

    .stat-icon-total {
        background: #e8efff;
        color: #2563eb;
    }

    .stat-icon-active {
        background: #dcfce7;
        color: #16a34a;
    }

    .stat-icon-inactive {
        background: #f1f5f9;
        color: #64748b;
    }

    .stat-icon-category {
        background: #f3e8ff;
        color: #9333ea;
    }

    .gallery-stat-label {
        color: #7b8497;
        font-size: 13px;
        margin-bottom: 5px;
    }

    .gallery-stat-number {
        color: #172033;
        font-size: 25px;
        font-weight: 700;
        line-height: 1.2;
    }

    .gallery-card {
        background: #fff;
        border: 1px solid #e9edf5;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        overflow: hidden;
    }

    .gallery-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 20px 22px;
        border-bottom: 1px solid #edf0f5;
    }

        .gallery-card-header h5 {
            color: #172033;
            font-size: 16px;
            font-weight: 700;
            margin: 0 0 4px;
        }

        .gallery-card-header p {
            color: #8791a3;
            font-size: 13px;
            margin: 0;
        }

    .gallery-filter-form {
        padding: 20px 22px;
        background: #fff;
        border-bottom: 1px solid #edf0f5;
    }

        .gallery-filter-form .form-label {
            color: #475569;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .gallery-filter-form .form-control,
        .gallery-filter-form .form-select {
            min-height: 42px;
            border: 1px solid #dfe5ee;
            border-radius: 7px;
            font-size: 13px;
            color: #334155;
        }

            .gallery-filter-form .form-control:focus,
            .gallery-filter-form .form-select:focus {
                border-color: #93b4ff;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
            }

    .btn-search-gallery {
        min-height: 42px;
        border-radius: 7px;
        background: #2563eb;
        border-color: #2563eb;
        font-size: 13px;
        font-weight: 600;
    }

        .btn-search-gallery:hover {
            background: #1d4ed8;
            border-color: #1d4ed8;
        }

    .btn-clear-gallery {
        min-height: 42px;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 600;
    }

    .gallery-table-wrapper {
        padding: 0 22px 12px;
    }

    .gallery-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .gallery-table thead th {
            padding: 15px 13px;
            background: #f8fafc;
            color: #64748b;
            border-bottom: 1px solid #e8edf4;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .gallery-table tbody td {
            padding: 15px 13px;
            color: #334155;
            border-bottom: 1px solid #edf0f5;
            font-size: 13px;
            vertical-align: middle;
        }

        .gallery-table tbody tr:hover {
            background: #f8faff;
        }

    .gallery-image {
        width: 76px;
        height: 58px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
    }

    .gallery-image-placeholder {
        width: 76px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 23px;
    }

    .gallery-title {
        color: #1e293b;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .gallery-description {
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.5;
    }

    .gallery-category {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        background: #e0f2fe;
        color: #0369a1;
        font-size: 11px;
        font-weight: 600;
    }

    .gallery-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .gallery-status-active {
        background: #dcfce7;
        color: #15803d;
    }

    .gallery-status-inactive {
        background: #f1f5f9;
        color: #64748b;
    }

    .gallery-actions {
        display: flex;
        justify-content: flex-end;
        gap: 7px;
    }

    .gallery-action-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        border-radius: 7px;
        text-decoration: none;
        font-size: 14px;
        transition: 0.2s;
    }

        .gallery-action-btn:hover {
            transform: translateY(-1px);
            filter: brightness(0.97);
        }

    .gallery-view-btn {
        background: #e0f2fe;
        border-color: #bae6fd;
        color: #0284c7;
    }

    .gallery-edit-btn {
        background: #fef3c7;
        border-color: #fde68a;
        color: #b45309;
    }

    .gallery-delete-btn {
        background: #fee2e2;
        border-color: #fecaca;
        color: #dc2626;
    }

    .gallery-empty {
        padding: 50px 20px !important;
        text-align: center;
    }

        .gallery-empty i {
            display: block;
            color: #94a3b8;
            font-size: 42px;
            margin-bottom: 12px;
        }

        .gallery-empty h6 {
            color: #334155;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .gallery-empty p {
            color: #94a3b8;
            font-size: 13px;
            margin: 0;
        }

    .gallery-footer {
        padding: 13px 22px;
        border-top: 1px solid #edf0f5;
        color: #94a3b8;
        font-size: 12px;
    }

    @@media (max-width: 1100px) {
        .gallery-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .gallery-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .gallery-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .gallery-stats {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .gallery-filter-form {
            padding: 15px;
        }

        .gallery-table-wrapper {
            padding: 0 12px 12px;
        }
    }
</style>

<div class="container-fluid gallery-page">

    <!-- Page Header -->
    <div class="gallery-heading">
        <div>
            <h2>Gallery</h2>
            <p>Manage and organize your gallery images</p>
        </div>

        <a asp-controller="CMS"
           asp-action="CreateGallery"
           class="btn-create-gallery">
            <i class="bi bi-plus-circle"></i>
            Create Gallery
        </a>
    </div>

    <!-- Statistics -->
    <div class="gallery-stats">

        <div class="gallery-stat-card">
            <div class="gallery-stat-icon stat-icon-total">
                <i class="bi bi-images"></i>
            </div>
            <div>
                <div class="gallery-stat-label">Total Images</div>
                <div class="gallery-stat-number">@totalImages</div>
            </div>
        </div>

        <div class="gallery-stat-card">
            <div class="gallery-stat-icon stat-icon-active">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <div class="gallery-stat-label">Active Images</div>
                <div class="gallery-stat-number">@activeImages</div>
            </div>
        </div>

        <div class="gallery-stat-card">
            <div class="gallery-stat-icon stat-icon-inactive">
                <i class="bi bi-pause-circle"></i>
            </div>
            <div>
                <div class="gallery-stat-label">Inactive Images</div>
                <div class="gallery-stat-number">@inactiveImages</div>
            </div>
        </div>

        <div class="gallery-stat-card">
            <div class="gallery-stat-icon stat-icon-category">
                <i class="bi bi-collection"></i>
            </div>
            <div>
                <div class="gallery-stat-label">Categories</div>
                <div class="gallery-stat-number">@totalCategories</div>
            </div>
        </div>

    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Gallery Card -->
    <div class="gallery-card">

        <!-- Card Header -->
        <div class="gallery-card-header">
            <div>
                <h5>Gallery Images</h5>
                <p>View, search and manage your images</p>
            </div>
        </div>

        <!-- Search and Category Filter -->
        <div class="gallery-filter-form">

            <form asp-controller="CMS"
                  asp-action="Gallery"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-5 col-md-6">
                        <label class="form-label">Search Images</label>
                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Search by title or description..." />
                    </div>

                    <div class="col-lg-4 col-md-4">
                        <label class="form-label">Category</label>

                        <select name="category" class="form-select">
                            <option value="">All Categories</option>

                            @if (ViewBag.Categories != null)
                            {
                                foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category"
                                            selected="@(ViewBag.Category == category ? "selected" : null)">
                                        @category
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-2">
                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary btn-search-gallery flex-grow-1">
                                <i class="bi bi-search me-1"></i>
                                Search
                            </button>

                            <a asp-controller="CMS"
                               asp-action="Gallery"
                               class="btn btn-outline-secondary btn-clear-gallery">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                Clear
                            </a>
                        </div>
                    </div>

                </div>
            </form>
        </div>

        <!-- Table -->
        <div class="gallery-table-wrapper">
            <div class="table-responsive">
                <table class="table gallery-table">

                    <thead>
                        <tr>
                            <th style="width: 55px;">#</th>
                            <th style="width: 110px;">Image</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Created Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (galleries.Any())
                        {
                            var count = 1;

                            foreach (var gallery in galleries)
                            {
                                <tr>
                                    <td>@count</td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(gallery.ImageUrl))
                                        {
                                            <img src="@gallery.ImageUrl"
                                                 alt="@gallery.Title"
                                                 class="gallery-image" />
                                        }
                                        else
                                        {
                                            <div class="gallery-image-placeholder">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div class="gallery-title">
                                            @gallery.Title
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(gallery.Description))
                                        {
                                            <div class="gallery-description">
                                                @(gallery.Description.Length > 80
                                                    ? gallery.Description.Substring(0, 80) + "..."
                                                    : gallery.Description)
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(gallery.Category))
                                        {
                                            <span class="gallery-category">
                                                @gallery.Category
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        @if (gallery.IsActive)
                                        {
                                            <span class="gallery-status gallery-status-active">
                                                <i class="bi bi-circle-fill"></i>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="gallery-status gallery-status-inactive">
                                                <i class="bi bi-circle-fill"></i>
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @gallery.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        <div class="gallery-actions">

                                            <a asp-controller="CMS"
                                               asp-action="GalleryDetails"
                                               asp-route-id="@gallery.Id"
                                               class="gallery-action-btn gallery-view-btn"
                                               title="View">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-controller="CMS"
                                               asp-action="EditGallery"
                                               asp-route-id="@gallery.Id"
                                               class="gallery-action-btn gallery-edit-btn"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>


                                            <form asp-controller="CMS"
                                                  asp-action="DeleteGallery"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this gallery item?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="id" value="@gallery.Id" />

                                                <button type="submit"
                                                        class="gallery-action-btn gallery-delete-btn"
                                                        title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>


                                        </div>
                                    </td>
                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="gallery-empty">
                                    <i class="bi bi-images"></i>
                                    <h6>No Gallery Images Found</h6>
                                    <p>There are no images to display.</p>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>

        <!-- Footer -->
        <div class="gallery-footer">
            Showing @totalImages gallery item(s)
        </div>

    </div>
</div>