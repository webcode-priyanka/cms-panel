@model CMSPanel.Models.Blog

@{
    ViewData["Title"] = "Delete Blog";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="fw-bold text-danger">Delete Blog</h1>
        <p class="text-muted">Confirm blog deletion</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="alert alert-warning">
                Are you sure you want to delete this blog?
            </div>

            <dl class="row">

                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Slug</dt>
                <dd class="col-sm-9">@Model.Slug</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy")
                </dd>

            </dl>

            
            <form asp-action="DeleteBlog" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i>
                    Delete Blog
                </button>

                <a asp-action="Blogs"
                   class="btn btn-secondary ms-2">
                    Cancel
                </a>

            </form>
            


        </div>
    </div>

</div>
