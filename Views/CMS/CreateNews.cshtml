@model CMSPanel.Models.News

@{
    ViewData["Title"] = "Create News";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Create News</h2>
        <p class="text-muted">Add a new news article or press release.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-action="CreateNews" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Title" class="form-label">Title</label>
                        <input asp-for="Title" class="form-control"
                               placeholder="Enter news title" />
                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Slug" class="form-label">Slug</label>
                        <input asp-for="Slug" class="form-control"
                               placeholder="news-url-slug" />
                        <span asp-validation-for="Slug"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Author" class="form-label">Author</label>
                        <input asp-for="Author" class="form-control"
                               placeholder="Enter author name" />
                        <span asp-validation-for="Author"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Category" class="form-label">Category</label>
                        <input asp-for="Category" class="form-control"
                               placeholder="Enter category" />
                        <span asp-validation-for="Category"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PublicationDate"
                               class="form-label">Publication Date</label>
                        <input asp-for="PublicationDate" type="date"
                               class="form-control" />
                        <span asp-validation-for="PublicationDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Draft">Draft</option>
                            <option value="Published">Published</option>
                            <option value="Archived">Archived</option>
                        </select>
                        <span asp-validation-for="Status"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Excerpt" class="form-label">Excerpt</label>
                        <textarea asp-for="Excerpt" class="form-control"
                                  rows="3"
                                  placeholder="Enter a short summary"></textarea>
                        <span asp-validation-for="Excerpt"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Content" class="form-label">Content</label>
                        <textarea asp-for="Content" class="form-control"
                                  rows="8"
                                  placeholder="Write news content here"></textarea>
                        <span asp-validation-for="Content"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Image" class="form-label">Image Path</label>
                        <input asp-for="Image" class="form-control"
                               placeholder="Enter image path" />
                        <span asp-validation-for="Image"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Attachment"
                               class="form-label">Attachment Path</label>
                        <input asp-for="Attachment" class="form-control"
                               placeholder="Enter attachment path" />
                        <span asp-validation-for="Attachment"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="MetaTitle"
                               class="form-label">Meta Title</label>
                        <input asp-for="MetaTitle" class="form-control"
                               placeholder="Enter meta title" />
                        <span asp-validation-for="MetaTitle"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="MetaDescription"
                               class="form-label">Meta Description</label>
                        <textarea asp-for="MetaDescription"
                                  class="form-control" rows="2"
                                  placeholder="Enter meta description"></textarea>
                        <span asp-validation-for="MetaDescription"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Save News
                    </button>

                    <a asp-action="News" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
