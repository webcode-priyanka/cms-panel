@model CMSPanel.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h1 class="fw-bold text-danger">Delete Product</h1>
        <p class="text-muted">Confirm before deleting this product</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="alert alert-warning">
                Are you sure you want to delete this product?
            </div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-3">
                    <img src="@Model.ImageUrl"
                         alt="@Model.ProductName"
                         style="width:100px;height:100px;object-fit:cover;"
                         class="rounded" />
                </div>
            }

            <dl class="row">
                <dt class="col-sm-3">Product Name</dt>
                <dd class="col-sm-9">@Model.ProductName</dd>

                <dt class="col-sm-3">SKU</dt>
                <dd class="col-sm-9">@(Model.SKU ?? "-")</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">₹@Model.Price.ToString("N2")</dd>

                <dt class="col-sm-3">Stock Quantity</dt>
                <dd class="col-sm-9">@Model.StockQuantity</dd>
            </dl>

            <form asp-action="DeleteProduct" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Yes, Delete
                </button>
                <a asp-action="Products" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
