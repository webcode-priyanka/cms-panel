@model IEnumerable<CMSPanel.Models.CareerApplication>

@{
    ViewData["Title"] = "Career Applications";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Career Applications</h1>
            <p class="text-muted mb-0">
                Manage job applications
            </p>
        </div>

        <a asp-action="CreateCareerApplication"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Application
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-action="CareerApplications"
                  method="get"
                  class="row g-3">

                <div class="col-md-5">
                    <label class="form-label">
                        Search
                    </label>

                    <input type="text"
                           name="searchString"
                           value="@ViewBag.SearchString"
                           class="form-control"
                           placeholder="Applicant name, email or job title" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        Status
                    </label>

                    <select name="status"
                            class="form-select">

                        <option value="">
                            All Statuses
                        </option>


                        @{
                            var statuses = ViewBag.Statuses as IEnumerable<string>
                            ?? new[] { "Pending", "Shortlisted", "Rejected", "Hired" };
                        }

                        @foreach (var item in statuses)
                        {
                            <option value="@item"
                                    selected="@(ViewBag.Status?.ToString() == item ? "selected" : null)">
                                @item
                            </option>
                        }


                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>
                        Search
                    </button>

                    <a asp-action="CareerApplications"
                       class="btn btn-secondary">
                        Reset
                    </a>

                </div>

            </form>

        </div>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Applicant</th>
                            <th>Email</th>
                            <th>Job</th>
                            <th>Status</th>
                            <th>Applied Date</th>
                            <th class="text-center">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var application in Model)
                            {
                                <tr>

                                    <td>
                                        @application.Id
                                    </td>

                                    <td>
                                        <strong>
                                            @application.ApplicantName
                                        </strong>
                                    </td>

                                    <td>
                                        @application.Email
                                    </td>

                                    <td>
                                        @(application.CareerTitle ?? "-")
                                    </td>

                                    <td>
                                        @if (application.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (application.Status == "Shortlisted")
                                        {
                                            <span class="badge bg-info">
                                                ShortlistedB
                                            </span>
                                        }
                                        else if (application.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else if (application.Status == "Hired")
                                        {
                                            <span class="badge bg-success">
                                                Hired
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @application.Status
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @application.AppliedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group">

                                            <a asp-action="CareerApplicationDetails"
                                               asp-route-id="@application.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="View">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="EditCareerApplication"
                                               asp-route-id="@application.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <a asp-action="ConfirmDeleteCareerApplication"
                                               asp-route-id="@application.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center py-5">

                                    <i class="bi bi-inbox fs-1 text-muted"></i>

                                    <p class="text-muted mt-2 mb-0">
                                        No career applications found.
                                    </p>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
