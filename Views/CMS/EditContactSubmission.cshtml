
@model CMSPanel.Models.ContactSubmission

@{
    ViewData["Title"] = "Edit Contact Submission";

    var statusClass = Model.Status switch
    {
        "New" => "status-new",
        "Read" => "status-read",
        "Replied" => "status-replied",
        _ => "status-default"
    };
}

<style>
    .edit-contact-page {
        max-width: 1250px;
        margin: 0 auto;
        color: #243247;
    }

    .breadcrumb {
        font-size: .87rem;
        margin-bottom: 18px;
    }

        .breadcrumb a {
            color: #2563eb;
            text-decoration: none;
        }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

        .page-heading h1 {
            font-size: 1.75rem;
            font-weight: 750;
            letter-spacing: -.45px;
            margin-bottom: 6px;
        }

    .page-subtitle {
        color: #718096;
        margin: 0;
    }

    .form-card {
        background: #fff;
        border: 1px solid #e8edf3;
        border-radius: 14px;
        box-shadow: 0 4px 20px rgba(31, 45, 61, .05);
        overflow: hidden;
        margin-bottom: 22px;
    }

    .form-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf1f5;
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .section-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background: #edf4ff;
        color: #2563eb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .form-card-header h5 {
        font-size: 1rem;
        font-weight: 700;
        margin: 0 0 4px;
    }

    .form-card-header p {
        color: #718096;
        font-size: .85rem;
        margin: 0;
    }

    .form-card-body {
        padding: 25px;
    }

    .form-label {
        color: #344256;
        font-size: .9rem;
        font-weight: 650;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        min-height: 44px;
        border: 1px solid #dce3ec;
        border-radius: 8px;
        padding: 10px 12px;
    }

    textarea.form-control {
        min-height: 155px;
        resize: vertical;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #86aefb;
        box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .1);
    }

    .field-help {
        font-size: .8rem;
        color: #8793a4;
        margin-top: 6px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 30px;
        padding: 7px 12px;
        font-size: .82rem;
        font-weight: 700;
    }

    .status-new {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .status-read {
        background: #fef3c7;
        color: #92400e;
    }

    .status-replied {
        background: #dcfce7;
        color: #166534;
    }

    .status-default {
        background: #e2e8f0;
        color: #475569;
    }

    .form-footer {
        background: #fafbfd;
        border-top: 1px solid #edf1f5;
        padding: 18px 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .form-footer-note {
        color: #718096;
        font-size: .84rem;
        margin: 0;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn {
        border-radius: 8px;
        font-weight: 600;
        padding: 9px 16px;
    }

    .record-info {
        color: #718096;
        font-size: .85rem;
    }

    @@media (max-width: 767px) {
        .page-heading h1 {
            font-size: 1.4rem;
        }

        .form-card-body {
            padding: 18px;
        }

        .form-card-header {
            padding: 17px 18px;
        }

        .form-footer {
            padding: 17px 18px;
        }

        .form-footer-note {
            width: 100%;
        }

        .form-actions {
            width: 100%;
        }

            .form-actions .btn {
                flex: 1;
            }
    }
</style>

<div class="container-fluid py-4 edit-contact-page">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="CMS" asp-action="Index">Dashboard</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="CMS" asp-action="ContactSubmissions">
                    Contact Submissions
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                Edit Submission
            </li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="page-heading">
        <div>
            <h1>Edit Contact Submission</h1>
            <p class="page-subtitle">
                Update sender details, message information and review status.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="status-badge @statusClass">
                <i class="bi bi-circle-fill" style="font-size: .5rem;"></i>
                @(string.IsNullOrWhiteSpace(Model.Status)
                    ? "Unknown"
                    : Model.Status)
            </span>

            <a asp-controller="CMS"
               asp-action="ContactSubmissionDetails"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Details
            </a>
        </div>
    </div>

    <form asp-controller="CMS"
          asp-action="EditContactSubmission"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="SubmittedAt" />

        <!-- Validation Summary -->
        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger mb-4">
        </div>

        <!-- Contact Information -->
        <div class="form-card">
            <div class="form-card-header">
                <span class="section-icon">
                    <i class="bi bi-person-lines-fill"></i>
                </span>

                <div>
                    <h5>Contact Information</h5>
                    <p>Update the sender's name and contact details.</p>
                </div>
            </div>

            <div class="form-card-body">
                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">
                            Full Name <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter sender's full name" />

                        <span asp-validation-for="Name"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">
                            Email Address <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="name@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">
                            Phone Number
                        </label>

                        <input asp-for="Phone"
                               class="form-control"
                               placeholder="Enter phone number" />

                        <span asp-validation-for="Phone"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Subject" class="form-label">
                            Subject
                        </label>

                        <input asp-for="Subject"
                               class="form-control"
                               placeholder="Enter message subject" />

                        <span asp-validation-for="Subject"
                              class="text-danger small"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- Message Details -->
        <div class="form-card">
            <div class="form-card-header">
                <span class="section-icon">
                    <i class="bi bi-chat-left-text"></i>
                </span>

                <div>
                    <h5>Message Details</h5>
                    <p>Review or update the submitted message.</p>
                </div>
            </div>

            <div class="form-card-body">
                <label asp-for="Message" class="form-label">
                    Message <span class="text-danger">*</span>
                </label>

                <textarea asp-for="Message"
                          class="form-control"
                          rows="6"
                          placeholder="Enter the contact message"></textarea>

                <span asp-validation-for="Message"
                      class="text-danger small"></span>

                <div class="field-help">
                    Keep the message clear and preserve the sender's original meaning.
                </div>
            </div>
        </div>

        <!-- Review & Status -->
        <div class="form-card">
            <div class="form-card-header">
                <span class="section-icon">
                    <i class="bi bi-clipboard-check"></i>
                </span>

                <div>
                    <h5>Review & Status</h5>
                    <p>Track the progress of this contact request.</p>
                </div>
            </div>

            <div class="form-card-body">
                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">
                            Submission Status
                        </label>

                        <select asp-for="Status" class="form-select">
                            <option value="New">New</option>
                            <option value="Read">Read</option>
                            <option value="Replied">Replied</option>
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger small"></span>

                        <div class="field-help">
                            Choose the current handling status.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Remarks" class="form-label">
                            Internal Remarks
                        </label>

                        <textarea asp-for="Remarks"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Add internal notes or follow-up details"></textarea>

                        <span asp-validation-for="Remarks"
                              class="text-danger small"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="form-card">
            <div class="form-footer">
                <p class="form-footer-note">
                    <i class="bi bi-shield-check me-1"></i>
                    Review your changes before saving.
                </p>

                <div class="form-actions">
                    <a asp-controller="CMS"
                       asp-action="ContactSubmissionDetails"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i>
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2-circle me-1"></i>
                        Save Changes
                    </button>
                </div>
            </div>
        </div>

    </form>

    <!-- Record Information -->
    <div class="record-info mb-3">
        <i class="bi bi-calendar3 me-1"></i>
        Original submission date:
        @Model.SubmittedAt.ToString("dd MMM yyyy, hh:mm tt")

        @if (Model.UpdatedAt.HasValue)
        {
            <span class="ms-3">
                <i class="bi bi-clock-history me-1"></i>
                Last updated:
                @Model.UpdatedAt.Value.ToString("dd MMM yyyy, hh:mm tt")
            </span>
        }
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
