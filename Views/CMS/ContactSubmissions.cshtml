@model IEnumerable<CMSPanel.Models.ContactSubmission>

@{
    ViewData["Title"] = "Contact Submissions";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                Contact Submissions
            </h1>

            <p class="text-muted mb-0">
                Manage and review messages submitted through the contact form.
            </p>
        </div>

        <div>
            <span class="badge bg-primary fs-6">
                @(Model?.Count() ?? 0) Submissions
            </span>
        </div>
    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Search & Filter Card -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="ContactSubmissions"
                  asp-controller="CMS"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- Search -->
                    <div class="col-md-5">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="searchString"
                                   value="@ViewBag.SearchString"
                                   class="form-control"
                                   placeholder="Name, email, phone or subject" />

                        </div>

                    </div>


                    <!-- Status -->
                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All Status
                            </option>

                            <option value="New"
                                    selected="@(ViewBag.Status == "New")">
                                New
                            </option>

                            <option value="Read"
                                    selected="@(ViewBag.Status == "Read")">
                                Read
                            </option>

                            <option value="Replied"
                                    selected="@(ViewBag.Status == "Replied")">
                                Replied
                            </option>

                        </select>

                    </div>


                    <!-- Buttons -->
                    <div class="col-md-4">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-search me-1"></i>
                                Search

                            </button>

                            <a asp-action="ContactSubmissions"
                               asp-controller="CMS"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-counterclockwise me-1"></i>
                                Reset

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Submissions Table -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="px-4">
                                #
                            </th>

                            <th>
                                Name
                            </th>

                            <th>
                                Contact
                            </th>

                            <th>
                                Subject
                            </th>

                            <th>
                                Submitted
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end px-4">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int count = 1;

                            foreach (var submission in Model)
                            {
                                <tr>

                                    <!-- Number -->
                                    <td class="px-4 fw-semibold">
                                        @count
                                    </td>


                                    <!-- Name -->
                                    <td>

                                        <div class="fw-semibold">
                                            @submission.Name
                                        </div>

                                    </td>


                                    <!-- Contact -->
                                    <td>

                                        <div>
                                            <i class="bi bi-envelope me-1 text-muted"></i>
                                            @submission.Email
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(submission.Phone))
                                        {
                                            <small class="text-muted">
                                                <i class="bi bi-telephone me-1"></i>
                                                @submission.Phone
                                            </small>
                                        }

                                    </td>


                                    <!-- Subject -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(submission.Subject))
                                        {
                                            <span>
                                                @submission.Subject
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No subject
                                            </span>
                                        }

                                    </td>


                                    <!-- Submitted Date -->
                                    <td>

                                        <div>
                                            @submission.SubmittedAt.ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted">
                                            @submission.SubmittedAt.ToString("hh:mm tt")
                                        </small>

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (submission.Status == "New")
                                        {
                                            <span class="badge bg-primary">
                                                <i class="bi bi-envelope me-1"></i>
                                                New
                                            </span>
                                        }
                                        else if (submission.Status == "Read")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-envelope-open me-1"></i>
                                                Read
                                            </span>
                                        }
                                        else if (submission.Status == "Replied")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Replied
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @submission.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-end px-4">

                                        <!-- View -->
                                        <a asp-action="ContactSubmissionDetails"
                                           asp-controller="CMS"
                                           asp-route-id="@submission.Id"
                                           class="btn btn-sm btn-outline-primary me-1"
                                           title="View">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- Edit -->
                                        <a asp-action="EditContactSubmission"
                                           asp-controller="CMS"
                                           asp-route-id="@submission.Id"
                                           class="btn btn-sm btn-outline-warning me-1"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <!-- Delete -->
                                        <form asp-action="DeleteContactSubmission"
                                              asp-controller="CMS"
                                              asp-route-id="@submission.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this contact submission?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                        
                                    </td>

                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <!-- Empty State -->
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-envelope-open fs-1"></i>

                                        <h5 class="mt-3">
                                            No Contact Submissions Found
                                        </h5>

                                        <p class="mb-0">
                                            There are no contact messages to display.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
