@model CMSPanel.Models.CareerApplication

@{
    ViewData["Title"] = "Career Application Details";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">Application Details</h1>
            <p class="text-muted mb-0">
                View career application information
            </p>
        </div>

        <div>

            <a asp-action="EditCareerApplication"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>
                Edit
            </a>

            <a asp-action="CareerApplications"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <h6 class="text-muted">
                        Applicant Name
                    </h6>

                    <p class="fw-semibold">
                        @Model.ApplicantName
                    </p>

                </div>

                <div class="col-md-6">

                    <h6 class="text-muted">
                        Email
                    </h6>

                    <p>
                        @Model.Email
                    </p>

                </div>

                <div class="col-md-6">

                    <h6 class="text-muted">
                        Phone
                    </h6>

                    <p>
                        @(Model.Phone ?? "-")
                    </p>

                </div>

                <div class="col-md-6">

                    <h6 class="text-muted">
                        Job Position
                    </h6>

                    <p>
                        @(Model.CareerTitle ?? "-")
                    </p>

                </div>

                <div class="col-md-6">

                    <h6 class="text-muted">
                        Status
                    </h6>

                    @if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }
                    else if (Model.Status == "Shortlisted")
                    {
                        <span class="badge bg-info">
                            Shortlisted
                        </span>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <span class="badge bg-danger">
                            Rejected
                        </span>
                    }
                    else if (Model.Status == "Hired")
                    {
                        <span class="badge bg-success">
                            Hired
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    }

                </div>

                <div class="col-md-6">

                    <h6 class="text-muted">
                        Applied At
                    </h6>

                    <p>
                        @Model.AppliedAt.ToString("dd MMM yyyy hh:mm tt")
                    </p>

                </div>

                <div class="col-12">

                    <h6 class="text-muted">
                        Resume Reference
                    </h6>

                    <p>
                        @(Model.ResumePath ?? "-")
                    </p>

                </div>

                <div class="col-12">

                    <h6 class="text-muted">
                        Cover Letter
                    </h6>

                    <div class="border rounded p-3 bg-light">
                        @(Model.CoverLetter ?? "No cover letter provided.")
                    </div>

                </div>

                <div class="col-12">

                    <h6 class="text-muted">
                        Admin Notes
                    </h6>

                    <div class="border rounded p-3 bg-light">
                        @(Model.Notes ?? "No notes added.")
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
