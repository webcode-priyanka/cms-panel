@model CMSPanel.Models.Project

@{
    ViewData["Title"] = "Delete Project";
}

<style>
    .delete-page {
        padding: 25px;
    }

    .delete-header {
        margin-bottom: 25px;
    }

        .delete-header h1 {
            font-size: 27px;
            font-weight: 700;
            color: #212529;
            margin-bottom: 5px;
        }

        .delete-header p {
            color: #6c757d;
            margin-bottom: 0;
        }

    .delete-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        overflow: hidden;
    }

    .delete-card-header {
        padding: 20px 25px;
        background: #fff;
        border-bottom: 1px solid #edf0f2;
    }

        .delete-card-header h5 {
            font-weight: 700;
            margin-bottom: 5px;
        }

        .delete-card-header p {
            color: #6c757d;
            font-size: 13px;
            margin-bottom: 0;
        }

    .delete-card-body {
        padding: 25px;
    }

    .warning-box {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 18px;
        border: 1px solid #f5c2c7;
        border-radius: 9px;
        background: #fff5f5;
        color: #842029;
        margin-bottom: 25px;
    }

        .warning-box i {
            font-size: 23px;
            margin-top: 2px;
        }

        .warning-box strong {
            display: block;
            margin-bottom: 4px;
            font-size: 15px;
        }

        .warning-box p {
            margin-bottom: 0;
            font-size: 13px;
        }

    .info-card,
    .action-card {
        height: 100%;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        background: #fff;
        padding: 22px;
    }

    .project-title {
        font-size: 21px;
        font-weight: 700;
        color: #212529;
        overflow-wrap: anywhere;
        margin-bottom: 20px;
    }

    .detail-item {
        margin-bottom: 18px;
    }

        .detail-item:last-child {
            margin-bottom: 0;
        }

    .detail-label {
        display: block;
        color: #6c757d;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .detail-value {
        color: #212529;
        font-size: 14px;
        font-weight: 500;
        overflow-wrap: anywhere;
    }

    .slug-value {
        color: #0d6efd;
    }

    .action-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .delete-icon {
        width: 75px;
        height: 75px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff0f0;
        border-radius: 50%;
        color: #dc3545;
        font-size: 34px;
        margin-bottom: 18px;
    }

    .action-card h5 {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .action-card p {
        color: #6c757d;
        font-size: 13px;
        margin-bottom: 22px;
    }

    .action-card form {
        width: 100%;
    }

    .action-card .btn {
        width: 100%;
        padding: 10px 15px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
    }

    .delete-btn {
        margin-bottom: 10px;
    }

    @@media (max-width: 576px) {
        .delete-page {
            padding: 15px;
        }

        .delete-card-body {
            padding: 18px;
        }

        .delete-header h1 {
            font-size: 23px;
        }

        .info-card,
        .action-card {
            padding: 18px;
        }
    }
</style>

<div class="container-fluid delete-page">

    <!-- Page Header -->
    <div class="delete-header">
        <h1>
            <i class="bi bi-trash3 text-danger me-2"></i>
            Delete Project
        </h1>
        <p>Review the project details before deleting.</p>
    </div>

    <!-- Main Card -->
    <div class="card delete-card">

        <div class="delete-card-header">
            <h5>
                <i class="bi bi-exclamation-circle text-danger me-2"></i>
                Project Deletion
            </h5>
            <p>Confirm whether you want to permanently delete this project.</p>
        </div>

        <div class="delete-card-body">

            <!-- Warning -->
            <div class="warning-box">
                <i class="bi bi-exclamation-triangle-fill"></i>

                <div>
                    <strong>Are you sure you want to delete this project?</strong>
                    <p>
                        This action cannot be undone. The project will be
                        permanently removed.
                    </p>
                </div>
            </div>

            <div class="row g-4">

                <!-- Project Information -->
                <div class="col-lg-8">

                    <div class="info-card">

                        <h4 class="project-title">
                            <i class="bi bi-folder2-open text-primary me-2"></i>
                            @(string.IsNullOrWhiteSpace(Model.Title)
                                ? "Untitled Project"
                                : Model.Title)
                        </h4>

                        <div class="row g-3">

                            <!-- Slug -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <span class="detail-label">
                                        <i class="bi bi-link-45deg me-1"></i>
                                        Slug
                                    </span>

                                    <span class="detail-value slug-value">
                                        /@Model.Slug
                                    </span>
                                </div>
                            </div>

                            <!-- Client -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <span class="detail-label">
                                        <i class="bi bi-person me-1"></i>
                                        Client
                                    </span>

                                    <span class="detail-value">
                                        @(string.IsNullOrWhiteSpace(Model.ClientName)
                                            ? "-"
                                            : Model.ClientName)
                                    </span>
                                </div>
                            </div>

                            <!-- Project Type -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <span class="detail-label">
                                        <i class="bi bi-grid me-1"></i>
                                        Project Type
                                    </span>

                                    <span class="detail-value">
                                        @(string.IsNullOrWhiteSpace(Model.ProjectType)
                                            ? "-"
                                            : Model.ProjectType)
                                    </span>
                                </div>
                            </div>

                            <!-- Status -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <span class="detail-label">
                                        <i class="bi bi-flag me-1"></i>
                                        Status
                                    </span>

                                    <span class="badge bg-light text-dark border">
                                        @Model.Status
                                    </span>
                                </div>
                            </div>

                            <!-- Project Date -->
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <span class="detail-label">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        Project Date
                                    </span>

                                    <span class="detail-value">
                                        @(Model.ProjectDate.HasValue
                                            ? Model.ProjectDate.Value.ToString("dd MMM yyyy")
                                            : "-")
                                    </span>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

                <!-- Delete Action -->
                <div class="col-lg-4">

                    <div class="action-card">

                        <div class="delete-icon">
                            <i class="bi bi-trash3"></i>
                        </div>

                        <h5>Delete this project?</h5>

                        <p>
                            Please make sure you have selected the correct
                            project before continuing.
                        </p>

                        <form asp-controller="CMS"
                              asp-action="DeleteProject"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to permanently delete this project?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="Id" />

                            <button type="submit"
                                    class="btn btn-danger delete-btn">
                                <i class="bi bi-trash me-1"></i>
                                Delete Project
                            </button>

                            <a asp-controller="CMS"
                               asp-action="Projects"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>
                                Cancel
                            </a>

                        </form>

                    </div>

                </div>

            </div>
        </div>
    </div>
</div>