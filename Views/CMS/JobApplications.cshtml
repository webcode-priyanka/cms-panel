@model IEnumerable<CMSPanel.Models.JobApplication>

@{
    ViewData["Title"] = "Job Applications";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Job Applications</h1>
            <p class="text-muted mb-0">
                Manage applications received for job openings
            </p>
        </div>

        <a asp-action="CreateJobApplication"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Application
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Search & Filter -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="JobApplications"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- Search -->
                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Search applicant, email, phone or job..." />

                    </div>

                    <!-- Status -->
                    <div class="col-md-4">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All Status
                            </option>

                            @if (ViewBag.Status == "Pending")
                            {
                                <option value="Pending" selected>
                                    Pending
                                </option>
                            }
                            else
                            {
                                <option value="Pending">
                                    Pending
                                </option>
                            }

                            @if (ViewBag.Status == "Shortlisted")
                            {
                                <option value="Shortlisted" selected>
                                    Shortlisted
                                </option>
                            }
                            else
                            {
                                <option value="Shortlisted">
                                    Shortlisted
                                </option>
                            }

                            @if (ViewBag.Status == "Rejected")
                            {
                                <option value="Rejected" selected>
                                    Rejected
                                </option>
                            }
                            else
                            {
                                <option value="Rejected">
                                    Rejected
                                </option>
                            }

                            @if (ViewBag.Status == "Hired")
                            {
                                <option value="Hired" selected>
                                    Hired
                                </option>
                            }
                            else
                            {
                                <option value="Hired">
                                    Hired
                                </option>
                            }

                        </select>

                    </div>

                    <!-- Search Button -->
                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search me-1"></i>
                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Applications Table -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-bold">
                Applications
            </h5>

        </div>

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>#</th>

                                <th>Applicant</th>

                                <th>Contact</th>

                                <th>Applied For</th>

                                <th>Applied Date</th>

                                <th>Status</th>

                                <th class="text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var application in Model)
                            {
                                <tr>

                                    <!-- Number -->
                                    <td>
                                        @count
                                    </td>

                                    <!-- Applicant -->
                                    <td>

                                        <div class="fw-semibold">
                                            @application.ApplicantName
                                        </div>

                                    </td>

                                    <!-- Contact -->
                                    <td>

                                        <div>
                                            <i class="bi bi-envelope me-1"></i>
                                            @application.Email
                                        </div>

                                        <div class="text-muted small mt-1">
                                            <i class="bi bi-telephone me-1"></i>
                                            @application.Phone
                                        </div>

                                    </td>

                                    <!-- Career -->
                                    <td>

                                        @if (application.Career != null)
                                        {
                                            <span class="fw-semibold">
                                                @application.Career.JobTitle
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Job not found
                                            </span>
                                        }

                                    </td>

                                    <!-- Applied Date -->
                                    

                                    <td>
                                        <div>
                                                @application.AppliedAt.ToString("dd MMM yyyy")
                                        </div>
                                        <small class="text-muted">
                                                @application.AppliedAt.ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    

                                    <!-- Status -->
                                    <td>

                                        @if (application.Status == "Shortlisted")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Shortlisted
                                            </span>
                                        }
                                        else if (application.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else if (application.Status == "Hired")
                                        {
                                            <span class="badge bg-success">
                                                Hired
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }

                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center">

                                        <div class="btn-group"
                                             role="group">

                                            <a asp-action="JobApplicationDetails"
                                               asp-route-id="@application.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="View">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <a asp-action="EditJobApplication"
                                               asp-route-id="@application.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <form asp-controller="CMS"
                                                  asp-action="DeleteJobApplication"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this job application?');">

                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@application.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                            
                                        </div>

                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-file-earmark-person fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No job applications found
                    </h5>

                    <p class="text-muted">
                        Applications submitted for your job openings
                        will appear here.
                    </p>

                    <a asp-action="CreateJobApplication"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add Application

                    </a>

                </div>
            }

        </div>

    </div>

</div>
