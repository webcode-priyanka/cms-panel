@model IEnumerable<CMSPanel.Models.Testimonial>

@{
    ViewData["Title"] = "Testimonials";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Testimonials</h2>
            <p class="text-muted">Manage client testimonials</p>
        </div>
        <a asp-action="CreateTestimonial" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Testimonial
        </a>
    </div>

    <form asp-action="Testimonials" method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchString"
                   value="@Context.Request.Query["searchString"]"
                   class="form-control"
                   placeholder="Search testimonials..." />
            <button type="submit" class="btn btn-dark">Search</button>
            <a asp-action="Testimonials" class="btn btn-secondary">Reset</a>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Client</th>
                            <th>Company</th>
                            <th>Content</th>
                            <th>Rating</th>
                            <th>Status</th>
                            <th>Order</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.ClientName</strong>
                                        <br />
                                        <small class="text-muted">@item.Designation</small>
                                    </td>
                                    <td>@item.CompanyName</td>
                                    <td>
                                        @(item.Content.Length > 70
                                            ? item.Content.Substring(0, 70) + "..."
                                            : item.Content)
                                    </td>
                                    <td>
                                        @for (int i = 0; i < item.Rating; i++)
                                        {
                                            <i class="bi bi-star-fill text-warning"></i>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>@item.DisplayOrder</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="TestimonialDetails"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info text-white">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="EditTestimonial"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            
                                            <form asp-action="DeleteTestimonial"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this testimonial?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                           
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    No testimonials found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
