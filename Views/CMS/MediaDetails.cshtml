@model CMSPanel.Models.Media

@{
    ViewData["Title"] = "Media Details";
}

<style>
    .media-details-page {
        min-height: 100vh;
        padding: 25px;
        background: #f8fafc;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 28px;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 0;
    }

    .header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-edit {
        background: #4f46e5;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 18px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-edit:hover {
            background: #4338ca;
            color: white;
            transform: translateY(-1px);
        }

    .btn-back {
        background: white;
        color: #475569;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 10px 18px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-back:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

    .details-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
    }

    .details-card-header {
        padding: 18px 22px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .details-card-header h5 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
            color: #1e293b;
        }

    .details-card-body {
        padding: 24px;
    }

    .preview-container {
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        min-height: 320px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        overflow: hidden;
    }

    .preview-image {
        max-width: 100%;
        max-height: 400px;
        object-fit: contain;
        border-radius: 8px;
    }

    .preview-icon {
        font-size: 75px;
    }

    .preview-placeholder {
        text-align: center;
        color: #64748b;
    }

        .preview-placeholder i {
            font-size: 65px;
            color: #94a3b8;
        }

        .preview-placeholder h6 {
            margin-top: 12px;
            font-weight: 600;
            color: #475569;
        }

    .preview-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .file-type-label {
        background: #eef2ff;
        color: #4f46e5;
        border-radius: 20px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 600;
    }

    .section-heading {
        color: #1e293b;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .detail-item {
        margin-bottom: 23px;
        min-width: 0;
    }

    .detail-label {
        display: block;
        color: #94a3b8;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 7px;
    }

    .detail-value {
        color: #334155;
        font-size: 14px;
        font-weight: 500;
        overflow-wrap: anywhere;
    }

        .detail-value.title-value {
            color: #1e293b;
            font-size: 19px;
            font-weight: 700;
        }

    .detail-divider {
        border-top: 1px solid #f1f5f9;
        margin: 5px 0 22px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-active {
        background: #dcfce7;
        color: #15803d;
    }

    .status-inactive {
        background: #f1f5f9;
        color: #64748b;
    }

    .category-badge {
        display: inline-block;
        background: #eff6ff;
        color: #2563eb;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .file-url-card {
        margin-top: 24px;
    }

    .file-url-input {
        min-height: 43px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #f8fafc;
        font-size: 13px;
    }

        .file-url-input:focus {
            box-shadow: none;
            border-color: #94a3b8;
            background: #f8fafc;
        }

    .btn-open-file {
        min-width: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #4f46e5;
        color: white;
        border: none;
        border-radius: 8px;
    }

        .btn-open-file:hover {
            background: #4338ca;
            color: white;
        }

    .description-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 13px;
        color: #475569;
        font-size: 13px;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

    .metadata-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 22px;
    }

    .media-player {
        width: 100%;
        max-width: 100%;
    }

    .btn-open-preview {
        background: #4f46e5;
        color: white;
        border-radius: 8px;
        padding: 9px 15px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-open-preview:hover {
            background: #4338ca;
            color: white;
        }

    @@media (max-width: 768px) {
        .media-details-page {
            padding: 15px;
        }

        .page-title {
            font-size: 23px;
        }

        .details-card-body {
            padding: 18px;
        }

        .preview-container {
            min-height: 230px;
        }

        .metadata-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="media-details-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-file-earmark-richtext text-primary me-2"></i>
                Media Details
            </h1>
            <p class="page-subtitle">
                View complete information about this media file.
            </p>
        </div>

        <div class="header-actions">
            <a asp-action="EditMedia"
               asp-route-id="@Model.Id"
               class="btn-edit">
                <i class="bi bi-pencil-square me-1"></i>
                Edit Media
            </a>

            <a asp-action="Media"
               class="btn-back">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Library
            </a>
        </div>
    </div>

    <div class="row g-4">

        <!-- Media Preview -->
        <div class="col-lg-5">

            <div class="details-card">
                <div class="details-card-header">
                    <i class="bi bi-image text-primary fs-5"></i>
                    <h5>Media Preview</h5>
                </div>

                <div class="details-card-body">

                    <div class="preview-container">

                        @if (!string.IsNullOrWhiteSpace(Model.FileUrl))
                        {
                            @if (Model.FileType == "Image")
                            {
                                <img src="@Model.FileUrl"
                                     alt="@Model.AltText"
                                     class="preview-image"
                                     onerror="this.style.display='none'; document.getElementById('imageError').style.display='block';" />

                                <div id="imageError"
                                     class="preview-placeholder"
                                     style="display:none;">
                                    <i class="bi bi-image"></i>
                                    <h6>Image Preview Unavailable</h6>
                                    <p class="small mb-0">
                                        The image could not be loaded.
                                    </p>
                                </div>
                            }
                            else if (Model.FileType == "Document")
                            {
                                <div class="preview-placeholder">
                                    <i class="bi bi-file-earmark-pdf text-danger"></i>
                                    <h6>Document File</h6>
                                    <p class="small mb-3">
                                        Open the document to view its contents.
                                    </p>
                                    <a href="@Model.FileUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn-open-preview">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>
                                        Open Document
                                    </a>
                                </div>
                            }
                            else if (Model.FileType == "Video")
                            {
                                <video controls
                                       class="media-player rounded">
                                    <source src="@Model.FileUrl">
                                    Your browser does not support video playback.
                                </video>
                            }
                            else if (Model.FileType == "Audio")
                            {
                                <div class="preview-placeholder w-100">
                                    <i class="bi bi-music-note-beamed text-success"></i>
                                    <h6>Audio File</h6>
                                    <audio controls class="media-player mt-3">
                                        <source src="@Model.FileUrl">
                                        Your browser does not support audio playback.
                                    </audio>
                                </div>
                            }
                            else
                            {
                                <div class="preview-placeholder">
                                    <i class="bi bi-file-earmark text-secondary"></i>
                                    <h6>@Model.FileType</h6>
                                    <p class="small mb-3">
                                        Preview is not available for this file type.
                                    </p>
                                    <a href="@Model.FileUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn-open-preview">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>
                                        Open File
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="preview-placeholder">
                                <i class="bi bi-file-earmark"></i>
                                <h6>No Preview Available</h6>
                                <p class="small mb-0">
                                    No file URL has been provided.
                                </p>
                            </div>
                        }

                    </div>

                    <div class="preview-footer">
                        <span class="file-type-label">
                            <i class="bi bi-file-earmark me-1"></i>
                            @(string.IsNullOrWhiteSpace(Model.FileType)
                                ? "Unknown Type"
                                : Model.FileType)
                        </span>

                        @if (!string.IsNullOrWhiteSpace(Model.FileUrl))
                        {
                            <a href="@Model.FileUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-box-arrow-up-right me-1"></i>
                                Open File
                            </a>
                        }
                    </div>

                </div>
            </div>

            <!-- File URL -->
            @if (!string.IsNullOrWhiteSpace(Model.FileUrl))
            {
                <div class="details-card file-url-card">
                    <div class="details-card-header">
                        <i class="bi bi-link-45deg text-primary fs-5"></i>
                        <h5>File URL</h5>
                    </div>

                    <div class="details-card-body">
                        <div class="d-flex gap-2">
                            <input type="text"
                                   class="form-control file-url-input"
                                   value="@Model.FileUrl"
                                   readonly
                                   aria-label="File URL" />

                            <a href="@Model.FileUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn-open-file"
                               title="Open File">
                                <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

        </div>

        <!-- Media Information -->
        <div class="col-lg-7">

            <div class="details-card">

                <div class="details-card-header">
                    <i class="bi bi-info-circle text-primary fs-5"></i>
                    <h5>Media Information</h5>
                </div>

                <div class="details-card-body">

                    <!-- Title -->
                    <div class="detail-item">
                        <label class="detail-label">Media Title</label>
                        <div class="detail-value title-value">
                            @Model.Title
                        </div>
                    </div>

                    <div class="detail-divider"></div>

                    <!-- Description -->
                    <div class="detail-item">
                        <label class="detail-label">Description</label>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <div class="description-box">
                                @Model.Description
                            </div>
                        }
                        else
                        {
                            <div class="detail-value text-muted">
                                No description provided
                            </div>
                        }
                    </div>

                    <div class="detail-divider"></div>

                    <!-- Metadata -->
                    <h6 class="section-heading">
                        <i class="bi bi-card-list me-2 text-primary"></i>
                        File Information
                    </h6>

                    <div class="metadata-grid">

                        <!-- File Name -->
                        <div class="detail-item">
                            <label class="detail-label">File Name</label>
                            <div class="detail-value">
                                @if (!string.IsNullOrWhiteSpace(Model.FileName))
                                {
                                    @Model.FileName
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </div>
                        </div>

                        <!-- File Type -->
                        <div class="detail-item">
                            <label class="detail-label">File Type</label>
                            <div class="detail-value">
                                @if (!string.IsNullOrWhiteSpace(Model.FileType))
                                {
                                    <span class="badge bg-secondary">
                                        @Model.FileType
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </div>
                        </div>

                        <!-- File Size -->
                        <div class="detail-item">
                            <label class="detail-label">File Size</label>
                            <div class="detail-value">
                                @if (Model.FileSize > 0)
                                {
                                    if (Model.FileSize < 1024)
                                    {
                                        @($"{Model.FileSize} B")
                                    }
                                    else if (Model.FileSize < 1024 * 1024)
                                    {
                                        @($"{Model.FileSize / 1024.0:F2} KB")
                                    }
                                    else
                                    {
                                        @($"{Model.FileSize / (1024.0 * 1024.0):F2} MB")
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </div>
                        </div>

                        <!-- Category -->
                        <div class="detail-item">
                            <label class="detail-label">Category</label>
                            <div class="detail-value">
                                @if (!string.IsNullOrWhiteSpace(Model.Category))
                                {
                                    <span class="category-badge">
                                        <i class="bi bi-folder2 me-1"></i>
                                        @Model.Category
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </div>
                        </div>

                        <!-- Alt Text -->
                        <div class="detail-item">
                            <label class="detail-label">Alt Text</label>
                            <div class="detail-value">
                                @if (!string.IsNullOrWhiteSpace(Model.AltText))
                                {
                                    @Model.AltText
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="detail-item">
                            <label class="detail-label">Status</label>
                            <div class="detail-value">
                                @if (Model.IsActive)
                                {
                                    <span class="status-badge status-active">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">
                                        <i class="bi bi-pause-circle-fill"></i>
                                        Inactive
                                    </span>
                                }
                            </div>
                        </div>

                    </div>

                    <div class="detail-divider"></div>

                    <!-- Dates -->
                    <h6 class="section-heading">
                        <i class="bi bi-clock-history me-2 text-primary"></i>
                        Activity Information
                    </h6>

                    <div class="metadata-grid">

                        <div class="detail-item mb-0">
                            <label class="detail-label">Created At</label>
                            <div class="detail-value">
                                <i class="bi bi-calendar3 text-muted me-1"></i>
                                @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                <div class="small text-muted mt-1">
                                    @Model.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                </div>
                            </div>
                        </div>

                        <div class="detail-item mb-0">
                            <label class="detail-label">Last Updated</label>
                            <div class="detail-value">
                                @if (Model.UpdatedAt.HasValue)
                                {
                                    <i class="bi bi-calendar-check text-muted me-1"></i>
                                    @Model.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy")
                                    <div class="small text-muted mt-1">
                                        @Model.UpdatedAt.Value.ToLocalTime().ToString("hh:mm tt")
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not updated yet
                                    </span>
                                }
                            </div>
                        </div>

                    </div>

                </div>
            </div>

        </div>

    </div>

    <!-- Bottom Actions -->
    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Media" class="btn-back">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Library
        </a>

        <a asp-action="EditMedia"
           asp-route-id="@Model.Id"
           class="btn-edit">
            <i class="bi bi-pencil-square me-1"></i>
            Edit Media
        </a>
    </div>

</div>